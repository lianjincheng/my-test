#!/bin/bash
#
# Ultimate VPS Performance Optimization Script (v8.5 - Safe Production)
# Changes:
# - [Security] Removed forced installation of amd64 kernels (Protects ARM/Cloud kernels)
# - [Config] Kept BBR + FQ as requested
# - [Safety] Added checks to prevent critical errors on incompatible systems
#

# --- [Script header] ---
set -e
export LANG=en_US.UTF-8
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

check_root() { 
    if [ "$(id -u)" -ne 0 ]; then 
        error "此脚本需要以 root 权限运行。请使用 'sudo bash $0' 或切换到 root 用户。"
    fi 
}

# --- [Update & Install] ---
update_and_install() {
    info "正在更新软件包列表..."
    if ! apt update; then
        warn "apt update 返回了非零状态，但这可能只是暂时的网络问题，尝试继续..."
    fi

    info "正在安装必要的依赖工具..."
    # 移除了 linux-image-amd64 和 linux-headers-amd64 以兼容 ARM 和云内核
    if ! apt install -y curl socat jq sudo coreutils grep sed gawk; then
        error "基础依赖安装失败。请检查 apt 源。"
    fi
    success "依赖安装完成。"
}

# --- [Kernel Modules] ---
load_kernel_modules() {
    info "正在检查与加载内核模块..."
    local modules=("tcp_bbr" "sch_fq" "nf_conntrack")
    local modules_conf="/etc/modules-load.d/proxy-optimizations.conf"

    # 检测是否为 OpenVZ/LXC 容器
    if [ "$(systemd-detect-virt)" == "openvz" ] || [ "$(systemd-detect-virt)" == "lxc" ]; then
        warn "检测到容器环境 (OpenVZ/LXC)。内核模块加载可能受限，仅尝试写入配置。"
    fi

    cat <<EOF > "$modules_conf"
tcp_bbr
sch_fq
nf_conntrack
EOF

    for module in "${modules[@]}"; do
        local check_name=${module#sch_}
        if lsmod 2>/dev/null | grep -q "^$check_name"; then
            info "模块 '$module' 已加载。"
        else
            # 使用 || true 防止 set -e 导致脚本在 modprobe 失败时退出
            if modprobe "$module" 2>/dev/null; then
                success "模块 '$module' 加载成功。"
            else
                warn "无法加载模块 '$module'。如果这是容器环境(VPS)，请忽略此警告。"
            fi
        fi
    done
}

# --- [Sysctl Optimizations] ---
apply_sysctl_optimizations() {
    info "正在应用 Sysctl 内核参数优化 (BBR + FQ)..."
    local sysctl_conf="/etc/sysctl.d/99-proxy-optimizations.conf"
    
    # 注意：这里保留了较大的缓冲区，如果你的内存 < 512MB，建议手动调小 tcp_*mem
    cat <<EOF > "$sysctl_conf"
# --- Generated by Ultimate Optimization Script ---
# Memory Buffers (Max ~64MB)
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.core.optmem_max = 67108864

# BBR + FQ
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# TCP Behaviors
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
net.ipv4.tcp_fastopen = 3
net.core.netdev_max_backlog = 32768
net.core.somaxconn = 32768
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_notsent_lowat = 524288
net.ipv4.tcp_mtu_probing = 1

# Connection Tracking
net.netfilter.nf_conntrack_max = 655350
net.netfilter.nf_conntrack_tcp_timeout_established = 7200

# File Descriptors
fs.file-max = 1048576
fs.nr_open = 1048576

# Disable IPv6 (Hard Disable)
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

    info "正在应用内核参数..."
    # 忽略 sysctl 的错误（例如某些键值在旧内核中不存在）
    sysctl -p "$sysctl_conf" >/dev/null 2>&1 || warn "部分内核参数应用失败，这在 VPS 环境中很常见，通常不影响使用。"
    success "内核优化参数已配置。"
}

# --- [IPv6 & DHCP] ---
disable_ipv6_dhcp() {
    info "正在配置网络以忽略 IPv6..."
    local dhclient_conf="/etc/dhcp/dhclient.conf"
    
    # 仅在文件存在时操作，兼容没有 dhclient 的系统
    if [ -f "$dhclient_conf" ]; then
        if ! grep -qF "send dhcp6.oro = [];" "$dhclient_conf"; then
            echo "send dhcp6.oro = [];" >> "$dhclient_conf"
            success "DHCPv6 请求已禁用。"
            systemctl restart networking >/dev/null 2>&1 || systemctl restart NetworkManager >/dev/null 2>&1 || true
        fi
    fi
}

# --- [Ulimits] ---
set_ulimits() {
    info "正在更新 limits.conf..."
    local limits_conf="/etc/security/limits.conf"
    
    # 简单的去重逻辑：先删后加
    sed -i '/# Added by Optimization Script/d' "$limits_conf"
    sed -i '/root soft nofile 1048576/d' "$limits_conf"
    sed -i '/root hard nofile 1048576/d' "$limits_conf"
    sed -i '/\* soft nofile 1048576/d' "$limits_conf"
    sed -i '/\* hard nofile 1048576/d' "$limits_conf"

    cat <<EOF >> "$limits_conf"
# Added by Optimization Script
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF
    success "Ulimits 配置完成。"
}

# --- [Main] ---
main() { 
    clear
    echo -e "${GREEN}=== VPS Performance Optimization (v8.5 Safe) ===${NC}"
    check_root
    update_and_install
    load_kernel_modules
    apply_sysctl_optimizations
    disable_ipv6_dhcp
    set_ulimits
    
    echo
    success "系统优化完成！"
    echo -e "${YELLOW}建议重启 VPS 以确保所有设置生效。${NC}"
    read -p "是否现在重启? (y/N): " reboot_choice
    if [[ "$reboot_choice" =~ ^[Yy]$ ]]; then
        reboot
    fi
}

main "$@"
