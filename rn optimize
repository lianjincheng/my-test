#!/bin/bash
#
# Ultimate VPS Performance Optimization Script (v6 - Final Hybrid Intelligence)
# Combines dynamic parameter calculation with aggressive, dedicated-server optimizations.
#

# --- Script Configuration and Best Practices ---
set -e
export LANG=en_US.UTF-8

# --- Color Definitions for better output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# --- Helper functions for logging ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# --- Function to check for root privileges ---
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "此脚本需要以 root 权限运行。请使用 'sudo bash $0' 或切换到 root 用户。"
    fi
}

# --- Function to update system and install dependencies ---
update_and_install() {
    info "正在更新软件包列表并安装必要的依赖..."
    # Hide apt output for a cleaner experience
    if apt update -y >/dev/null 2>&1 && apt install -y curl socat jq sudo coreutils grep sed >/dev/null 2>&1; then
        success "依赖项安装完成。"
    else
        error "依赖项安装失败，请检查 apt 源或网络连接。"
    fi
}

# --- Function to load kernel modules required for optimization ---
load_kernel_modules() {
    info "正在检查并加载优化所需的内核模块..."
    local modules=("tcp_bbr" "sch_fq" "nf_conntrack")
    local modules_conf="/etc/modules-load.d/proxy-optimizations.conf"
    
    touch "$modules_conf"

    for module in "${modules[@]}"; do
        local check_name=${module#sch_}
        if lsmod | grep -q "^$check_name"; then
            info "模块 '$module' 已加载。"
        else
            info "正在尝试加载模块 '$module'..."
            if modprobe "$module"; then
                success "模块 '$module' 加载成功。"
            else
                warn "模块 '$module' 加载失败。您的 VPS 可能不支持此模块 (例如 OpenVZ 架构)。"
                continue
            fi
        fi
        
        if ! grep -q "^$module$" "$modules_conf"; then
            echo "$module" >> "$modules_conf"
            info "已将模块 '$module' 添加到开机自启列表。"
        fi
    done
    success "内核模块检查和配置完成。"
}

# ---
# *** 核心引擎：动态参数计算函数 (移植自智能脚本) ***
# ---
calculate_dynamic_parameters() {
    info "正在根据系统内存动态计算网络缓冲区参数..."
    TOTAL_MEM=$(free -m | awk '/^Mem:/{print $2}')
    
    if [ "$TOTAL_MEM" -le 768 ]; then # Adjusted threshold for small servers
        VM_TIER="轻量级 (≤768MB)"
        RMEM_MAX="16777216"
        WMEM_MAX="16777216"
        TCP_RMEM="4096 87380 16777216"
        TCP_WMEM="4096 65536 16777216"
    elif [ "$TOTAL_MEM" -le 2048 ]; then
        VM_TIER="标准级 (768MB-2GB)"
        RMEM_MAX="33554432"
        WMEM_MAX="33554432"
        TCP_RMEM="4096 87380 33554432"
        TCP_WMEM="4096 65536 33554432"
    elif [ "$TOTAL_MEM" -le 4096 ]; then
        VM_TIER="高性能级 (2GB-4GB)"
        RMEM_MAX="67108864"
        WMEM_MAX="67108864"
        TCP_RMEM="4096 131072 67108864"
        TCP_WMEM="4096 87380 67108864"
    else # For > 4GB RAM, we go for max performance
        VM_TIER="旗舰级 (>4GB)"
        RMEM_MAX="134217728"
        WMEM_MAX="134217728"
        TCP_RMEM="8192 131072 134217728"
        TCP_WMEM="8192 87380 134217728"
    fi
    success "已为您的 '${VM_TIER}' 服务器匹配最优网络缓冲区。"
}


# --- Function to apply sysctl kernel parameters ---
apply_sysctl_optimizations() {
    info "正在应用终极内核参数优化 (动态缓冲区 + 激进TCP)..."
    local sysctl_conf="/etc/sysctl.d/99-proxy-optimizations.conf"
    
    # --- 调用动态计算函数 ---
    calculate_dynamic_parameters

    cat <<EOF > "$sysctl_conf"
# --- Generated by Ultimate Optimization Script ---
# Hardware Tier: ${VM_TIER} (${TOTAL_MEM}MB RAM)

# Dynamic Buffer Settings
net.core.rmem_max = ${RMEM_MAX}
net.core.wmem_max = ${WMEM_MAX}
net.ipv4.tcp_rmem = ${TCP_RMEM}
net.ipv4.tcp_wmem = ${TCP_WMEM}

# Aggressive TCP Connection Resilience Settings
net.ipv4.tcp_syn_retries = 6
net.ipv4.tcp_synack_retries = 6
net.ipv4.tcp_retries2 = 8
net.ipv4.tcp_fastopen = 3

# High Performance TCP Settings (Static)
net.core.netdev_max_backlog = 32768
net.core.somaxconn = 32768
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_tw_recycle = 0
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_notsent_lowat = 16384

# TCP Congestion Control (BBR)
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq

# High Performance Static Limits
net.netfilter.nf_conntrack_max = 655350
fs.file-max = 1048576
fs.nr_open = 1048576
vm.swappiness = 10

# Disable IPv6 via sysctl
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

    info "正在使内核参数立即生效..."
    if sysctl -p "$sysctl_conf" >/dev/null 2>&1; then
        success "内核参数已应用并持久化。"
    else
        warn "部分内核参数应用失败。您的 VPS 可能是 OpenVZ/LXC 架构，不支持修改这些参数。"
    fi
}

# ---
# *** 保留我们的关键系统修复函数 ***
# ---
disable_ipv6() {
    info "正在进一步禁用 IPv6..."
    local dhclient_conf="/etc/dhcp/dhclient.conf"
    local dhcp_config_line="send dhcp6.oro = [];"
    if [ -f "$dhclient_conf" ]; then
        if grep -qF "$dhcp_config_line" "$dhclient_conf"; then
            info "DHCP 客户端已配置为不请求 IPv6 地址。"
        else
            info "正在修改 DHCP 客户端配置..."
            echo "$dhcp_config_line" >> "$dhclient_conf"
            success "DHCP 客户端配置修改完成。"
        fi
    else
        info "未找到 DHCP 客户端配置文件，跳过此步骤。"
    fi
    info "正在重启网络服务以应用 DHCP 配置..."
    if systemctl restart networking.service >/dev/null 2>&1; then
        success "网络服务已重启。"
    else
        warn "网络服务重启失败，可能不影响 IPv6 禁用效果。"
    fi
}

set_ulimits() {
    info "正在提升文件句柄数限制..."
    local limits_conf="/etc/security/limits.conf"
    if grep -qF "# Added by Optimization Script" "$limits_conf"; then
        info "文件句柄数限制已配置。"
    else
        info "正在向 '$limits_conf' 添加配置..."
        cat <<EOF >> "$limits_conf"

# Added by Optimization Script
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF
        success "文件句柄数限制已提升并持久化。"
    fi
}

# ---
# *** 最终的主函数，融合所有优点 ***
# ---
main() {
    clear
    echo -e "${GREEN}====================================================${NC}"
    echo -e "${GREEN}        终极 VPS 性能优化脚本 (混合智能版)        ${NC}"
    echo -e "${GREEN}====================================================${NC}"
    echo
    
    check_root
    update_and_install
    load_kernel_modules
    apply_sysctl_optimizations
    disable_ipv6
    set_ulimits
    
    echo
    success "系统优化已全部完成！"
    
    echo -e "${YELLOW}----------------------------------------------------${NC}"
    echo -e "${YELLOW}重要提示:${NC} ${BLUE}为使所有优化（特别是文件句柄限制）完全生效，建议立即重启。${NC}"
    echo -e "${YELLOW}----------------------------------------------------${NC}"
    read -p "是否现在立即重启 VPS? (Y/n): " reboot_choice
    
    if [[ "$reboot_choice" =~ ^[Yy]$ || -z "$reboot_choice" ]]; then
        info "正在执行重启操作..."
        sudo reboot
    else
        warn "已跳过重启。请在方便时手动执行 'sudo reboot'。"
    fi
    echo
}

# --- Execute the main function ---
main "$@"
