#!/bin/bash
#
# Ultimate VPS Performance Optimization Script (v8.2 - Robust Error Handling)
# This version improves error handling during package installation to show detailed debug information.
#

# --- [Script header and helper functions] ---
set -e
export LANG=en_US.UTF-8
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
check_root() { if [ "$(id -u)" -ne 0 ]; then error "此脚本需要以 root 权限运行。请使用 'sudo bash $0' 或切换到 root 用户。"; fi; }

# --- [OPTIMIZED FUNCTION: update_and_install with verbose error reporting] ---
# This version REMOVES output redirection to show detailed apt errors.
update_and_install() {
    info "正在更新软件包列表... (将显示详细过程)"
    # Run apt update and show its full output for easier debugging.
    if ! apt update; then
        echo # Add a newline for better readability
        error "软件包列表更新失败 (apt update failed)。请检查上面的输出，确认您的网络连接和 apt 源 (/etc/apt/sources.list) 是否正常。"
    fi
    success "软件包列表更新成功。"

    info "正在安装必要的依赖... (将显示详细过程)"
    # Run apt install and show its full output.
    if ! apt install -y curl socat jq sudo coreutils grep sed awk linux-image-amd64 linux-headers-amd64; then
        echo # Add a newline for better readability
        error "依赖项安装失败 (apt install failed)。请检查上面的错误信息以确定具体是哪个软件包出了问题。"
    fi
    success "依赖项安装完成。"
}

# --- [OPTIMIZED FUNCTION: load_kernel_modules] ---
# Overwrites the module config file for absolute cleanliness.
load_kernel_modules() {
    info "正在配置并加载优化所需的内核模块..."
    local modules=("tcp_bbr" "sch_fq_pie" "nf_conntrack")
    local modules_conf="/etc/modules-load.d/proxy-optimizations.conf"

    info "正在生成干净的模块自启动配置文件..."
    cat <<EOF > "$modules_conf"
# Generated by Ultimate Optimization Script
tcp_bbr
sch_fq_pie
nf_conntrack
EOF
    success "模块自启动配置文件已更新: $modules_conf"

    for module in "${modules[@]}"; do
        local check_name=${module#sch_}
        if lsmod | grep -q "^$check_name"; then
            info "模块 '$module' 已加载。"
        else
            info "正在尝试加载模块 '$module'..."
            if modprobe "$module"; then
                success "模块 '$module' 加载成功。"
            else
                warn "模块 '$module' 加载失败。您的 VPS 可能不支持此模块 (例如 OpenVZ 架构)。"
            fi
        fi
    done
    success "内核模块检查和配置完成。"
}

# --- [UNCHANGED: apply_sysctl_optimizations] ---
# This function already uses overwrite mode, which is the correct behavior.
apply_sysctl_optimizations() {
    info "正在应用终极内核参数优化 (BBR + FQ-PIE)..."
    local sysctl_conf="/etc/sysctl.d/99-proxy-optimizations.conf"
    
    cat <<EOF > "$sysctl_conf"
# --- Generated by Ultimate Optimization Script (BBR + FQ-PIE) ---

# --- 64MB Balanced Performance Settings ---
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 32768 262144 67108864
net.ipv4.tcp_wmem = 32768 262144 67108864
net.core.optmem_max = 67108864
# Memory management fine-tuning
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
# Aggressive TCP Connection Resilience Settings
net.ipv4.tcp_syn_retries = 6
net.ipv4.tcp_synack_retries = 6
net.ipv4.tcp_retries2 = 8
net.ipv4.tcp_fastopen = 3
# High Performance TCP Settings
net.core.netdev_max_backlog = 32768
net.core.somaxconn = 32768
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_keepalive_intvl = 30
# Further reduce latency and improve responsiveness
net.ipv4.tcp_notsent_lowat = 524288
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_fack = 1
# TCP Congestion Control (BBR + FQ-PIE)
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq_pie
# High Performance Static Limits
net.netfilter.nf_conntrack_max = 655350
fs.file-max = 1048576
fs.nr_open = 1048576
vm.swappiness = 10
# --- Cherry-picked from the new config ---
net.ipv4.tcp_mtu_probing = 1
kernel.numa_balancing = 0
kernel.sched_autogroup_enabled = 0
net.ipv4.tcp_adv_win_scale = 2 
net.ipv4.tcp_moderate_rcvbuf = 1
# --- Cherry-picked stability & security enhancements ---
vm.min_free_kbytes = 65536
net.ipv4.tcp_max_tw_buckets = 32768
net.ipv4.tcp_max_orphans = 32768
net.ipv4.route.gc_timeout = 100
net.ipv4.neigh.default.gc_stale_time = 120
# Harden networking against common attacks
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.arp_announce = 2
net.ipv4.conf.default.arp_announce = 2
net.ipv4.conf.all.arp_ignore = 1
net.ipv4.conf.default.arp_ignore = 1
# Disable IPv6 via sysctl
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

    info "正在使内核参数立即生效..."
    if sysctl -p "$sysctl_conf" >/dev/null 2>&1; then
        success "内核参数已应用并持久化。"
    else
        warn "部分内核参数应用失败。您的 VPS 可能是 OpenVZ/LXC 架构，不支持修改这些参数。"
    fi
}

disable_ipv6() { info "正在进一步禁用 IPv6..."; local dhclient_conf="/etc/dhcp/dhclient.conf"; local dhcp_config_line="send dhcp6.oro = [];"; if [ -f "$dhclient_conf" ]; then if grep -qF "$dhcp_config_line" "$dhclient_conf"; then info "DHCP 客户端已配置为不请求 IPv6 地址。"; else info "正在修改 DHCP 客户端配置..."; echo "$dhcp_config_line" >> "$dhclient_conf"; success "DHCP 客户端配置修改完成。"; fi; else info "未找到 DHCP 客户端配置文件，跳过此步骤。"; fi; info "正在重启网络服务以应用 DHCP 配置..."; if systemctl restart networking.service >/dev/null 2>&1; then success "网络服务已重启。"; else warn "网络服务重启失败，可能不影响 IPv6 禁用效果。"; fi; }

# --- [OPTIMIZED FUNCTION: set_ulimits] ---
# Removes the old block before appending the new one to prevent duplicates.
set_ulimits() {
    info "正在提升文件句柄数限制 (ulimits)..."
    local limits_conf="/etc/security/limits.conf"
    
    if grep -qF "# Added by Optimization Script" "$limits_conf"; then
        info "检测到旧的 ulimit 配置，正在移除以确保文件整洁..."
        local temp_file
        temp_file=$(mktemp)
        awk '
        /# Added by Optimization Script/ {
            c=5; 
        }
        c > 0 {
            c--;
            next;
        }
        { print }
        ' "$limits_conf" > "$temp_file"
        
        if [ -s "$temp_file" ]; then
             sed -i -e :a -e '/^\n*$/{$d;N;};/\n$/ba' "$temp_file"
        fi
        mv "$temp_file" "$limits_conf"
        success "旧配置已移除。"
    fi

    info "正在向 '$limits_conf' 添加新的 ulimit 配置..."
    cat <<EOF >> "$limits_conf"

# Added by Optimization Script
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF
    success "文件句柄数限制已更新并持久化。"
}

# --- [Main execution block] ---
main() { 
    clear
    echo -e "${GREEN}====================================================${NC}"
    echo -e "${GREEN}    终极 VPS 性能优化脚本 (v8.2 - BBR+FQ_PIE 增强排错版)    ${NC}"
    echo -e "${GREEN}====================================================${NC}"
    echo
    check_root
    update_and_install
    load_kernel_modules
    apply_sysctl_optimizations
    disable_ipv6
    set_ulimits
    echo
    success "系统优化已全部完成！"
    echo -e "${YELLOW}----------------------------------------------------${NC}"
    echo -e "${YELLOW}重要提示:${NC} ${BLUE}为使所有优化（特别是文件句柄限制）完全生效，建议立即重启。${NC}"
    echo -e "${YELLOW}----------------------------------------------------${NC}"
    read -p "是否现在立即重启 VPS? (Y/n): " reboot_choice
    if [[ "$reboot_choice" =~ ^[Yy]$ || -z "$reboot_choice" ]]; then
        info "正在执行重启操作..."
        sudo reboot
    else
        warn "已跳过重启。请在方便时手动执行 'sudo reboot'。"
    fi
    echo
}

main "$@"
