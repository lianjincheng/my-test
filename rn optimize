#!/bin/bash
#
# VPS Performance Optimization Script for Debian 12
# Author: Generated by AI Assistant for your specific needs
#
# This script performs the following actions:
# 1. Updates the system and installs necessary dependencies.
# 2. Intelligently loads required kernel modules for network performance.
# 3. Applies a set of sysctl optimizations for high-concurrency proxies.
# 4. Systematically disables IPv6.
# 5. Increases file descriptor limits (ulimits).
# It is designed to be idempotent and safe to re-run.
#

# --- Script Configuration and Best Practices ---
set -e # Exit immediately if a command exits with a non-zero status.
export LANG=en_US.UTF-8

# --- Color Definitions for better output ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# --- Helper functions for logging ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# --- Function to check for root privileges ---
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "此脚本需要以 root 权限运行。请使用 'sudo bash $0' 或切换到 root 用户。"
    fi
}

# --- Function to update system and install dependencies ---
update_and_install() {
    info "正在更新软件包列表并安装必要的依赖..."
    apt update >/dev/null 2>&1
    if apt install -y curl socat jq sudo coreutils grep sed >/dev/null 2>&1; then
        success "依赖项安装完成。"
    else
        error "依赖项安装失败，请检查 apt 源或网络连接。"
    fi
}

# --- Function to load kernel modules required for optimization ---
load_kernel_modules() {
    info "正在检查并加载优化所需的内核模块..."
    local modules=("tcp_bbr" "fq" "nf_conntrack")
    local modules_conf="/etc/modules-load.d/proxy-optimizations.conf"
    
    # Create the config file if it doesn't exist
    touch "$modules_conf"

    for module in "${modules[@]}"; do
        if lsmod | grep -q "^$module"; then
            info "模块 '$module' 已加载。"
        else
            info "正在尝试加载模块 '$module'..."
            if modprobe "$module"; then
                success "模块 '$module' 加载成功。"
            else
                warn "模块 '$module' 加载失败。您的 VPS 可能不支持此模块 (例如 OpenVZ 架构)。"
                continue # Continue to the next module
            fi
        fi
        
        # Ensure module loads on boot
        if ! grep -q "^$module$" "$modules_conf"; then
            echo "$module" >> "$modules_conf"
            info "已将模块 '$module' 添加到开机自启列表。"
        fi
    done
    success "内核模块检查和配置完成。"
}

# --- Function to apply sysctl kernel parameters ---
apply_sysctl_optimizations() {
    info "正在应用内核参数优化..."
    local sysctl_conf="/etc/sysctl.d/99-proxy-optimizations.conf"
    
    cat <<EOF > "$sysctl_conf"
# --- Generated by Optimization Script ---

# General network settings
net.core.netdev_max_backlog = 32768
net.core.somaxconn = 32768
net.core.rmem_default = 262144
net.core.rmem_max = 16777216
net.core.wmem_default = 262144
net.core.wmem_max = 16777216
net.core.optmem_max = 16777216

# TCP settings
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_syn_retries = 2
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_tw_recycle = 0
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_notsent_lowat = 16384

# TCP Congestion Control (BBR)
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq

# UDP settings (for Hy2/QUIC)
net.ipv4.udp_mem = 4096 87380 16777216

# IP Fragmentation
net.ipv4.ipfrag_high_thresh = 16777216
net.ipv4.ipfrag_low_thresh = 15728640

# Connection tracking
net.netfilter.nf_conntrack_max = 655350
net.netfilter.nf_conntrack_tcp_timeout_established = 1200

# File descriptor limits
fs.file-max = 1048576
fs.nr_open = 1048576

# VM settings
vm.swappiness = 10

# Disable IPv6 via sysctl (Primary method)
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

    info "正在使内核参数立即生效..."
    if sysctl -p "$sysctl_conf" >/dev/null 2>&1; then
        success "内核参数已应用并持久化。"
    else
        warn "部分内核参数应用失败。您的 VPS 可能是 OpenVZ/LXC 架构，不支持修改这些参数。"
    fi
}

# --- Function to thoroughly disable IPv6 ---
disable_ipv6() {
    info "正在进一步禁用 IPv6..."
    
    # Modify dhclient.conf to not request IPv6 address
    local dhclient_conf="/etc/dhcp/dhclient.conf"
    if [ -f "$dhclient_conf" ]; then
        if grep -q "send dhcp6.oro = [];" "$dhclient_conf"; then
            info "DHCP 客户端已配置为不请求 IPv6 地址。"
        else
            info "正在修改 DHCP 客户端配置..."
            echo "send dhcp6.oro = [];" >> "$dhclient_conf"
            success "DHCP 客户端配置修改完成。"
        fi
    else
        info "未找到 DHCP 客户端配置文件，跳过此步骤。"
    fi
    
    info "正在重启网络服务以应用 DHCP 配置..."
    if systemctl restart networking.service >/dev/null 2>&1; then
        success "网络服务已重启。"
    else
        warn "网络服务重启失败，可能不影响 IPv6 禁用效果。"
    fi
}

# --- Function to set file descriptor limits (ulimit) ---
set_ulimits() {
    info "正在提升文件句柄数限制..."
    local limits_conf="/etc/security/limits.conf"
    
    if grep -q "# Added by Optimization Script" "$limits_conf"; then
        info "文件句柄数限制已配置。"
    else
        info "正在向 '$limits_conf' 添加配置..."
        cat <<EOF >> "$limits_conf"

# Added by Optimization Script
# Increase file descriptor limits for high-concurrency applications
* soft nofile 65536
* hard nofile 65536
root soft nofile 65536
root hard nofile 65536
EOF
        success "文件句柄数限制已提升并持久化。"
    fi
}

# --- Main function to orchestrate all tasks ---
main() {
    clear
    echo -e "${GREEN}====================================================${NC}"
    echo -e "${GREEN}     VPS 高性能代理优化脚本 for Debian 12      ${NC}"
    echo -e "${GREEN}====================================================${NC}"
    echo
    
    check_root
    update_and_install
    load_kernel_modules
    apply_sysctl_optimizations
    disable_ipv6
    set_ulimits
    
    echo
    success "系统优化已全部完成！"
    info "建议您重启 VPS (sudo reboot) 以确保所有设置（特别是文件句柄限制）完全生效。"
    echo
}

# --- Execute the main function ---
main "$@"
