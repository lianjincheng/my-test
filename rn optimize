#!/bin/bash
#
# Ultimate VPS Performance Optimization Script (v7 - Golden Static Parameters)
# Reverts to user-validated high-performance static parameters, while keeping all script enhancements.
#

# --- [Script header and helper functions remain the same] ---
set -e
export LANG=en_US.UTF-8
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
check_root() { if [ "$(id -u)" -ne 0 ]; then error "此脚本需要以 root 权限运行。请使用 'sudo bash $0' 或切换到 root 用户。"; fi; }
update_and_install() { info "正在更新软件包列表并安装必要的依赖..."; apt update >/dev/null 2>&1; if apt install -y curl socat jq sudo coreutils grep sed >/dev/null 2>&1; then success "依赖项安装完成。"; else error "依赖项安装失败，请检查 apt 源或网络连接。"; fi; }
load_kernel_modules() { info "正在检查并加载优化所需的内核模块..."; local modules=("tcp_bbr" "sch_fq" "nf_conntrack"); local modules_conf="/etc/modules-load.d/proxy-optimizations.conf"; touch "$modules_conf"; for module in "${modules[@]}"; do local check_name=${module#sch_}; if lsmod | grep -q "^$check_name"; then info "模块 '$module' 已加载。"; else info "正在尝试加载模块 '$module'..."; if modprobe "$module"; then success "模块 '$module' 加载成功。"; else warn "模块 '$module' 加载失败。您的 VPS 可能不支持此模块 (例如 OpenVZ 架构)。"; continue; fi; fi; if ! grep -q "^$module$" "$modules_conf"; then echo "$module" >> "$modules_conf"; info "已将模块 '$module' 添加到开机自启列表。"; fi; done; success "内核模块检查和配置完成。"; }

# ---
# *** 核心修改：移除动态计算，回归您验证过的“黄金参数” ***
# ---
apply_sysctl_optimizations() {
    info "正在应用终极内核参数优化 (黄金固定参数 + 激进TCP)..."
    local sysctl_conf="/etc/sysctl.d/99-proxy-optimizations.conf"
    
    cat <<EOF > "$sysctl_conf"
# --- Generated by Ultimate Optimization Script (Golden Static Parameters) ---

# Golden Buffer Settings (User-validated)
net.core.rmem_max = 134217728
net.core.wmem_max = 134217728
net.ipv4.tcp_rmem = 32768 262144 134217728
net.ipv4.tcp_wmem = 32768 262144 134217728
net.core.optmem_max = 134217728

# Aggressive TCP Connection Resilience Settings
net.ipv4.tcp_syn_retries = 6
net.ipv4.tcp_synack_retries = 6
net.ipv4.tcp_retries2 = 8
net.ipv4.tcp_fastopen = 3

# High Performance TCP Settings
net.core.netdev_max_backlog = 32768
net.core.somaxconn = 32768
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_keepalive_intvl = 30

# Further reduce latency and improve responsiveness
net.ipv4.tcp_notsent_lowat = 524288
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_fack = 1

# Memory management fine-tuning
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5


# TCP Congestion Control (BBR)
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq

# High Performance Static Limits
net.netfilter.nf_conntrack_max = 655350
fs.file-max = 1048576
fs.nr_open = 1048576
vm.swappiness = 10

# Disable IPv6 via sysctl
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

    info "正在使内核参数立即生效..."
    if sysctl -p "$sysctl_conf" >/dev/null 2>&1; then
        success "内核参数已应用并持久化。"
    else
        warn "部分内核参数应用失败。您的 VPS 可能是 OpenVZ/LXC 架构，不支持修改这些参数。"
    fi
}

# --- [The rest of the script remains unchanged] ---
disable_ipv6() { info "正在进一步禁用 IPv6..."; local dhclient_conf="/etc/dhcp/dhclient.conf"; local dhcp_config_line="send dhcp6.oro = [];"; if [ -f "$dhclient_conf" ]; then if grep -qF "$dhcp_config_line" "$dhclient_conf"; then info "DHCP 客户端已配置为不请求 IPv6 地址。"; else info "正在修改 DHCP 客户端配置..."; echo "$dhcp_config_line" >> "$dhclient_conf"; success "DHCP 客户端配置修改完成。"; fi; else info "未找到 DHCP 客户端配置文件，跳过此步骤。"; fi; info "正在重启网络服务以应用 DHCP 配置..."; if systemctl restart networking.service >/dev/null 2>&1; then success "网络服务已重启。"; else warn "网络服务重启失败，可能不影响 IPv6 禁用效果。"; fi; }
set_ulimits() { info "正在提升文件句柄数限制..."; local limits_conf="/etc/security/limits.conf"; if grep -qF "# Added by Optimization Script" "$limits_conf"; then info "文件句柄数限制已配置。"; else info "正在向 '$limits_conf' 添加配置..."; cat <<EOF >> "$limits_conf"

# Added by Optimization Script
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF
success "文件句柄数限制已提升并持久化。"; fi; }
main() { clear; echo -e "${GREEN}====================================================${NC}"; echo -e "${GREEN}        终极 VPS 性能优化脚本 (最终版)        ${NC}"; echo -e "${GREEN}====================================================${NC}"; echo; check_root; update_and_install; load_kernel_modules; apply_sysctl_optimizations; disable_ipv6; set_ulimits; echo; success "系统优化已全部完成！"; echo -e "${YELLOW}----------------------------------------------------${NC}"; echo -e "${YELLOW}重要提示:${NC} ${BLUE}为使所有优化（特别是文件句柄限制）完全生效，建议立即重启。${NC}"; echo -e "${YELLOW}----------------------------------------------------${NC}"; read -p "是否现在立即重启 VPS? (Y/n): " reboot_choice; if [[ "$reboot_choice" =~ ^[Yy]$ || -z "$reboot_choice" ]]; then info "正在执行重启操作..."; sudo reboot; else warn "已跳过重启。请在方便时手动执行 'sudo reboot'。"; fi; echo; }
main "$@"
