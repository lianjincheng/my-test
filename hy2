#!/bin/bash

export LANG=en_US.UTF-8

# --- 颜色定义 ---
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
PLAIN="\033[0m"

red(){
    echo -e "\033[31m\033[01m$1\033[0m"
}

green(){
    echo -e "\033[32m\033[01m$1\033[0m"
}

yellow(){
    echo -e "\033[33m\033[01m$1\033[0m"
}

# --- 系统检测和包管理器定义 ---
REGEX=("debian" "ubuntu" "centos|red hat|kernel|oracle linux|alma|rocky" "'amazon linux'" "fedora")
RELEASE=("Debian" "Ubuntu" "CentOS" "CentOS" "Fedora")
PACKAGE_UPDATE=("apt-get update" "apt-get update" "yum -y update" "yum -y update" "yum -y update")
PACKAGE_INSTALL=("apt -y install" "apt -y install" "yum -y install" "yum -y install" "yum -y install")

# --- 权限检查 ---
[[ $EUID -ne 0 ]] && red "错误: 请在root用户下运行脚本" && exit 1

# --- 系统识别 ---
CMD=("$(grep -i pretty_name /etc/os-release 2>/dev/null | cut -d \" -f2)" "$(hostnamectl 2>/dev/null | grep -i system | cut -d : -f2)" "$(lsb_release -sd 2>/dev/null)" "$(grep -i description /etc/lsb-release 2>/dev/null | cut -d \" -f2)" "$(grep . /etc/redhat-release 2>/dev/null)" "$(grep . /etc/issue 2>/dev/null | cut -d \\ -f1 | sed '/^[ ]*$/d')")

for i in "${CMD[@]}"; do
    SYS="$i" && [[ -n $SYS ]] && break
done

for ((int = 0; int < ${#REGEX[@]}; int++)); do
    if [[ $(echo "$SYS" | tr '[:upper:]' '[:lower:]') =~ ${REGEX[int]} ]]; then
        SYSTEM="${RELEASE[int]}"
        break
    fi
done

[[ -z $SYSTEM ]] && red "错误: 目前暂不支持您的操作系统！" && exit 1

# --- 依赖安装 ---
if [[ -z $(type -P curl) || -z $(type -P sudo) ]]; then
    if [[ ! $SYSTEM == "CentOS" ]]; then
        ${PACKAGE_UPDATE[int]}
    fi
    ${PACKAGE_INSTALL[int]} curl sudo
fi

# --- 全局变量 ---
cert_path="/etc/hysteria/cert.crt"
key_path="/etc/hysteria/private.key"
hy_domain="www.bing.com"

# --- 自动配置生成函数 ---
generate_self_signed_cert(){
    green "正在生成 www.bing.com 的自签证书..."
    mkdir -p /etc/hysteria
    openssl ecparam -genkey -name prime256v1 -out "$key_path"
    openssl req -new -x509 -days 36500 -key "$key_path" -out "$cert_path" -subj "/CN=$hy_domain"
    green "自签证书生成完毕。"
}

generate_random_port(){
    green "正在随机生成可用端口..."
    while true; do
        port=$(shuf -i 1000-65535 -n 1)
        if ! ss -tunlp | grep -w udp | awk '{print $5}' | sed 's/.*://g' | grep -w -q "$port"; then
            yellow "Hysteria 2 将使用的端口是: $port"
            break
        else
            yellow "端口 $port 已被占用，正在重新生成..."
        fi
    done
}

generate_random_credentials(){
    green "正在随机生成连接密码和混淆密码..."
    auth_pwd=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | fold -w 16 | head -n 1)
    obfs_pwd=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | fold -w 16 | head -n 1)
    yellow "连接密码: $auth_pwd"
    yellow "混淆密码: $obfs_pwd"
}

# --- 服务端和客户端配置生成 ---
generate_all_configs(){
    # ---- 生成服务端配置 ----
    cat << EOF > /etc/hysteria/config.yaml
listen: :$port

tls:
  cert: $cert_path
  key: $key_path

auth:
  type: password
  password: $auth_pwd

obfs:
  type: password
  password: $obfs_pwd

masquerade:
  type: proxy
  proxy:
    url: https://www.bing.com
    rewriteHost: true

quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
EOF

    # ---- 获取本机IP ----
    ip=$(curl -s4m8 ip.gs -k) || ip=$(curl -s6m8 ip.gs -k)
    [[ -n $(echo $ip | grep ":") ]] && last_ip="[$ip]" || last_ip=$ip
    
    mkdir -p /root/hy
    
    # ---- 生成客户端 YAML 配置 ----
    cat << EOF > /root/hy/hy-client.yaml
server: $last_ip:$port
auth: $auth_pwd
obfs: $obfs_pwd
tls:
  sni: $hy_domain
  insecure: true
fastOpen: true
socks5:
  listen: 127.0.0.1:1080
transport:
  udp:
    hopInterval: 30s
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
EOF

    # ---- 生成 Clash Meta 配置 ----
    cat <<EOF > /root/hy/clash-meta.yaml
mixed-port: 7890
external-controller: 127.0.0.1:9090
allow-lan: false
mode: rule
log-level: info
ipv6: true
dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  nameserver: [8.8.8.8, 1.1.1.1]
proxies:
  - name: Misaka-Hysteria2
    type: hysteria2
    server: $ip
    port: $port
    password: $auth_pwd
    obfs: $obfs_pwd
    sni: $hy_domain
    skip-cert-verify: true
proxy-groups:
  - name: PROXY
    type: select
    proxies: [Misaka-Hysteria2]
rules:
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
EOF

    # ---- 生成分享链接 ----
    url="hysteria2://$auth_pwd@$last_ip:$port/?insecure=1&sni=$hy_domain&obfs=$obfs_pwd#Misaka-Hysteria2"
    echo "$url" > /root/hy/url.txt
}

# --- 核心功能函数 ---
insthysteria(){
    green "开始安装 Hysteria 2..."
    
    # 安装 Hysteria 核心
    wget -N https://raw.githubusercontent.com/Misaka-blog/hysteria-install/main/hy2/install_server.sh
    if ! bash install_server.sh; then
        red "Hysteria 2 核心安装失败！"
        rm -f install_server.sh
        exit 1
    fi
    rm -f install_server.sh
    green "Hysteria 2 核心安装成功！"

    # ---- 自动生成所有配置 ----
    generate_self_signed_cert
    generate_random_port
    generate_random_credentials
    generate_all_configs

    # ---- 启动服务并显示结果 ----
    systemctl daemon-reload
    systemctl enable hysteria-server
    systemctl start hysteria-server
    
    if systemctl is-active --quiet hysteria-server; then
        green "Hysteria 2 服务启动成功！"
    else
        red "Hysteria 2 服务启动失败，请运行 'journalctl -u hysteria-server' 查看日志。"
        exit 1
    fi
    
    red "======================================================================================"
    green "Hysteria 2 代理服务安装完成！配置信息已自动生成。"
    showconf
}

unsthysteria(){
    systemctl disable --now hysteria-server.service >/dev/null 2>&1
    rm -f /lib/systemd/system/hysteria-server.service /lib/systemd/system/hysteria-server@.service
    rm -rf /usr/local/bin/hysteria /etc/hysteria /root/hy
    systemctl daemon-reload
    green "Hysteria 2 已彻底卸载完成！"
}

starthysteria(){
    systemctl start hysteria-server
    if systemctl is-active --quiet hysteria-server; then green "Hysteria 2 启动成功"; else red "Hysteria 2 启动失败"; fi
}

stophysteria(){
    systemctl stop hysteria-server
    if ! systemctl is-active --quiet hysteria-server; then green "Hysteria 2 关闭成功"; else red "Hysteria 2 关闭失败"; fi
}

restarthysteria(){
    systemctl restart hysteria-server
    if systemctl is-active --quiet hysteria-server; then green "Hysteria 2 重启成功"; else red "Hysteria 2 重启失败"; fi
}

hysteriaswitch(){
    yellow "请选择操作："
    echo -e " ${GREEN}1.${PLAIN} 启动 Hysteria 2"
    echo -e " ${GREEN}2.${PLAIN} 关闭 Hysteria 2"
    echo -e " ${GREEN}3.${PLAIN} 重启 Hysteria 2"
    read -rp "请输入选项 [1-3]: " switchInput
    case $switchInput in
        1) starthysteria ;;
        2) stophysteria ;;
        3) restarthysteria ;;
        *) exit 1 ;;
    esac
}

showconf(){
    if [[ ! -f /etc/hysteria/config.yaml ]]; then
        red "错误：未找到 Hysteria 2 配置文件，请先安装。"
        return
    fi
    yellow "客户端 YAML 配置 (路径: /root/hy/hy-client.yaml):"
    red "$(cat /root/hy/hy-client.yaml)"
    yellow "客户端 JSON 配置 (路径: /root/hy/hy-client.json):"
    red "$(cat /root/hy/hy-client.json)"
    yellow "Clash Meta 客户端配置 (路径: /root/hy/clash-meta.yaml)"
    yellow "分享链接 (路径: /root/hy/url.txt):"
    red "$(cat /root/hy/url.txt)"
}

update_core(){
    wget -N https://raw.githubusercontent.com/Misaka-blog/hysteria-install/main/hy2/install_server.sh
    if ! bash install_server.sh; then
        red "Hysteria 2 核心更新失败！"
    else
        green "Hysteria 2 核心更新成功，正在重启服务..."
        restarthysteria
    fi
    rm -f install_server.sh
}

# --- 主菜单 ---
menu() {
    clear
    echo "#############################################################"
    echo -e "#              ${RED}Hysteria 2 全自动一键安装脚本${PLAIN}              #"
    echo "#############################################################"
    echo ""
    echo -e " ${GREEN}1.${PLAIN} 安装 Hysteria 2 ${YELLOW}(全自动，零交互)${PLAIN}"
    echo -e " ${GREEN}2.${PLAIN} ${RED}卸载 Hysteria 2${PLAIN}"
    echo " -------------"
    echo -e " ${GREEN}3.${PLAIN} 管理 Hysteria 2 (启动/停止/重启)"
    echo -e " ${GREEN}4.${PLAIN} 显示客户端配置/链接"
    echo " ${GREEN}5.${PLAIN} 更新 Hysteria 2 核心"
    echo " -------------"
    echo -e " ${GREEN}0.${PLAIN} 退出脚本"
    echo ""
    read -rp "请输入选项 [0-5]: " menuInput
    case $menuInput in
        1) insthysteria ;;
        2) unsthysteria ;;
        3) hysteriaswitch ;;
        4) showconf ;;
        5) update_core ;;
        *) exit 1 ;;
    esac
}

# --- 脚本入口 ---
menu
