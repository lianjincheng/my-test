#!/bin/bash

export LANG=en_US.UTF-8

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
PLAIN="\033[0m"

red(){
    echo -e "\033[31m\033[01m$1\033[0m"
}

green(){
    echo -e "\033[32m\033[01m$1\033[0m"
}

yellow(){
    echo -e "\033[33m\033[01m$1\033[0m"
}

# 判断系统及定义系统安装依赖方式
REGEX=("debian" "ubuntu" "centos|red hat|kernel|oracle linux|alma|rocky" "'amazon linux'" "fedora")
RELEASE=("Debian" "Ubuntu" "CentOS" "CentOS" "Fedora")
PACKAGE_UPDATE=("apt-get update" "apt-get update" "yum -y update" "yum -y update" "yum -y update")
PACKAGE_INSTALL=("apt -y install" "apt -y install" "yum -y install" "yum -y install" "yum -y install")
PACKAGE_REMOVE=("apt -y remove" "apt -y remove" "yum -y remove" "yum -y remove" "yum -y remove")

[[ $EUID -ne 0 ]] && red "注意: 请在root用户下运行脚本" && exit 1

CMD=("$(grep -i pretty_name /etc/os-release 2>/dev/null | cut -d \" -f2)" "$(hostnamectl 2>/dev/null | grep -i system | cut -d : -f2)" "$(lsb_release -sd 2>/dev/null)" "$(grep -i description /etc/lsb-release 2>/dev/null | cut -d \" -f2)" "$(grep . /etc/redhat-release 2>/dev/null)" "$(grep . /etc/issue 2>/dev/null | cut -d \\ -f1 | sed '/^[ ]*$/d')")

for i in "${CMD[@]}"; do
    SYS="$i" && [[ -n $SYS ]] && break
done

for ((int = 0; int < ${#REGEX[@]}; int++)); do
    [[ $(echo "$SYS" | tr '[:upper:]' '[:lower:]') =~ ${REGEX[int]} ]] && SYSTEM="${RELEASE[int]}" && [[ -n $SYSTEM ]] && break
done

[[ -z $SYSTEM ]] && red "目前暂不支持你的VPS的操作系统！" && exit 1

if [[ -z $(type -P curl) ]]; then
    if [[ ! $SYSTEM == "CentOS" ]]; then
        ${PACKAGE_UPDATE[int]}
    fi
    ${PACKAGE_INSTALL[int]} curl
fi

realip(){
    ip=$(curl -s4m8 ip.gs -k) || ip=$(curl -s6m8 ip.gs -k)
}

inst_cert(){
    green "Hysteria 2 协议证书申请方式如下："
    echo ""
    echo -e " ${GREEN}1.${PLAIN} 使用 www.bing.com 的自签证书 ${YELLOW}（默认）${PLAIN}"
    echo -e " ${GREEN}2.${PLAIN} Acme 脚本自动申请 (Let's Encrypt)"
    echo -e " ${GREEN}3.${PLAIN} 使用自定义证书路径"
    echo ""
    read -rp "请输入选项 [1-3]: " certInput
    if [[ $certInput == 2 ]]; then
        cert_path="/root/cert.crt"
        key_path="/root/private.key"

        # 确保/root目录权限，避免acme.sh出现权限问题
        chmod 755 /root

        if [[ -f /root/cert.crt && -f /root/private.key ]] && [[ -s /root/cert.crt && -s /root/private.key ]] && [[ -f /root/ca.log ]]; then
            domain=$(cat /root/ca.log)
            green "检测到原有域名：$domain 的证书，正在应用"
            hy_domain=$domain
        else
            realip
            read -p "请输入需要申请证书的域名：" domain
            [[ -z $domain ]] && red "未输入域名，无法执行操作！" && exit 1
            green "已输入的域名：$domain" && sleep 1
            
            # 检查域名解析
            domainIP=$(dig @8.8.8.8 +time=2 +short "$domain" 2>/dev/null)
            if [[ -z $domainIP ]]; then
                domainIP=$(dig @2001:4860:4860::8888 +time=2 aaaa +short "$domain" 2>/dev/null)
            fi

            if [[ -z $domainIP ]]; then
                 red "域名未能解析到任何 IP 地址，请检查您的 DNS 设置"
                 exit 1
            fi
            
            if [[ "$domainIP" == "$ip" ]]; then
                ${PACKAGE_INSTALL[int]} curl wget sudo socat openssl
                if [[ $SYSTEM == "CentOS" ]]; then
                    ${PACKAGE_INSTALL[int]} cronie
                    systemctl start crond
                    systemctl enable crond
                else
                    ${PACKAGE_INSTALL[int]} cron
                    systemctl start cron
                    systemctl enable cron
                fi
                # 安装 acme.sh
                curl https://get.acme.sh | sh -s email=$(date +%s%N | md5sum | cut -c 1-16)@gmail.com
                source ~/.bashrc
                bash ~/.acme.sh/acme.sh --upgrade --auto-upgrade
                bash ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt
                
                # 申请证书
                issue_cmd="bash ~/.acme.sh/acme.sh --issue -d ${domain} --standalone -k ec-256 --insecure"
                [[ -n $(echo $ip | grep ":") ]] && issue_cmd="$issue_cmd --listen-v6" # 侦听IPv6
                $issue_cmd

                # 安装证书
                bash ~/.acme.sh/acme.sh --install-cert -d ${domain} --key-file /root/private.key --fullchain-file /root/cert.crt --ecc
                
                if [[ -f /root/cert.crt && -f /root/private.key ]] && [[ -s /root/cert.crt && -s /root/private.key ]]; then
                    echo $domain > /root/ca.log
                    sed -i '/acme.sh --cron/d' /etc/crontab >/dev/null 2>&1
                    echo "0 0 * * * root bash /root/.acme.sh/acme.sh --cron -f >/dev/null 2>&1" >> /etc/crontab
                    green "证书申请成功! 证书 (cert.crt) 和私钥 (private.key) 文件已保存到 /root 文件夹下"
                    hy_domain=$domain
                else
                    red "证书申请失败，请检查 acme.sh 的日志输出"
                    exit 1
                fi
            else
                red "当前域名解析的IP ($domainIP) 与当前VPS的真实IP ($ip) 不匹配"
                yellow "请检查DNS解析设置，确保域名正确指向本机IP，并且没有开启CDN（云朵应为灰色）"
                exit 1
            fi
        fi
    elif [[ $certInput == 3 ]]; then
        read -p "请输入公钥文件 crt 的路径：" cert_path
        [[ ! -f $cert_path ]] && red "公钥文件路径无效！" && exit 1
        yellow "公钥文件 crt 的路径：$cert_path"
        
        read -p "请输入密钥文件 key 的路径：" key_path
        [[ ! -f $key_path ]] && red "密钥文件路径无效！" && exit 1
        yellow "密钥文件 key 的路径：$key_path"
        
        read -p "请输入证书对应的域名（用于SNI）：" domain
        [[ -z "$domain" ]] && red "证书域名不能为空！" && exit 1
        yellow "证书域名 (SNI)：$domain"
        hy_domain=$domain
    else
        green "将使用 www.bing.com 的自签证书"
        mkdir -p /etc/hysteria
        cert_path="/etc/hysteria/cert.crt"
        key_path="/etc/hysteria/private.key"
        openssl ecparam -genkey -name prime256v1 -out $key_path
        openssl req -new -x509 -days 36500 -key $key_path -out $cert_path -subj "/CN=www.bing.com"
        hy_domain="www.bing.com"
    fi
}

inst_port(){
    read -p "设置 Hysteria 2 端口 [1-65535]（回车则随机分配端口）：" port
    [[ -z $port ]] && port=$(shuf -i 2000-65535 -n 1)
    
    # 检查端口占用
    until [[ -z $(ss -tunlp | grep -w udp | awk '{print $5}' | sed 's/.*://g' | grep -w "$port") ]]; do
        if [[ -n $(ss -tunlp | grep -w udp | awk '{print $5}' | sed 's/.*://g' | grep -w "$port") ]]; then
            red "$port 端口已经被其他程序占用，请更换端口重试！"
            read -p "设置 Hysteria 2 端口 [1-65535]（回车则随机分配端口）：" port
            [[ -z $port ]] && port=$(shuf -i 2000-65535 -n 1)
        fi
    done

    yellow "Hysteria 2 将使用的端口是：$port"
}

inst_pwd(){
    read -p "设置 Hysteria 2 连接密码（回车则生成随机密码）：" auth_pwd
    [[ -z $auth_pwd ]] && auth_pwd=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | fold -w 16 | head -n 1)
    yellow "Hysteria 2 节点的连接密码为：$auth_pwd"
}

inst_obfs(){
    read -p "设置 Hysteria 2 混淆密码（obfs, 回车则不启用）：" obfs_pwd
    if [[ -n "$obfs_pwd" ]]; then
        yellow "Hysteria 2 节点的混淆密码为：$obfs_pwd"
    else
        green "不启用混淆密码"
    fi
}

generate_config(){
    # ---- 生成服务端配置 ----
    cat << EOF > /etc/hysteria/config.yaml
listen: :$port

tls:
  cert: $cert_path
  key: $key_path

auth:
  type: password
  password: $auth_pwd
EOF

    # 如果设置了混淆密码，则加入配置
    if [[ -n "$obfs_pwd" ]]; then
        cat << EOF >> /etc/hysteria/config.yaml

obfs:
  type: password
  password: $obfs_pwd
EOF
    fi

    # 加入伪装和QUIC配置
    cat << EOF >> /etc/hysteria/config.yaml

masquerade:
  type: proxy
  proxy:
    url: https://www.bing.com
    rewriteHost: true

quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
EOF
}

generate_client_config(){
    realip
    
    # 给 IPv6 地址加中括号
    [[ -n $(echo $ip | grep ":") ]] && last_ip="[$ip]" || last_ip=$ip
    
    mkdir -p /root/hy
    
    # ---- 生成客户端 YAML 配置 ----
    cat << EOF > /root/hy/hy-client.yaml
server: $last_ip:$port
auth: $auth_pwd
tls:
  sni: $hy_domain
  insecure: true
EOF
    [[ -n "$obfs_pwd" ]] && echo "obfs: $obfs_pwd" >> /root/hy/hy-client.yaml
    cat << EOF >> /root/hy/hy-client.yaml
fastOpen: true
socks5:
  listen: 127.0.0.1:1080
transport:
  udp:
    hopInterval: 30s
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
EOF

    # ---- 生成客户端 JSON 配置 ----
    json_obfs_part=""
    [[ -n "$obfs_pwd" ]] && json_obfs_part="\"obfs\": \"$obfs_pwd\","
    cat << EOF > /root/hy/hy-client.json
{
  "server": "$last_ip:$port",
  "auth": "$auth_pwd",
  $json_obfs_part
  "tls": {
    "sni": "$hy_domain",
    "insecure": true
  },
  "fastOpen": true,
  "socks5": {
    "listen": "127.0.0.1:1080"
  },
  "transport": {
    "udp": {
      "hopInterval": "30s"
    }
  },
  "quic": {
    "initStreamReceiveWindow": 8388608,
    "maxStreamReceiveWindow": 8388608,
    "initConnReceiveWindow": 20971520,
    "maxConnReceiveWindow": 20971520
  }
}
EOF

    # ---- 生成 Clash Meta 配置 ----
    clash_obfs_part=""
    [[ -n "$obfs_pwd" ]] && clash_obfs_part="obfs: $obfs_pwd"
    cat <<EOF > /root/hy/clash-meta.yaml
mixed-port: 7890
external-controller: 127.0.0.1:9090
allow-lan: false
mode: rule
log-level: info
ipv6: true
dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  nameserver:
    - 8.8.8.8
    - 1.1.1.1
proxies:
  - name: Misaka-Hysteria2
    type: hysteria2
    server: $ip
    port: $port
    password: $auth_pwd
    sni: $hy_domain
    skip-cert-verify: true
    $clash_obfs_part
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - Misaka-Hysteria2
rules:
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
EOF

    # ---- 生成分享链接 ----
    url_obfs_part=""
    [[ -n "$obfs_pwd" ]] && url_obfs_part="&obfs=$obfs_pwd"
    url="hysteria2://$auth_pwd@$last_ip:$port/?insecure=1&sni=$hy_domain$url_obfs_part#Misaka-Hysteria2"
    echo $url > /root/hy/url.txt
}

insthysteria(){
    realip

    if [[ ! ${SYSTEM} == "CentOS" ]]; then
        ${PACKAGE_UPDATE[int]}
    fi
    ${PACKAGE_INSTALL[int]} curl wget sudo

    # 安装 Hysteria 核心
    wget -N https://raw.githubusercontent.com/Misaka-blog/hysteria-install/main/hy2/install_server.sh
    bash install_server.sh
    rm -f install_server.sh

    if [[ -f "/usr/local/bin/hysteria" ]]; then
        green "Hysteria 2 核心安装成功！"
    else
        red "Hysteria 2 核心安装失败！"
        exit 1
    fi

    # ---- 收集用户配置 ----
    inst_cert
    inst_port
    inst_pwd
    inst_obfs

    # ---- 生成服务端和客户端配置 ----
    generate_config
    generate_client_config

    # ---- 启动服务并显示结果 ----
    systemctl daemon-reload
    systemctl enable hysteria-server
    systemctl start hysteria-server
    
    if [[ -n $(systemctl status hysteria-server 2>/dev/null | grep -w active) && -f '/etc/hysteria/config.yaml' ]]; then
        green "Hysteria 2 服务启动成功"
    else
        red "Hysteria 2 服务启动失败，请运行 systemctl status hysteria-server 查看服务状态并反馈"
        exit 1
    fi
    
    red "======================================================================================"
    green "Hysteria 2 代理服务安装完成"
    showconf
}

unsthysteria(){
    systemctl stop hysteria-server.service >/dev/null 2>&1
    systemctl disable hysteria-server.service >/dev/null 2>&1
    rm -f /lib/systemd/system/hysteria-server.service /lib/systemd/system/hysteria-server@.service
    rm -rf /usr/local/bin/hysteria /etc/hysteria /root/hy /root/ca.log
    green "Hysteria 2 已彻底卸载完成！"
}

starthysteria(){
    systemctl start hysteria-server
    if [[ $? -eq 0 ]]; then
        green "Hysteria 2 启动成功"
    else
        red "Hysteria 2 启动失败"
    fi
}

stophysteria(){
    systemctl stop hysteria-server
    if [[ $? -eq 0 ]]; then
        green "Hysteria 2 关闭成功"
    else
        red "Hysteria 2 关闭失败"
    fi
}

restarthysteria(){
    systemctl restart hysteria-server
    if [[ $? -eq 0 ]]; then
        green "Hysteria 2 重启成功"
    else
        red "Hysteria 2 重启失败"
    fi
}

hysteriaswitch(){
    yellow "请选择你需要的操作："
    echo ""
    echo -e " ${GREEN}1.${PLAIN} 启动 Hysteria 2"
    echo -e " ${GREEN}2.${PLAIN} 关闭 Hysteria 2"
    echo -e " ${GREEN}3.${PLAIN} 重启 Hysteria 2"
    echo ""
    read -rp "请输入选项 [1-3]: " switchInput
    case $switchInput in
        1 ) starthysteria ;;
        2 ) stophysteria ;;
        3 ) restarthysteria ;;
        * ) exit 1 ;;
    esac
}

# ---- 配置修改函数 ----

# 重新生成所有客户端配置的辅助函数
regenerate_client_configs_after_change() {
    # 从服务端配置中读取现有参数
    port=$(grep -oP 'listen: :\K\d+' /etc/hysteria/config.yaml)
    auth_pwd=$(awk '/auth:/ {f=1} f && /password:/ {print $2; f=0}' /etc/hysteria/config.yaml)
    obfs_pwd=$(awk '/obfs:/ {f=1} f && /password:/ {print $2; f=0}' /etc/hysteria/config.yaml)
    # 从客户端配置中读取SNI
    hy_domain=$(grep 'sni:' /root/hy/hy-client.yaml | awk '{print $2}')

    generate_client_config
    
    restarthysteria
    green "配置修改成功，已重启 Hysteria 2 服务！"
    yellow "请使用下方新的配置信息更新您的客户端。"
    showconf
}

changeport(){
    oldport=$(grep -oP 'listen: :\K\d+' /etc/hysteria/config.yaml)
    read -p "当前端口为 $oldport, 请输入新端口 [1-65535]（回车则随机分配）：" new_port
    [[ -z $new_port ]] && new_port=$(shuf -i 2000-65535 -n 1)

    # 检查端口占用
    until [[ -z $(ss -tunlp | grep -w udp | awk '{print $5}' | sed 's/.*://g' | grep -w "$new_port") ]]; do
        if [[ -n $(ss -tunlp | grep -w udp | awk '{print $5}' | sed 's/.*://g' | grep -w "$new_port") ]]; then
            red "$new_port 端口已经被其他程序占用，请更换端口！"
            read -p "请输入新端口 [1-65535]（回车则随机分配）：" new_port
            [[ -z $new_port ]] && new_port=$(shuf -i 2000-65535 -n 1)
        fi
    done

    sed -i "s/:$oldport/:$new_port/" /etc/hysteria/config.yaml
    regenerate_client_configs_after_change
}

changepasswd(){
    inst_pwd # 调用输入密码的函数
    # 使用awk安全地替换第一个password（即auth password）
    awk -v new_pwd="$auth_pwd" '
    BEGIN {p=1}
    /auth:/ {f=1}
    f && /password:/ && p {sub($2, new_pwd); p=0; f=0}
    {print}
    ' /etc/hysteria/config.yaml > /tmp/hy.tmp && mv /tmp/hy.tmp /etc/hysteria/config.yaml
    
    regenerate_client_configs_after_change
}

changeobfs(){
    inst_obfs # 调用输入obfs密码的函数

    # 删除旧的obfs配置块
    sed -i '/obfs:/,/password:/d' /etc/hysteria/config.yaml

    # 如果输入了新的obfs密码，则追加到文件末尾
    if [[ -n "$obfs_pwd" ]]; then
        cat << EOF >> /etc/hysteria/config.yaml

obfs:
  type: password
  password: $obfs_pwd
EOF
    fi

    regenerate_client_configs_after_change
}

change_cert(){
    inst_cert # 调用证书选择函数
    
    # 读取旧路径
    old_cert_path=$(grep -oP 'cert: \K\S+' /etc/hysteria/config.yaml)
    old_key_path=$(grep -oP 'key: \K\S+' /etc/hysteria/config.yaml)

    # 替换新路径
    sed -i "s|cert: $old_cert_path|cert: $cert_path|" /etc/hysteria/config.yaml
    sed -i "s|key: $old_key_path|key: $key_path|" /etc/hysteria/config.yaml
    
    regenerate_client_configs_after_change
}

changeconf(){
    green "Hysteria 2 配置变更选择如下:"
    echo -e " ${GREEN}1.${PLAIN} 修改端口"
    echo -e " ${GREEN}2.${PLAIN} 修改连接密码"
    echo -e " ${GREEN}3.${PLAIN} 修改混淆密码 (obfs)"
    echo -e " ${GREEN}4.${PLAIN} 修改证书"
    echo ""
    read -p " 请选择操作 [1-4]：" confAnswer
    case $confAnswer in
        1 ) changeport ;;
        2 ) changepasswd ;;
        3 ) changeobfs ;;
        4 ) change_cert ;;
        * ) exit 1 ;;
    esac
}

showconf(){
    yellow "Hysteria 2 客户端 YAML 配置文件内容如下 (路径: /root/hy/hy-client.yaml):"
    red "$(cat /root/hy/hy-client.yaml)"
    yellow "Hysteria 2 客户端 JSON 配置文件内容如下 (路径: /root/hy/hy-client.json):"
    red "$(cat /root/hy/hy-client.json)"
    yellow "Clash Meta 客户端配置文件已保存到 /root/hy/clash-meta.yaml"
    yellow "Hysteria 2 节点分享链接如下 (路径: /root/hy/url.txt):"
    red "$(cat /root/hy/url.txt)"
}

update_core(){
    wget -N https://raw.githubusercontent.com/Misaka-blog/hysteria-install/main/hy2/install_server.sh
    bash install_server.sh
    rm -f install_server.sh
    restarthysteria
}

menu() {
    clear
    echo "#############################################################"
    echo -e "#                  ${RED}Hysteria 2 一键安装脚本 (精简优化版)${PLAIN}             #"
    echo "#############################################################"
    echo ""
    echo -e " ${GREEN}1.${PLAIN} 安装 Hysteria 2"
    echo -e " ${GREEN}2.${PLAIN} ${RED}卸载 Hysteria 2${PLAIN}"
    echo " -------------"
    echo -e " ${GREEN}3.${PLAIN} 管理 Hysteria 2 (启动/停止/重启)"
    echo -e " ${GREEN}4.${PLAIN} 修改 Hysteria 2 配置"
    echo -e " ${GREEN}5.${PLAIN} 显示客户端配置文件/链接"
    echo " -------------"
    echo -e " ${GREEN}6.${PLAIN} 更新 Hysteria 2 核心"
    echo " -------------"
    echo -e " ${GREEN}0.${PLAIN} 退出脚本"
    echo ""
    read -rp "请输入选项 [0-6]: " menuInput
    case $menuInput in
        1 ) insthysteria ;;
        2 ) unsthysteria ;;
        3 ) hysteriaswitch ;;
        4 ) changeconf ;;
        5 ) showconf ;;
        6 ) update_core ;;
        * ) exit 1 ;;
    esac
}

menu
