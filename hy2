#!/bin/bash

# =========================================================
#  Hysteria 2 终极兼容版 (v2.4 - Misaka Inside)
#  Fix: 借鉴 Misaka 脚本的证书/密码生成逻辑，解决 RackNerd 兼容性问题
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/usr/local/bin"
CONFIG_DIR="/etc/hysteria"
CONFIG_FILE="${CONFIG_DIR}/config.yaml"
CERT_FILE="${CONFIG_DIR}/cert.pem" # 统一用 pem 后缀
KEY_FILE="${CONFIG_DIR}/private.key"
SERVICE_FILE="/etc/systemd/system/hysteria-server.service"
INFO_FILE="${CONFIG_DIR}/.hy2_info"

# 伪装域名
SNI_DOMAIN="cdn.jsdelivr.net"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- 变量 ---
PORT=""
PASSWORD=""
OBFS_PASS=""

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "必须使用 root 权限运行此脚本。"
        exit 1
    fi
}

# --- 保存/加载配置信息 ---
save_info() {
    mkdir -p "$CONFIG_DIR"
    cat > "$INFO_FILE" <<EOF
PORT="${PORT}"
PASSWORD="${PASSWORD}"
OBFS_PASS="${OBFS_PASS}"
SNI_DOMAIN="${SNI_DOMAIN}"
EOF
}
load_info() {
    if [ -f "$INFO_FILE" ]; then source "$INFO_FILE"; return 0; else return 1; fi
}

# --- 1. 清理环境 ---
cleanup_old() {
    info "清理旧版进程与文件..."
    if systemctl is-active --quiet hysteria-server; then
        systemctl stop hysteria-server
        systemctl disable hysteria-server >/dev/null 2>&1
    fi
    rm -f "$INSTALL_DIR/hysteria"
}

# --- 2. 安装内核 ---
install_core() {
    info "安装依赖..."
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl wget openssl >/dev/null 2>&1

    info "下载 Hysteria 2 最新内核..."
    local ARCH=$(uname -m)
    local URL=""
    case "$ARCH" in
        x86_64) URL="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-amd64" ;;
        aarch64) URL="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-arm64" ;;
        *) error "不支持的架构: $ARCH"; exit 1 ;;
    esac

    curl -L -o "$INSTALL_DIR/hysteria" "$URL" || wget -O "$INSTALL_DIR/hysteria" "$URL"
    if [ ! -f "$INSTALL_DIR/hysteria" ]; then error "内核下载失败"; exit 1; fi
    chmod +x "$INSTALL_DIR/hysteria"
    
    local VER=$("$INSTALL_DIR/hysteria" version | awk '{print $3}')
    info "内核版本: $VER"
}

# --- 3. 生成凭证 (借鉴 Misaka 兼容性逻辑) ---
generate_creds() {
    mkdir -p "$CONFIG_DIR"
    
    info "生成自签名证书 (兼容模式)..."
    # [核心修复] 采用 Misaka 脚本的两步生成法，兼容性最高
    openssl ecparam -genkey -name prime256v1 -out "$KEY_FILE"
    openssl req -new -x509 -days 36500 -key "$KEY_FILE" -out "$CERT_FILE" -subj "/CN=$SNI_DOMAIN"
    
    info "生成随机密码 (兼容模式)..."
    PORT=$(shuf -i 30000-55000 -n 1)
    
    # [核心修复] 采用 Misaka 脚本的时间戳MD5法，绝对不会为空
    PASSWORD=$(date +%s%N | md5sum | head -c 16)
    OBFS_PASS=$(date +%s%N | md5sum | head -c 24)
}

# --- 4. 生成配置文件 ---
create_config() {
    info "写入终极配置文件..."
    cat > "$CONFIG_FILE" <<EOF
listen: :$PORT

resolver:
  type: udp
  udp:
    addr: 1.1.1.1:53
    timeout: 4s

tls:
  cert: $CERT_FILE
  key: $KEY_FILE

quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  disablePathMTUDiscovery: true
  keepAlivePeriod: 10s
  maxIdleTimeout: 60s

udpIdleTimeout: 60s

auth:
  type: password
  password: "$PASSWORD"

obfs:
  type: salamander
  password: "$OBFS_PASS"

masquerade:
  type: proxy
  proxy:
    url: https://$SNI_DOMAIN
    rewriteHost: true
EOF
}

# --- 5. 系统服务 ---
create_service() {
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Hysteria 2 Server
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=$CONFIG_DIR
ExecStart=$INSTALL_DIR/hysteria server -c $CONFIG_FILE
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable hysteria-server >/dev/null 2>&1
    systemctl restart hysteria-server
    
    save_info
    
    sleep 2
    if systemctl is-active --quiet hysteria-server; then
        success "Hysteria 2 服务启动成功！"
    else
        error "服务启动失败，请检查日志: journalctl -u hysteria-server -n 20"
        exit 1
    fi
}

# --- 6. 安装流程 ---
install_node() {
    cleanup_old
    install_core
    generate_creds
    create_config
    create_service
    show_info
}

# --- 7. 显示节点信息 ---
show_info() {
    if ! load_info; then error "未找到配置信息，请先安装。"; return; fi

    local IPV4=$(curl -s4m5 https://icanhazip.com -k || curl -s4m5 ip.sb -k)
    local IPV6=$(curl -s6m5 https://icanhazip.com -k || curl -s6m5 ip.sb -k)
    
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} Hysteria 2 终极兼容版 (已启动)${NC}"
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e " 端口 (Port): ${YELLOW}${PORT}${NC}"
    echo -e " 认证密码: ${YELLOW}${PASSWORD}${NC}"
    echo -e " 混淆密码: ${YELLOW}${OBFS_PASS}${NC}"
    echo -e " 伪装域名: ${SNI_DOMAIN}"
    echo -e "----------------------------------------------------"
    
    local LINK_BASE="hy2://${PASSWORD}@"
    local LINK_PARAMS=":${PORT}?sni=${SNI_DOMAIN}&insecure=1&obfs=salamander&obfs-password=${OBFS_PASS}"
    
    if [ -n "$IPV4" ]; then
        echo -e "${YELLOW}[IPv4 链接]:${NC}"
        echo -e "${LINK_BASE}${IPV4}${LINK_PARAMS}#Hy2-Ult-v4"
        echo
    fi
    
    if [ -n "$IPV6" ]; then
        echo -e "${YELLOW}[IPv6 链接]:${NC}"
        echo -e "${LINK_BASE}[${IPV6}]${LINK_PARAMS}#Hy2-Ult-v6"
        echo
    fi
    
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${RED}[最后一步 - 防火墙放行]${NC}"
    echo -e "请务必手动执行以下命令："
    echo -e "${GREEN}ufw allow ${PORT}/udp${NC}"
    echo -e "${MAGENTA}====================================================${NC}"
}

# --- 8. 卸载 ---
uninstall_node() {
    read -p "确定要卸载 Hysteria 2 吗? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        info "正在停止服务..."
        systemctl stop hysteria-server
        systemctl disable hysteria-server >/dev/null 2>&1
        rm -f "$SERVICE_FILE"
        systemctl daemon-reload
        
        info "正在删除文件..."
        rm -rf "$INSTALL_DIR/hysteria"
        rm -rf "$CONFIG_DIR"
        
        success "卸载完成。"
    else
        info "已取消。"
    fi
}

# --- 菜单 ---
show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}   Hysteria 2 终极管理脚本 (兼容版)   ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装 / 重置节点"
    echo -e "2. 查看节点链接"
    echo -e "3. 重启服务"
    echo -e "4. 卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    
    if systemctl is-active --quiet hysteria-server; then
        echo -e "当前状态: ${GREEN}运行中${NC}"
    else
        echo -e "当前状态: ${RED}未运行${NC}"
    fi
    echo -e "------------------------------------------------"
    
    read -p "请选择 [0-4]: " choice
    case "$choice" in
        1) install_node ;;
        2) show_info ;;
        3) 
           systemctl restart hysteria-server
           if systemctl is-active --quiet hysteria-server; then
               success "服务已重启"
           else
               error "重启失败"
           fi
           ;;
        4) uninstall_node ;;
        0) exit 0 ;;
        *) echo "无效输入" ;;
    esac
    read -p "按回车键继续..."
}

# --- 主逻辑 ---
check_root
while true; do show_menu; done
