#!/bin/bash

# =========================================================
#  Hysteria 2 双进程物理隔离版 (Pro V22 - 终极完美版)
#  基于最新 hy2 协议重构，支持 pinSHA256 & 修复 v2.9.0 Bug
#  特性:
#    1. IPv4/IPv6 完全双栈隔离，分别使用独立的随机端口
#    2. 修复: IPv6 节点专属 IPv6 DNS解析，告别 4 秒超时卡顿
#    3. 修复: 增加 IP 正则清洗，防止 HTML 代码注入配置文件
#    4. 新增: 官方 hysteria cert 生成并强制设定 sniGuard: disable
# =========================================================

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 核心路径 ---
BIN_PATH="/usr/local/bin/hysteria"
CONFIG_DIR="/etc/hysteria"
CONFIG_V4="${CONFIG_DIR}/config_v4.yaml"
CONFIG_V6="${CONFIG_DIR}/config_v6.yaml"
CERT_FILE="${CONFIG_DIR}/server.crt"
KEY_FILE="${CONFIG_DIR}/server.key"
FALLBACK_DIR="${CONFIG_DIR}/fallback"

SERVICE_V4="/etc/systemd/system/hysteria-v4.service"
SERVICE_V6="/etc/systemd/system/hysteria-v6.service"

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }

check_root() { if [ "$(id -u)" -ne 0 ]; then error "请使用 root 权限运行此脚本"; exit 1; fi; }

# --- 1. 环境清理 ---
cleanup_environment() {
    local mode=$1
    if [ "$mode" == "uninstall" ]; then info "正在清理环境..."; fi
    
    # 停止旧服务
    systemctl stop hysteria-server hysteria-v4 hysteria-v6 >/dev/null 2>&1
    systemctl disable hysteria-server hysteria-v4 hysteria-v6 >/dev/null 2>&1
    rm -f /etc/systemd/system/hysteria-server.service "$SERVICE_V4" "$SERVICE_V6"
    systemctl daemon-reload

    if [ "$mode" == "uninstall" ]; then
        rm -f "$BIN_PATH"
        rm -rf "$CONFIG_DIR"
        if id "hysteria" &>/dev/null; then userdel "hysteria" >/dev/null 2>&1; fi
        success "Hysteria 2 已彻底卸载。"
        exit 0
    fi
}

# --- 2. 依赖安装 ---
install_dependencies() {
    info "安装必要依赖..."; local deps=("curl" "openssl" "wget" "iproute2")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            if [ -f /etc/debian_version ]; then apt-get update -y && apt-get install -y "$dep";
            elif [ -f /etc/redhat-release ]; then yum install -y "$dep"; fi
        fi
    done
}

# --- 3. 获取内核 ---
install_kernel() {
    if [ -f "$BIN_PATH" ]; then info "内核已存在，跳过下载"; return; fi
    info "下载 Hysteria 2 官方内核..."; local ARCH=$(uname -m)
    case "$ARCH" in x86_64) ARCH="amd64" ;; aarch64) ARCH="arm64" ;; *) error "不支持的架构: $ARCH"; exit 1 ;; esac
    
    local LATEST_VER=$(curl -s https://api.github.com/repos/apernet/hysteria/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
    if [ -z "$LATEST_VER" ]; then LATEST_VER="v2.7.0"; fi # 保底
    info "版本: $LATEST_VER"
    
    local URL="https://github.com/apernet/hysteria/releases/download/${LATEST_VER}/hysteria-linux-${ARCH}"
    curl -L -o "$BIN_PATH" "$URL" --retry 3
    
    if [ ! -f "$BIN_PATH" ]; then error "下载失败！"; exit 1; fi; chmod +x "$BIN_PATH"; success "内核安装完成。"
}

# --- 4. 证书与伪装 ---
generate_cert() {
    mkdir -p "$CONFIG_DIR" "$FALLBACK_DIR"
    
    # 伪装文件
    if [ ! -f "$FALLBACK_DIR/index.html" ]; then
        info "生成防探测伪装页面..."
        cat > "$FALLBACK_DIR/index.html" <<EOF
<html><head><title>404 Not Found</title></head><body><center><h1>404 Not Found</h1></center><hr><center>nginx</center></body></html>
EOF
    fi

    # 证书
    if [ ! -f "$CERT_FILE" ]; then
        info "使用 hysteria 原生命令生成证书..."
        cd "$CONFIG_DIR" || exit 1
        
        # 运行自带生成指令并捕获日志以提取 pinSHA256
        "$BIN_PATH" cert > "$CONFIG_DIR/cert_info.log" 2>&1
        
        chmod 644 "$CERT_FILE"
        chmod 600 "$KEY_FILE"
        
        # 从日志提取原生 pinSHA256
        PINSHA256=$(grep -oE 'pinSHA256:[[:space:]]*[A-Za-z0-9+/=]+' "$CONFIG_DIR/cert_info.log" | head -n1 | sed 's/pinSHA256:[[:space:]]*//')
        
        if [ -n "$PINSHA256" ]; then
            echo "$PINSHA256" > "$CONFIG_DIR/pinsha256.txt"
            success "自签名证书生成完成，提取 pinSHA256 成功"
        else
            warn "未能从日志提取，将通过 openssl 重新计算 pinSHA256..."
            PINSHA256=$(openssl x509 -in "$CERT_FILE" -outform der 2>/dev/null | openssl dgst -sha256 -binary 2>/dev/null | base64)
            echo "$PINSHA256" > "$CONFIG_DIR/pinsha256.txt"
            success "自签名证书生成完成，计算 pinSHA256 成功"
        fi
    fi
}

# --- 5. 生成配置文件 ---
create_config() {
    info "正在获取并校验 IP 地址..."
    
    IPV4=$(curl -s4m5 https://ip.sb -k | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1)
    if [ -z "$IPV4" ]; then IPV4=$(curl -s4m5 https://ifconfig.me -k | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1); fi

    IPV6=$(curl -s6m5 https://ip.sb -k | grep -Eo '([a-f0-9:]+:+)+[a-f0-9]+' | head -n1)
    if [ -z "$IPV6" ]; then IPV6=$(curl -s6m5 https://ifconfig.me -k | grep -Eo '([a-f0-9:]+:+)+[a-f0-9]+' | head -n1); fi

    if [ -z "$IPV4" ] && [ -z "$IPV6" ]; then error "无法获取公网 IP"; exit 1; fi

    echo -e "  IPv4: ${GREEN}${IPV4:-无}${NC}"
    echo -e "  IPv6: ${GREEN}${IPV6:-无}${NC}"

    # 生成双端口，并确保端口不重复
    PORT_V4=$(shuf -i 10000-65534 -n 1)
    PORT_V6=$(shuf -i 10000-65534 -n 1)
    while [ "$PORT_V4" = "$PORT_V6" ]; do
        PORT_V6=$(shuf -i 10000-65534 -n 1)
    done

    AUTH_PASS=$(head /dev/urandom | tr -dc 'a-zA-Z0-9' | head -c 32)
    # 生成混淆密码
    OBFS_PASS=$(openssl rand -hex 16)

    # === IPv4 配置 ===
    if [ -n "$IPV4" ]; then
        info "生成 IPv4 配置..."
cat > "$CONFIG_V4" <<EOF
listen: "$IPV4:$PORT_V4"
tls:
  cert: $CERT_FILE
  key: $KEY_FILE
  sniGuard: disable
auth:
  type: password
  password: $AUTH_PASS
obfs:
  type: salamander
  salamander:
    password: "$OBFS_PASS"
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  disablePathMTUDiscovery: false
ignoreClientBandwidth: true
masquerade:
  type: file
  file:
    dir: $FALLBACK_DIR
EOF
    fi

    # === IPv6 配置 (已修复纯IPv6 DNS问题) ===
    if [ -n "$IPV6" ]; then
        info "生成 IPv6 配置..."
cat > "$CONFIG_V6" <<EOF
listen: "[$IPV6]:$PORT_V6"
tls:
  cert: $CERT_FILE
  key: $KEY_FILE
  sniGuard: disable
auth:
  type: password
  password: $AUTH_PASS
obfs:
  type: salamander
  salamander:
    password: "$OBFS_PASS"
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  disablePathMTUDiscovery: false
ignoreClientBandwidth: true
masquerade:
  type: file
  file:
    dir: $FALLBACK_DIR
EOF
    fi
}

# --- 6. 启动双服务 ---
start_service() {
    info "配置 Systemd 服务..."
    
    # V4 Service
    if [ -f "$CONFIG_V4" ]; then
        cat > "$SERVICE_V4" <<EOF
[Unit]
Description=Hysteria V4 Service
After=network.target
[Service]
Type=simple
ExecStart=$BIN_PATH server --config $CONFIG_V4 --log-level error
WorkingDirectory=$CONFIG_DIR
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
        systemctl enable hysteria-v4 >/dev/null 2>&1
        systemctl restart hysteria-v4
    fi

    # V6 Service
    if [ -f "$CONFIG_V6" ]; then
        cat > "$SERVICE_V6" <<EOF
[Unit]
Description=Hysteria V6 Service
After=network.target
[Service]
Type=simple
ExecStart=$BIN_PATH server --config $CONFIG_V6 --log-level error
WorkingDirectory=$CONFIG_DIR
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
        systemctl enable hysteria-v6 >/dev/null 2>&1
        systemctl restart hysteria-v6
    fi

    systemctl daemon-reload
    sleep 2
    
    local v4_ok=false; local v6_ok=false
    if [ -f "$CONFIG_V4" ] && systemctl is-active --quiet hysteria-v4; then v4_ok=true; fi
    if [ -f "$CONFIG_V6" ] && systemctl is-active --quiet hysteria-v6; then v6_ok=true; fi
    
    if [ "$v4_ok" = true ] || [ "$v6_ok" = true ]; then
        success "Hysteria 2 双进程启动成功！"
    else
        error "启动失败！日志如下:"
        [ -f "$CONFIG_V4" ] && journalctl -u hysteria-v4 --no-pager -n 5
        [ -f "$CONFIG_V6" ] && journalctl -u hysteria-v6 --no-pager -n 5
    fi
}

# --- 7. 输出信息 ---
show_info() {
    PORT_V4=""
    PORT_V6=""
    [ -f "$CONFIG_V4" ] && PORT_V4=$(grep "listen:" "$CONFIG_V4" | awk -F ':' '{print $NF}' | tr -d '" ')
    [ -f "$CONFIG_V6" ] && PORT_V6=$(grep "listen:" "$CONFIG_V6" | awk -F ':' '{print $NF}' | tr -d '" ')
    
    [ -f "$CONFIG_V4" ] && PASS=$(grep -A 2 "auth:" $CONFIG_V4 | grep "password:" | awk '{print $2}')
    [ -f "$CONFIG_V6" ] && [ -z "$PASS" ] && PASS=$(grep -A 2 "auth:" $CONFIG_V6 | grep "password:" | awk '{print $2}')

    [ -f "$CONFIG_V4" ] && OBFS=$(grep -A 5 "obfs:" $CONFIG_V4 | grep "password:" | awk '{print $2}' | tr -d '"')
    if [ -z "$OBFS" ] && [ -f "$CONFIG_V6" ]; then
        OBFS=$(grep -A 5 "obfs:" $CONFIG_V6 | grep "password:" | awk '{print $2}' | tr -d '"')
    fi

    [ -f "$CONFIG_V4" ] && IPV4=$(grep "listen:" $CONFIG_V4 | cut -d'"' -f2 | cut -d':' -f1)
    [ -f "$CONFIG_V6" ] && IPV6=$(grep "listen:" $CONFIG_V6 | cut -d'"' -f2 | sed 's/^\[//;s/\]:.*//')
    
    PINSHA=""
    if [ -f "$CONFIG_DIR/pinsha256.txt" ]; then
        PINSHA=$(cat "$CONFIG_DIR/pinsha256.txt")
    elif [ -f "$CERT_FILE" ]; then
        PINSHA=$(openssl x509 -in "$CERT_FILE" -outform der 2>/dev/null | openssl dgst -sha256 -binary 2>/dev/null | base64)
    fi

    URL_PINSHA=$(echo -n "$PINSHA" | sed 's/+/%2B/g; s/\//%2F/g; s/=/%3D/g')

    echo -e "${YELLOW}===============================================${NC}"
    echo -e "${GREEN}      Hysteria 2 双栈隔离版 (运行信息)      ${NC}"
    echo -e "${YELLOW}===============================================${NC}"
    [ -n "$PORT_V4" ] && echo -e "IPv4 端口  : ${CYAN}${PORT_V4}${NC}"
    [ -n "$PORT_V6" ] && echo -e "IPv6 端口  : ${CYAN}${PORT_V6}${NC}"
    echo -e "认证密码   : ${CYAN}${PASS}${NC}"
    echo -e "混淆密码   : ${CYAN}${OBFS}${NC} (Salamander)"
    echo -e "pinSHA256  : ${CYAN}${PINSHA}${NC}"
    echo -e "伪装验证   : ${CYAN}由 pin 特征码校验 (不再依赖 SNI)${NC}"
    echo -e "伪装模式   : ${CYAN}本地文件 (404 伪装)${NC}"
    echo -e "${YELLOW}-----------------------------------------------${NC}"

    LINK_BASE="hysteria2://$PASS@"

    if [ -n "$IPV4" ] && [ -n "$PORT_V4" ]; then
        LINK_PARAMS_V4=":$PORT_V4?insecure=0&pinSHA256=${URL_PINSHA}&alpn=h3&obfs=salamander&obfs-password=$OBFS"
        echo -e "节点 1 [IPv4]:"
        echo -e "${CYAN}${LINK_BASE}${IPV4}${LINK_PARAMS_V4}#Hy2-IPv4${NC}"
        echo
    fi

    if [ -n "$IPV6" ] && [ -n "$PORT_V6" ]; then
        LINK_PARAMS_V6=":$PORT_V6?insecure=0&pinSHA256=${URL_PINSHA}&alpn=h3&obfs=salamander&obfs-password=$OBFS"
        echo -e "节点 2 [IPv6]:"
        echo -e "${CYAN}${LINK_BASE}[${IPV6}]${LINK_PARAMS_V6}#Hy2-IPv6${NC}"
        echo
    fi
    echo -e "${YELLOW}===============================================${NC}"
}

# --- 菜单 ---
install() { cleanup_environment install; install_dependencies; install_kernel; generate_cert; create_config; start_service; show_info; }

change_port() {
    if [ ! -f "$CONFIG_V4" ] && [ ! -f "$CONFIG_V6" ]; then error "未安装"; return; fi
    
    if [ -f "$CONFIG_V4" ]; then
        NEW_PORT_V4=$(shuf -i 10000-65534 -n 1)
        sed -i -E "s/listen: \"(.*):[0-9]+\"/listen: \"\1:$NEW_PORT_V4\"/" $CONFIG_V4
        systemctl restart hysteria-v4
        success "IPv4 端口已修改为: $NEW_PORT_V4"
    fi
    if [ -f "$CONFIG_V6" ]; then
        NEW_PORT_V6=$(shuf -i 10000-65534 -n 1)
        sed -i -E "s/listen: \"(.*):[0-9]+\"/listen: \"\1:$NEW_PORT_V6\"/" $CONFIG_V6
        systemctl restart hysteria-v6
        success "IPv6 端口已修改为: $NEW_PORT_V6"
    fi
    show_info
}

show_menu() {
    clear; echo -e "${BLUE}=======================================${NC}"; echo -e "   Hysteria 2 双进程管理 (Pro V22)"; echo -e "${BLUE}=======================================${NC}"
    echo -e "1. 安装 / 重置 (双栈物理隔离 + 独立双端口)"; echo "2. 查看 配置 & 链接"; echo "3. 修改 端口 (随机换新)"; echo "4. 重启 服务"; echo "5. 彻底卸载"; echo "0. 退出"
    echo -e "---------------------------------------"; read -p "请选择: " c
    case "$c" in
        1) install ;;
        2) if [ -f "$CONFIG_V4" ] || [ -f "$CONFIG_V6" ]; then show_info; else error "未安装"; fi ;;
        3) change_port ;;
        4) systemctl restart hysteria-v4 hysteria-v6 && success "已重启" ;;
        5) cleanup_environment uninstall ;;
        0) exit 0 ;;
        *) error "无效输入" ;;
    esac
    echo; read -p "按回车键返回菜单..."; show_menu
}

check_root
show_menu
