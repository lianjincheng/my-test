#!/bin/bash

INSTALL_DIR="/usr/local/bin"
CONFIG_DIR="/etc/hysteria"
CONFIG_FILE="${CONFIG_DIR}/config.yaml"
CERT_FILE="${CONFIG_DIR}/hy2_server.crt"
KEY_FILE="${CONFIG_DIR}/hy2_server.key"
SERVICE_FILE="/etc/systemd/system/hysteria-server.service"
INFO_FILE="${CONFIG_DIR}/.hy2_info"
SNI_DOMAIN="cdn.jsdelivr.net"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info(){ echo -e "${GREEN}[INFO]${NC} $1"; }
error(){ echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

check_root(){ [[ $EUID -ne 0 ]] && error "必须使用root运行"; }

save_info(){
cat > "$INFO_FILE" <<EOF
PORT="$PORT"
PASSWORD="$PASSWORD"
OBFS_PASS="$OBFS_PASS"
SNI_DOMAIN="$SNI_DOMAIN"
EOF
}

load_info(){ [[ -f "$INFO_FILE" ]] && source "$INFO_FILE"; }

install_core(){
    mkdir -p "$CONFIG_DIR"
    apt update -y >/dev/null 2>&1
    apt install -y curl wget openssl >/dev/null 2>&1

    ARCH=$(uname -m)
    [[ "$ARCH" = "x86_64" ]] && URL="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-amd64"
    [[ "$ARCH" = "aarch64" ]] && URL="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-arm64"
    [[ -z "$URL" ]] && error "不支持架构: $ARCH"

    info "下载 Hysteria2 内核..."
    curl -L -o "$INSTALL_DIR/hysteria" "$URL" || wget -O "$INSTALL_DIR/hysteria" "$URL"
    [[ ! -f "$INSTALL_DIR/hysteria" ]] && error "下载失败"
    chmod +x "$INSTALL_DIR/hysteria"
}

generate_creds(){
    PORT=$(shuf -i 30000-55000 -n 1)
    PASSWORD=$(openssl rand -hex 16)
    OBFS_PASS=$(openssl rand -hex 16)

    info "生成证书..."
    openssl req -new -x509 -days 36500 -nodes \
      -subj "/CN=$SNI_DOMAIN" \
      -keyout "$KEY_FILE" \
      -out "$CERT_FILE" >/dev/null 2>&1
}

create_config(){
cat > "$CONFIG_FILE" <<EOF
listen: 0.0.0.0:$PORT

tls:
  cert: $CERT_FILE
  key: $KEY_FILE

# QUIC 性能增强参数
quic:
  initStreamReceiveWindow: 16777216
  maxStreamReceiveWindow: 16777216
  initConnReceiveWindow: 33554432
  maxConnReceiveWindow: 33554432
  disablePathMTUDiscovery: true
  keepAlivePeriod: 10s
  maxIdleTimeout: 60s

udpIdleTimeout: 60s

auth:
  type: password
  password: $PASSWORD

obfs:
  type: salamander
  password: $OBFS_PASS

masquerade:
  type: proxy
  proxy:
    url: https://$SNI_DOMAIN
    rewriteHost: true
EOF
}

create_service(){
cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Hysteria2 Server
After=network.target

[Service]
WorkingDirectory=$CONFIG_DIR
ExecStart=$INSTALL_DIR/hysteria server -c $CONFIG_FILE
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable hysteria-server
    systemctl restart hysteria-server
}

show_info(){
    load_info
    IP=$(curl -s4m3 ifconfig.me)
    [[ -z "$IP" ]] && IP=$(curl -s4m3 ip.sb)

    echo
    echo -e "${YELLOW}=== Hysteria2 节点信息 (IPv4 Only) ===${NC}"
    echo "地址: $IP"
    echo "端口: $PORT"
    echo "密码: $PASSWORD"
    echo "混淆: $OBFS_PASS"
    echo "伪装域: $SNI_DOMAIN"
    echo
    echo -e "${GREEN}连接链接:${NC}"
    echo "hy2://${PASSWORD}@${IP}:${PORT}?sni=${SNI_DOMAIN}&insecure=1&obfs=salamander&obfs-password=${OBFS_PASS}#Hy2"
    echo
}

install(){
    install_core
    generate_creds
    create_config
    save_info
    create_service

    sleep 2
    if systemctl is-active --quiet hysteria-server; then
        info "安装成功 ✓"
        ufw allow ${PORT}/udp >/dev/null 2>&1
        show_info
    else
        error "启动失败，请执行：journalctl -u hysteria-server -n 30 --no-pager"
    fi
}

check_root
install
