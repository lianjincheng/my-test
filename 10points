#!/usr/bin/env bash
# ============================================================
#  Sing-Box-Plus 管理脚本 (v5.0 Nuclear Fix)
#  修复日志：
#   - [架构] 弃用 $(func) 子 Shell 调用，改用全局变量传参，彻底根除 exit code 1
#   - [稳定] 在端口生成阶段临时关闭 set -e，防止系统误杀
#   - [兼容] 针对 RackNerd/精简系统做了极致的容错处理
# ============================================================
set -Eeuo pipefail

# ===== [0] 错误处理机制 =====
handle_error() {
    local exit_code=$?
    local error_line=$1
    local error_cmd="$2"
    
    # 忽略常见的非致命错误
    if [[ $exit_code -eq 1 ]] && [[ "$error_cmd" == *"grep"* ]]; then return 0; fi

    echo -e "\n${C_RED}=== 错误报告 ===${C_RESET}"
    echo -e "错误代码: $exit_code"
    echo -e "出错行号: $error_line"
    echo -e "出错命令: $error_cmd"
    exit $exit_code
}
trap 'handle_error $LINENO "$BASH_COMMAND"' ERR

# ===== [1] 全局变量 =====
SB_DIR="/opt/sing-box"
BIN_PATH="/usr/local/bin/sing-box"
CONF_JSON="$SB_DIR/config.json"
DATA_DIR="$SB_DIR/data"
CERT_DIR="$SB_DIR/cert"
SYSTEMD_SERVICE="sing-box.service"
SB_VERSION="1.10.7"

# 颜色
C_RESET="\033[0m"
C_RED="\033[31m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_CYAN="\033[36m"
C_PURPLE="\033[35m"

# 全局配置
ENABLE_WARP=${ENABLE_WARP:-true}
REALITY_SERVER=${REALITY_SERVER:-www.microsoft.com}
REALITY_SERVER_PORT=${REALITY_SERVER_PORT:-443}
export ENABLE_DEPRECATED_WIREGUARD_OUTBOUND=true

# 用于接收生成端口的全局变量 (核心修复)
RET_PORT=0

# ===== [2] 基础函数 =====
info(){ echo -e "[${C_CYAN}INFO${C_RESET}] $*"; }
warn(){ echo -e "[${C_YELLOW}WARN${C_RESET}] $*"; }
die(){ echo -e "[${C_RED}ERROR${C_RESET}] $*" >&2; exit 1; }
success(){ echo -e "[${C_GREEN}SUCCESS${C_RESET}] $*"; }

check_root(){ [[ $EUID -ne 0 ]] && die "请以 root 用户运行 (sudo -i)"; }
arch_map() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *) echo "amd64" ;;
  esac
}

# ===== [3] 依赖安装 =====
install_base_deps(){
  local pkgs=(curl wget jq tar openssl coreutils iproute2 net-tools wireguard-tools iptables)
  if ! command -v uuidgen >/dev/null 2>&1; then pkgs+=(uuid-runtime); fi
  
  # 简单检测是否需要安装
  local need_install=false
  for p in "${pkgs[@]}"; do
    if ! command -v "$p" >/dev/null 2>&1 && ! dpkg -s "$p" >/dev/null 2>&1; then need_install=true; break; fi
  done

  if [ "$need_install" = true ]; then
    info "安装依赖..."
    if command -v apt-get >/dev/null 2>&1; then
      apt-get update -y >/dev/null 2>&1
      apt-get install -y "${pkgs[@]}" || true
    elif command -v yum >/dev/null 2>&1; then
      yum install -y epel-release
      yum install -y "${pkgs[@]}" util-linux || true
    elif command -v apk >/dev/null 2>&1; then
      apk add --no-cache "${pkgs[@]}" util-linux || true
    fi
  fi
}

# ===== [4] 端口管理 (核弹级修复) =====
PORTS=()

# 判断端口是否被占用 (返回 0=占用, 1=空闲)
check_port_occupied() {
    local port=$1
    local ret=1
    
    # 临时关闭管道失败报错
    set +o pipefail
    
    if command -v ss >/dev/null 2>&1; then
        if ss -tulpn 2>/dev/null | grep -q ":${port}\b"; then ret=0; fi
    elif command -v netstat >/dev/null 2>&1; then
        if netstat -tulpn 2>/dev/null | grep -q ":${port}\b"; then ret=0; fi
    fi
    
    # 恢复管道报错
    set -o pipefail
    return $ret
}

# 检查 443 占用
check_443() {
    # 临时关闭 set -e
    set +e
    check_port_occupied 443
    local occupied=$?
    set -e
    
    if [ $occupied -eq 0 ]; then
        # 尝试找出是谁
        local proc=""
        if command -v ss >/dev/null 2>&1; then proc=$(ss -tulpn | grep ":443\b" || true); fi
        
        if [[ "$proc" == *"sing-box"* ]]; then
            return 0
        else
            die "端口 443 被占用！请停止 Nginx/Apache。\n详情: $proc"
        fi
    fi
}

# 生成随机端口并赋值给全局变量 RET_PORT
calc_random_port() {
    # 临时关闭 set -e，这是最安全的方式
    set +e
    
    local p
    local valid=0
    local try=0
    
    while [ $try -lt 100 ]; do
        ((try++))
        p=$(( (RANDOM * 32768 + RANDOM) % 55536 + 10000 ))
        
        # 范围检查
        if [ $p -lt 10000 ] || [ $p -gt 65535 ]; then continue; fi
        
        # 脚本内重复检查
        local is_dup=0
        for exist in "${PORTS[@]}"; do
            if [ "$exist" == "$p" ]; then is_dup=1; break; fi
        done
        if [ $is_dup -eq 1 ]; then continue; fi
        
        # 系统占用检查
        check_port_occupied "$p"
        if [ $? -eq 1 ]; then
            # 1=空闲，可以使用
            RET_PORT=$p
            valid=1
            break
        fi
    done
    
    set -e
    
    if [ $valid -eq 0 ]; then
        die "无法找到空闲端口！"
    fi
    
    PORTS+=("$RET_PORT")
}

PORT_VARS=(
  PORT_VLESSR PORT_TROJANR PORT_HY2 PORT_HY2_OBFS PORT_TUIC
  PORT_VLESSR_W PORT_TROJANR_W PORT_HY2_W PORT_HY2_OBFS_W PORT_TUIC_W
)
for v in "${PORT_VARS[@]}"; do eval "$v=\"\""; done

save_ports(){
  mkdir -p "$SB_DIR"
  echo "# Generated Ports" > "$SB_DIR/ports.env"
  for v in "${PORT_VARS[@]}"; do echo "${v}=${!v}" >> "$SB_DIR/ports.env"; done
}
load_ports(){ [[ -f "$SB_DIR/ports.env" ]] && source "$SB_DIR/ports.env" || true; }

plan_ports(){
  PORTS=()
  info "正在规划端口..."
  
  check_443
  PORT_VLESSR=443
  PORTS+=("443")
  
  for v in "${PORT_VARS[@]}"; do
    [[ "$v" == "PORT_VLESSR" ]] && continue
    
    # 如果已有值，检查是否可用
    if [[ -n "${!v:-}" ]]; then
       set +e
       check_port_occupied "${!v}"
       local st=$?
       set -e
       if [ $st -eq 0 ]; then
           warn "端口 ${!v} 被占用，重新生成..."
           calc_random_port
           eval "$v=$RET_PORT"
       else
           PORTS+=("${!v}")
       fi
    else
       calc_random_port
       eval "$v=$RET_PORT"
    fi
  done
  save_ports
}

# ===== [5] 凭证与配置 =====
save_env(){
  mkdir -p "$SB_DIR"
  echo "BIN_PATH=$BIN_PATH" > "$SB_DIR/env.conf"
  echo "ENABLE_WARP=$ENABLE_WARP" >> "$SB_DIR/env.conf"
  echo "REALITY_SERVER=$REALITY_SERVER" >> "$SB_DIR/env.conf"
  echo "REALITY_SERVER_PORT=$REALITY_SERVER_PORT" >> "$SB_DIR/env.conf"
}
load_env(){ [[ -f "$SB_DIR/env.conf" ]] && source "$SB_DIR/env.conf" || true; }

gen_uuid(){
  if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'
  else 
    # 纯 Bash UUID
    printf '%04x%04x-%04x-%04x-%04x-%04x%04x%04x' $((RANDOM)) $((RANDOM)) $((RANDOM)) $((RANDOM|0x4000)) $((RANDOM|0x8000)) $((RANDOM)) $((RANDOM)) $((RANDOM))
  fi
}

ensure_creds(){
  mkdir -p "$SB_DIR"
  [[ -f "$SB_DIR/creds.env" ]] && source "$SB_DIR/creds.env" || true
  UUID=${UUID:-$(gen_uuid)}
  HY2_PWD=${HY2_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  HY2_PWD2=${HY2_PWD2:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  HY2_OBFS_PWD=${HY2_OBFS_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  TUIC_UUID=$UUID
  TUIC_PWD=${TUIC_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  
  if [[ -z "${REALITY_PRIV:-}" ]]; then
    local kp
    kp=$("$BIN_PATH" generate reality-keypair 2>/dev/null || true)
    REALITY_PRIV=$(echo "$kp" | grep "PrivateKey" | awk '{print $2}' | tr -d '"')
    REALITY_PUB=$(echo "$kp" | grep "PublicKey" | awk '{print $2}' | tr -d '"')
    REALITY_SID=$(openssl rand -hex 8)
  fi
  
  cat > "$SB_DIR/creds.env" <<EOF
UUID=$UUID
HY2_PWD=$HY2_PWD
HY2_PWD2=$HY2_PWD2
HY2_OBFS_PWD=$HY2_OBFS_PWD
REALITY_PRIV=$REALITY_PRIV
REALITY_PUB=$REALITY_PUB
REALITY_SID=$REALITY_SID
TUIC_UUID=$TUIC_UUID
TUIC_PWD=$TUIC_PWD
EOF
}

mk_cert(){
  mkdir -p "$CERT_DIR"
  local crt="$CERT_DIR/fullchain.pem" key="$CERT_DIR/key.pem"
  if [[ ! -f "$crt" || ! -f "$key" ]]; then
    info "生成自签名证书..."
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 3650 -nodes \
      -keyout "$key" -out "$crt" -subj "/CN=$REALITY_SERVER" >/dev/null 2>&1 || true
  fi
}

# ===== [6] WARP =====
setup_warp_api(){
  [[ "$ENABLE_WARP" != "true" ]] && return 0
  [[ -f "$SB_DIR/warp.env" ]] && source "$SB_DIR/warp.env" && return 0
  info "注册 WARP 账户..."
  
  local priv pub resp
  priv=$(wg genkey); pub=$(echo "$priv" | wg pubkey)
  
  # 获取 API 版本
  local api_ver
  api_ver=$(curl -fsSL --connect-timeout 5 https://api.cloudflareclient.com/cdn-cgi/trace 2>/dev/null | grep -oE 'v0a[0-9]+' | head -n1 || echo "v0a2158")
  
  resp=$(curl -s --connect-timeout 10 -X POST \
      -H "Content-Type: application/json" \
      -H "User-Agent: okhttp/3.12.1" \
      --data "{\"public_key\":\"${pub}\",\"install_id\":\"\",\"fcm_token\":\"\",\"tos\":\"$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")\",\"key\":\"${pub}\",\"locale\":\"en_US\",\"type\":\"Android\",\"model\":\"PC\"}" \
      "https://api.cloudflareclient.com/${api_ver}/reg" || true)
      
  if echo "$resp" | jq -e 'has("config")' >/dev/null 2>&1; then
    WARP_PRIVATE_KEY="$priv"
    WARP_PEER_PUBLIC_KEY=$(echo "$resp" | jq -r '.config.peers[0].public_key')
    local v4 v6
    v4=$(echo "$resp" | jq -r '.config.interface.addresses.v4' | cut -d/ -f1)
    v6=$(echo "$resp" | jq -r '.config.interface.addresses.v6 // ""' | cut -d/ -f1)
    if [[ "$v6" == "null" ]]; then v6=""; fi
    
    cat > "$SB_DIR/warp.env" <<EOF
WARP_PRIVATE_KEY=$WARP_PRIVATE_KEY
WARP_PEER_PUBLIC_KEY=$WARP_PEER_PUBLIC_KEY
WARP_ENDPOINT_HOST=162.159.192.1
WARP_ENDPOINT_PORT=2408
WARP_ADDRESS_V4=$v4
WARP_ADDRESS_V6=$v6
WARP_RESERVED_1=0
WARP_RESERVED_2=0
WARP_RESERVED_3=0
EOF
    success "WARP 注册成功"
  else
    err "WARP 注册失败，已禁用 WARP。"
    ENABLE_WARP=false
    # 清空 WARP 端口
    PORT_VLESSR_W=""
    PORT_TROJANR_W=""
    PORT_HY2_W=""
    PORT_HY2_OBFS_W=""
    PORT_TUIC_W=""
  fi
}
load_warp_env(){ [[ -f "$SB_DIR/warp.env" ]] && source "$SB_DIR/warp.env" || true; }

# ===== [7] 安装 Sing-Box =====
install_singbox(){
  if command -v "$BIN_PATH" >/dev/null 2>&1; then
    local cur
    cur=$("$BIN_PATH" version | head -n1 | awk '{print $3}' 2>/dev/null || echo "")
    if [[ "$cur" == "$SB_VERSION" ]]; then
      info "Sing-Box 已安装 ($cur)，跳过。"
      return 0
    fi
  fi
  
  local arch; arch=$(arch_map)
  info "下载 Sing-Box v${SB_VERSION} (${arch})..."
  local url="https://github.com/SagerNet/sing-box/releases/download/v${SB_VERSION}/sing-box-${SB_VERSION}-linux-${arch}.tar.gz"
  local tmp; tmp=$(mktemp -d)
  
  if curl -fsSL --retry 3 "$url" -o "$tmp/sb.tar.gz"; then
    tar -xzf "$tmp/sb.tar.gz" -C "$tmp"
    local bin; bin=$(find "$tmp" -type f -name "sing-box" | head -n1)
    if [[ -n "$bin" ]]; then
        systemctl stop "$SYSTEMD_SERVICE" >/dev/null 2>&1 || true
        install -m 0755 "$bin" "$BIN_PATH"
        success "安装成功"
    else
        rm -rf "$tmp"; die "解压失败"
    fi
  else
    rm -rf "$tmp"; die "下载失败"
  fi
  rm -rf "$tmp"
}

# ===== [8] 写配置 =====
write_config(){
  mkdir -p "$SB_DIR" "$DATA_DIR" "$CERT_DIR"
  load_env; load_ports; install_singbox; ensure_creds
  if [[ "$ENABLE_WARP" == "true" ]]; then setup_warp_api; load_warp_env; fi
  local CRT="$CERT_DIR/fullchain.pem" KEY="$CERT_DIR/key.pem"
  
  # 默认值兜底
  WARP_ENDPOINT_PORT=${WARP_ENDPOINT_PORT:-2408}
  WARP_RESERVED_1=${WARP_RESERVED_1:-0}
  WARP_RESERVED_2=${WARP_RESERVED_2:-0}
  WARP_RESERVED_3=${WARP_RESERVED_3:-0}
  
  jq -n \
    --arg RS "$REALITY_SERVER" --argjson RSP "$REALITY_SERVER_PORT" \
    --arg UID "$UUID" --arg RPR "$REALITY_PRIV" --arg SID "$REALITY_SID" \
    --arg HY2 "$HY2_PWD" --arg HY22 "$HY2_PWD2" --arg HY2O "$HY2_OBFS_PWD" \
    --arg CRT "$CRT" --arg KEY "$KEY" \
    --arg TUICUUID "$TUIC_UUID" --arg TUICPWD "$TUIC_PWD" \
    --arg P1 "$PORT_VLESSR" --arg P2 "$PORT_TROJANR" --arg P3 "$PORT_HY2" --arg P4 "$PORT_HY2_OBFS" --arg P5 "$PORT_TUIC" \
    --arg PW1 "$PORT_VLESSR_W" --arg PW2 "$PORT_TROJANR_W" --arg PW3 "$PORT_HY2_W" --arg PW4 "$PORT_HY2_OBFS_W" --arg PW5 "$PORT_TUIC_W" \
    --arg ENABLE_WARP "${ENABLE_WARP:-false}" \
    --arg WPRIV "${WARP_PRIVATE_KEY:-}" --arg WPPUB "${WARP_PEER_PUBLIC_KEY:-}" \
    --arg WHOST "${WARP_ENDPOINT_HOST:-162.159.192.1}" --arg WPORT "${WARP_ENDPOINT_PORT:-2408}" \
    --arg W4 "${WARP_ADDRESS_V4:-}" --arg W6 "${WARP_ADDRESS_V6:-}" \
    --arg WR1 "${WARP_RESERVED_1:-0}" --arg WR2 "${WARP_RESERVED_2:-0}" --arg WR3 "${WARP_RESERVED_3:-0}" \
    --argjson B_UP "$BRUTAL_UP" --argjson B_DOWN "$BRUTAL_DOWN" \
    '
    def brutal: { enabled: true, padding: true, brutal: { enabled: true, up_mbps: $B_UP, down_mbps: $B_DOWN } };
    def ib_vless_reality($p): { type: "vless", listen: "0.0.0.0", listen_port: ($p|tonumber), users: [{uuid: $UID, flow: "xtls-rprx-vision"}], tls: { enabled: true, server_name: $RS, reality: { enabled: true, handshake: { server: $RS, server_port: $RSP }, private_key: $RPR, short_id: [$SID] } }, multiplex: brutal };
    def ib_trojan($p): { type: "trojan", listen: "0.0.0.0", listen_port: ($p|tonumber), users: [{password: $UID}], tls: { enabled: true, server_name: $RS, reality: { enabled: true, handshake: { server: $RS, server_port: $RSP }, private_key: $RPR, short_id: [$SID] } }, multiplex: brutal };
    def ib_hy2($p): { type: "hysteria2", listen: "0.0.0.0", listen_port: ($p|tonumber), users: [{name: "hy2", password: $HY2}], tls: { enabled: true, certificate_path: $CRT, key_path: $KEY } };
    def ib_hy2_obfs($p): { type: "hysteria2", listen: "0.0.0.0", listen_port: ($p|tonumber), users: [{name: "hy2", password: $HY22}], obfs: { type: "salamander", password: $HY2O }, tls: { enabled: true, certificate_path: $CRT, key_path: $KEY, alpn: ["h3"] } };
    def ib_tuic($p): { type: "tuic", listen: "0.0.0.0", listen_port: ($p|tonumber), users: [{uuid: $TUICUUID, password: $TUICPWD}], congestion_control: "bbr", tls: { enabled: true, certificate_path: $CRT, key_path: $KEY, alpn: ["h3"] } };
    def warp_out: { type: "wireguard", tag: "warp", local_address: (if ($W6|length)>0 then [$W4, $W6] else [$W4] end), private_key: $WPRIV, peers: [{ server: $WHOST, server_port: ($WPORT|tonumber), public_key: $WPPUB, reserved: [$WR1, $WR2, $WR3], allowed_ips: ["0.0.0.0/0", "::/0"] }], mtu: 1280 };
    {
      log: {level: "info"},
      dns: { servers: [{tag: "remote", address: "https://1.1.1.1/dns-query", detour: "direct"}, {address: "8.8.8.8", detour: "direct"}], strategy: "prefer_ipv4" },
      inbounds: [
        (ib_vless_reality($P1) + {tag: "vless-reality"}), (ib_trojan($P2) + {tag: "trojan-reality"}), (ib_hy2($P3) + {tag: "hy2"}), (ib_hy2_obfs($P4) + {tag: "hy2-obfs"}), (ib_tuic($P5) + {tag: "tuic"})
      ] + (if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then [
          (ib_vless_reality($PW1) + {tag: "vless-reality-w"}), (ib_trojan($PW2) + {tag: "trojan-reality-w"}), (ib_hy2($PW3) + {tag: "hy2-w"}), (ib_hy2_obfs($PW4) + {tag: "hy2-obfs-w"}), (ib_tuic($PW5) + {tag: "tuic-w"})
      ] else [] end),
      outbounds: (if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then [{type: "direct", tag: "direct"}, warp_out, {type: "block", tag: "block"}] else [{type: "direct", tag: "direct"}, {type: "block", tag: "block"}] end),
      route: (if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then { rules: [{ inbound: ["vless-reality-w", "trojan-reality-w", "hy2-w", "hy2-obfs-w", "tuic-w"], outbound: "warp" }], final: "direct" } else { final: "direct" } end)
    }
    ' > "$CONF_JSON"
    
  if ! "$BIN_PATH" check -c "$CONF_JSON"; then
    die "配置文件校验失败，请查看上方日志。"
  fi
}

# ===== [9] Systemd & Firewall =====
install_systemd(){
  cat > "/etc/systemd/system/$SYSTEMD_SERVICE" <<EOF
[Unit]
Description=Sing-Box Service
After=network-online.target
[Service]
Type=simple
Environment=ENABLE_DEPRECATED_WIREGUARD_OUTBOUND=true
ExecStart=${BIN_PATH} run -c ${CONF_JSON} -D ${DATA_DIR}
Restart=on-failure
RestartSec=3
LimitNOFILE=infinity
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SYSTEMD_SERVICE"
}

manage_firewall(){
  local action=$1; local ports=("${@:2}"); [[ ${#ports[@]} -eq 0 ]] && return
  if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
    for p in "${ports[@]}"; do if [[ "$action" == "allow" ]]; then ufw allow "$p/tcp"; ufw allow "$p/udp"; else ufw delete allow "$p/tcp" || true; ufw delete allow "$p/udp" || true; fi; done; ufw reload >/dev/null 2>&1
  elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
    for p in "${ports[@]}"; do if [[ "$action" == "allow" ]]; then firewall-cmd --permanent --add-port="$p/tcp" >/dev/null; firewall-cmd --permanent --add-port="$p/udp" >/dev/null; else firewall-cmd --permanent --remove-port="$p/tcp" >/dev/null || true; firewall-cmd --permanent --remove-port="$p/udp" >/dev/null || true; fi; done; firewall-cmd --reload >/dev/null 2>&1
  else
    for p in "${ports[@]}"; do
      if [[ "$action" == "allow" ]]; then
        iptables -I INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || true
        iptables -I INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || true
      else
        iptables -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || true
      fi
    done
    command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
  fi
}
get_ports(){ local vals=(); for v in "${PORT_VARS[@]}"; do [[ -n "${!v:-}" ]] && vals+=("${!v}"); done; echo "${vals[@]}"; }

# ===== [10] 流程 =====
rotate_ports(){
  info "更换端口..."
  load_ports; OLD=($(get_ports))
  plan_ports; write_config
  if [[ ${#OLD[@]} -gt 0 ]]; then manage_firewall "delete" "${OLD[@]}"; fi
  NEW=($(get_ports)); manage_firewall "allow" "${NEW[@]}"
  systemctl restart "$SYSTEMD_SERVICE"; success "完成"; print_links
}

deploy(){
  info "开始部署..."
  install_base_deps; mkdir -p "$SB_DIR" "$DATA_DIR" "$CERT_DIR"; mk_cert
  load_ports
  install_singbox
  plan_ports; write_config; install_systemd
  NEW=($(get_ports)); manage_firewall "allow" "${NEW[@]}"
  systemctl restart "$SYSTEMD_SERVICE"; success "部署成功"; print_links
}

uninstall(){
  systemctl stop "$SYSTEMD_SERVICE" || true
  systemctl disable "$SYSTEMD_SERVICE" || true
  if [[ -f "$SB_DIR/ports.env" ]]; then
    load_ports; OLD=($(get_ports))
    [[ ${#OLD[@]} -gt 0 ]] && manage_firewall "delete" "${OLD[@]}"
  fi
  rm -f "/etc/systemd/system/$SYSTEMD_SERVICE"
  systemctl daemon-reload
  rm -f "$BIN_PATH"; rm -rf "$SB_DIR"
  success "卸载完成"
}

