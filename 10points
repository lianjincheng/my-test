#!/usr/bin/env bash
# ============================================================
#  Sing-Box-Plus 管理脚本 (v4.8 Stability Fix)
#  修复日志：
#   - [严重] 修复 gen_port 中检测端口占用时 grep 返回 1 导致脚本崩溃的问题
#   - [优化] 移除 shuf 依赖，改用纯 Bash 生成随机端口，提高兼容性
# ============================================================
set -Eeuo pipefail

# ===== [0] 错误处理机制 =====
handle_error() {
    local exit_code=$?
    local error_line=$1
    local error_cmd="$2"
    local func_name="${FUNCNAME[1]}"
    
    # 忽略 grep 找不到内容的错误
    if [[ $exit_code -eq 1 ]] && [[ "$error_cmd" == *"grep"* ]]; then
        return 0
    fi

    echo -e "
${C_RED}=== 错误报告 ===${C_RESET}"
    echo -e "错误代码: ${C_BOLD}$exit_code${C_RESET}"
    echo -e "出错行号: ${C_BOLD}$error_line${C_RESET}"
    echo -e "出错命令: ${C_BOLD}$error_cmd${C_RESET}"
    [ -n "$func_name" ] && echo -e "所在函数: ${C_BOLD}$func_name${C_RESET}"
    exit $exit_code
}

trap 'handle_error $LINENO "$BASH_COMMAND"' ERR

# ===== [1] 全局变量设置 =====
SB_DIR="/opt/sing-box"
BIN_PATH="/usr/local/bin/sing-box"
CONF_JSON="$SB_DIR/config.json"
DATA_DIR="$SB_DIR/data"
CERT_DIR="$SB_DIR/cert"
SYSTEMD_SERVICE="sing-box.service"
SB_VERSION="1.10.7"

C_RESET="\033[0m"
C_BOLD="\033[1m"
C_RED="\033[31m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_BLUE="\033[34m"
C_CYAN="\033[36m"
C_PURPLE="\033[35m"

ENABLE_WARP=${ENABLE_WARP:-true}
REALITY_SERVER=${REALITY_SERVER:-www.microsoft.com}
REALITY_SERVER_PORT=${REALITY_SERVER_PORT:-443}
GRPC_SERVICE=${GRPC_SERVICE:-grpc}
BRUTAL_UP=${BRUTAL_UP:-100}
BRUTAL_DOWN=${BRUTAL_DOWN:-1000}
export ENABLE_DEPRECATED_WIREGUARD_OUTBOUND=true

# ===== [2] 基础工具函数 =====
info(){ echo -e "[${C_CYAN}INFO${C_RESET}] $*"; }
warn(){ echo -e "[${C_YELLOW}WARN${C_RESET}] $*"; }
err(){  echo -e "[${C_RED}ERROR${C_RESET}] $*" >&2; }
die(){  err "$*"; exit 1; }
success(){ echo -e "[${C_GREEN}SUCCESS${C_RESET}] $*"; }

check_root(){
  if [[ $EUID -ne 0 ]]; then
    die "请以 root 用户运行此脚本 (sudo -i)"
  fi
}

arch_map() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    armv7l|armv7) echo "armv7" ;;
    *)            echo "amd64" ;;
  esac
}

# ===== [3] 依赖安装 =====
install_base_deps(){
  local common_pkgs=(curl wget jq tar openssl coreutils)
  local miss=()
  for p in "${common_pkgs[@]}"; do 
    if ! command -v "$p" >/dev/null 2>&1; then miss+=("$p"); fi
  done
  if ! command -v ip >/dev/null 2>&1; then miss+=("iproute2"); fi
  if ! command -v ss >/dev/null 2>&1 && ! command -v netstat >/dev/null 2>&1; then miss+=("net-tools"); fi
  if ! command -v wg >/dev/null 2>&1; then miss+=("wireguard-tools"); fi
  if ! command -v ufw >/dev/null 2>&1 && ! command -v iptables >/dev/null 2>&1 && ! command -v firewall-cmd >/dev/null 2>&1; then 
    miss+=("iptables")
  fi
  if ! command -v uuidgen >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then miss+=("uuid-runtime"); else miss+=("util-linux"); fi
  fi
  
  if [ ${#miss[@]} -eq 0 ]; then return 0; fi
  info "安装缺失依赖: ${miss[*]} ..."
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -y >/dev/null 2>&1
    apt-get install -y "${miss[@]}" iproute2 wireguard-tools net-tools
  elif command -v yum >/dev/null 2>&1; then
    yum install -y epel-release
    yum install -y "${miss[@]}" util-linux wireguard-tools net-tools
  elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache "${miss[@]}" ca-certificates util-linux wireguard-tools net-tools
  else
    die "无法自动安装依赖，请手动安装: ${miss[*]}"
  fi
}

# ===== [4] 端口管理 (核心修复部分) =====
PORTS=()

# [修复] 使用变量接收输出，避免 grep 直接抛出退出码 1 触发 set -e
is_port_occupied() {
  local port=$1
  local match=""
  
  if command -v ss >/dev/null 2>&1; then
    # 使用 || true 强制命令返回成功，只看输出是否为空
    match=$(ss -tulpn | grep ":${port}\b" || true)
  elif command -v netstat >/dev/null 2>&1; then
    match=$(netstat -tulpn | grep ":${port}\b" || true)
  fi
  
  if [[ -n "$match" ]]; then
    return 0 # 占用
  else
    return 1 # 未占用
  fi
}

check_port_443_conflict() {
  if is_port_occupied 443; then
    local proc_name=""
    if command -v ss >/dev/null 2>&1; then
      proc_name=$(ss -tulpn | grep ":443\b" | head -n1 || true)
    elif command -v netstat >/dev/null 2>&1; then
      proc_name=$(netstat -tulpn | grep ":443\b" | head -n1 || true)
    fi
    
    if [[ "$proc_name" == *"sing-box"* ]]; then
      info "端口 443 正被当前的 Sing-Box 占用，这是正常的。"
      return 0
    elif [[ -z "$proc_name" ]]; then
       return 0
    else
      err "检测到端口 443 被其他进程占用！"
      echo -e "${C_YELLOW}占用详情: $proc_name${C_RESET}"
      echo -e "Reality 协议需要使用 443 端口。请先停止 Nginx/Apache/Caddy 等占用 443 的服务。"
      die "端口冲突，脚本终止。"
    fi
  fi
}

# [修复] 移除 shuf 依赖，改用 Bash 内置计算，更稳定
gen_port() {
  local p
  local try=0
  local max_try=200
  while [[ $try -lt $max_try ]]; do
    ((try++))
    
    # 生成 10000 - 65535 之间的随机数
    p=$(( (RANDOM * 32768 + RANDOM) % 55536 + 10000 ))
    
    # 校验范围
    [[ $p -lt 10000 || $p -gt 65535 ]] && continue
    
    # 校验脚本内重复
    if [[ " ${PORTS[*]-} " == *" $p "* ]]; then continue; fi
    
    # 校验系统占用
    if is_port_occupied "$p"; then continue; fi
    
    PORTS+=("$p"); echo "$p"; return 0;
  done
  die "严重错误：无法找到空闲端口，请检查服务器端口占用情况！"
}

rand_ports_reset(){ PORTS=(); }

PORT_VARS=(
  PORT_VLESSR PORT_TROJANR PORT_HY2 PORT_HY2_OBFS PORT_TUIC
  PORT_VLESSR_W PORT_TROJANR_W PORT_HY2_W PORT_HY2_OBFS_W PORT_TUIC_W
)

for v in "${PORT_VARS[@]}"; do eval "$v=\"\""; done

save_ports(){
  mkdir -p "$SB_DIR"
  echo "# Generated Ports" > "$SB_DIR/ports.env"
  for v in "${PORT_VARS[@]}"; do
    echo "${v}=${!v}" >> "$SB_DIR/ports.env"
  done
}

load_ports(){ [[ -f "$SB_DIR/ports.env" ]] && source "$SB_DIR/ports.env" || true; }

generate_all_ports(){
  rand_ports_reset
  info "正在规划并检测端口可用性..."
  check_port_443_conflict
  PORT_VLESSR=443
  PORTS+=("$PORT_VLESSR")
  for v in "${PORT_VARS[@]}"; do
    if [[ "$v" == "PORT_VLESSR" ]]; then continue; fi
    if [[ -n "${!v:-}" ]]; then
      if is_port_occupied "${!v}"; then
        warn "检测到原端口 ${!v} 现已被占用，正在自动更换..."
        local new_p; new_p=$(gen_port); eval "$v=$new_p"
      else
        PORTS+=("${!v}")
      fi
    else
      local new_p; new_p=$(gen_port); eval "$v=$new_p"
    fi
  done
  save_ports
}

# ===== [5] 凭证与环境管理 =====
save_env(){
  mkdir -p "$SB_DIR"
  cat > "$SB_DIR/env.conf" <<EOF
BIN_PATH=$BIN_PATH
ENABLE_WARP=$ENABLE_WARP
REALITY_SERVER=$REALITY_SERVER
REALITY_SERVER_PORT=$REALITY_SERVER_PORT
GRPC_SERVICE=$GRPC_SERVICE
EOF
}

load_env(){ [[ -f "$SB_DIR/env.conf" ]] && source "$SB_DIR/env.conf" || true; }

gen_uuid(){
  if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'
  else printf '%04x%04x-%04x-%04x-%04x-%04x%04x%04x' $((RANDOM)) $((RANDOM)) $((RANDOM)) $((RANDOM|0x4000)) $((RANDOM|0x8000)) $((RANDOM)) $((RANDOM)) $((RANDOM)); fi
}

ensure_creds(){
  mkdir -p "$SB_DIR"
  [[ -f "$SB_DIR/creds.env" ]] && source "$SB_DIR/creds.env" || true
  UUID=${UUID:-$(gen_uuid)}
  HY2_PWD=${HY2_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  HY2_PWD2=${HY2_PWD2:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  HY2_OBFS_PWD=${HY2_OBFS_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  TUIC_UUID=$UUID
  TUIC_PWD=${TUIC_PWD:-$(openssl rand -base64 16 | tr -d "=+/" | cut -c1-16)}
  if [[ -z "${REALITY_PRIV:-}" ]]; then
    if ! command -v "$BIN_PATH" >/dev/null 2>&1; then die "Sing-Box 二进制未找到，无法生成密钥。"; fi
    local kp
    kp=$("$BIN_PATH" generate reality-keypair 2>/dev/null || true)
    REALITY_PRIV=$(echo "$kp" | grep -m1 -E "PrivateKey" | awk '{print $2}' | tr -d '"') || true
    REALITY_PUB=$(echo "$kp" | grep -m1 -E "PublicKey" | awk '{print $2}' | tr -d '"') || true
    REALITY_SID=$(openssl rand -hex 8 || echo "")
  fi
  cat > "$SB_DIR/creds.env" <<EOF
UUID=$UUID
HY2_PWD=$HY2_PWD
HY2_PWD2=$HY2_PWD2
HY2_OBFS_PWD=$HY2_OBFS_PWD
REALITY_PRIV=$REALITY_PRIV
REALITY_PUB=$REALITY_PUB
REALITY_SID=$REALITY_SID
TUIC_UUID=$TUIC_UUID
TUIC_PWD=$TUIC_PWD
EOF
}

mk_cert(){
  mkdir -p "$CERT_DIR"
  local crt="$CERT_DIR/fullchain.pem" key="$CERT_DIR/key.pem"
  if [[ ! -f "$crt" || ! -f "$key" ]]; then
    info "生成自签名证书（10年）..."
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 3650 -nodes \
      -keyout "$key" -out "$crt" -subj "/CN=$REALITY_SERVER" >/dev/null 2>&1 || {
        warn "openssl 生成证书失败，请检查 openssl 是否可用"; return 1
      }
  fi
}

# ===== [6] WARP 注册 =====
get_latest_warp_api(){
  local api
  api=$(curl -fsSL --connect-timeout 5 https://api.cloudflareclient.com/cdn-cgi/trace 2>/dev/null | grep -oE 'v0a[0-9]+' | head -n1 || true)
  if [[ -n "$api" ]]; then echo "$api"; return 0; fi
  echo "v0a2158"
}

setup_warp_api(){
  [[ "$ENABLE_WARP" != "true" ]] && return 0
  [[ -f "$SB_DIR/warp.env" ]] && source "$SB_DIR/warp.env" && return 0
  info "正在通过 Cloudflare API 注册 WARP 账户..."
  if ! command -v wg >/dev/null 2>&1; then 
    install_base_deps || { warn "依赖安装失败，禁用 WARP"; ENABLE_WARP=false; return; }
  fi
  local priv pub resp
  priv=$(wg genkey); pub=$(echo "$priv" | wg pubkey)
  local max_retries=3; local count=0; local ok=false
  local api_ver; api_ver=$(get_latest_warp_api)
  local url="https://api.cloudflareclient.com/${api_ver}/reg"
  while [ $count -lt $max_retries ]; do
    ((count++))
    info "尝试注册 WARP ($count/$max_retries) via $api_ver..."
    resp=$(curl -s --connect-timeout 10 -m 15 -X POST \
      -H "Content-Type: application/json" \
      -H "User-Agent: okhttp/3.12.1" \
      --data "{\"public_key\":\"${pub}\",\"install_id\":\"\",\"fcm_token\":\"\",\"tos\":\"$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")\",\"key\":\"${pub}\",\"locale\":\"en_US\",\"type\":\"Android\",\"model\":\"PC\"}" \
      "$url" || true)
    if [[ -n "$resp" ]] && echo "$resp" | jq -e 'has("config")' >/dev/null 2>&1; then
      ok=true; break
    else
      warn "WARP 注册请求无响应或失败，等待 2秒后重试..."
      sleep 2
    fi
  done
  if [ "$ok" = true ]; then
    WARP_PRIVATE_KEY="$priv"
    WARP_PEER_PUBLIC_KEY=$(echo "$resp" | jq -r '.config.peers[0].public_key' 2>/dev/null || echo "")
    local addr_v4; addr_v4=$(echo "$resp" | jq -r '.config.interface.addresses.v4' 2>/dev/null || echo "")
    local addr_v6; addr_v6=$(echo "$resp" | jq -r '.config.interface.addresses.v6 // ""' 2>/dev/null || echo "")
    WARP_ADDRESS_V4=$(echo "$addr_v4" | cut -d/ -f1)
    WARP_ADDRESS_V6=$([[ "$addr_v6" != "null" && -n "$addr_v6" ]] && echo "$addr_v6" | cut -d/ -f1 || echo "")
    WARP_ENDPOINT_HOST="162.159.192.1"; WARP_ENDPOINT_PORT="2408"
    WARP_RESERVED_1="0"; WARP_RESERVED_2="0"; WARP_RESERVED_3="0"
    mkdir -p "$SB_DIR"
    cat > "$SB_DIR/warp.env" <<EOF
WARP_PRIVATE_KEY=$WARP_PRIVATE_KEY
WARP_PEER_PUBLIC_KEY=$WARP_PEER_PUBLIC_KEY
WARP_ENDPOINT_HOST=$WARP_ENDPOINT_HOST
WARP_ENDPOINT_PORT=$WARP_ENDPOINT_PORT
WARP_ADDRESS_V4=$WARP_ADDRESS_V4
WARP_ADDRESS_V6=$WARP_ADDRESS_V6
WARP_RESERVED_1=$WARP_RESERVED_1
WARP_RESERVED_2=$WARP_RESERVED_2
WARP_RESERVED_3=$WARP_RESERVED_3
EOF
    success "WARP 账户注册成功"
  else
    err "WARP API 注册多次失败，将自动禁用 WARP 功能。"
    ENABLE_WARP=false
    PORT_VLESSR_W=""
    PORT_TROJANR_W=""
    PORT_HY2_W=""
    PORT_HY2_OBFS_W=""
    PORT_TUIC_W=""
  fi
}

load_warp_env(){ [[ -f "$SB_DIR/warp.env" ]] && source "$SB_DIR/warp.env" || true; }

# ===== [7] Sing-Box 安装 =====
install_singbox(){
  if command -v "$BIN_PATH" >/dev/null 2>&1; then
    local current_ver
    current_ver=$("$BIN_PATH" version | head -n1 | awk '{print $3}' 2>/dev/null || echo "")
    if [[ "$current_ver" == "$SB_VERSION" ]]; then
      info "Sing-Box 已安装且版本匹配 ($current_ver)，跳过安装。"; return 0
    else
      warn "版本不匹配 (当前: $current_ver, 目标: $SB_VERSION)，准备覆盖安装..."
    fi
  fi
  local arch; arch=$(arch_map)
  info "正在下载 Sing-Box v${SB_VERSION} (${arch})..."
  local filename="sing-box-${SB_VERSION}-linux-${arch}.tar.gz"
  local url="https://github.com/SagerNet/sing-box/releases/download/v${SB_VERSION}/${filename}"
  local tmp; tmp=$(mktemp -d)
  if ! curl -fsSL --retry 3 "$url" -o "$tmp/sb.tar.gz"; then
    rm -rf "$tmp"
    die "下载失败！请检查网络连接 (URL: $url)"
  fi
  tar -xzf "$tmp/sb.tar.gz" -C "$tmp"
  local bin; bin=$(find "$tmp" -type f -name "sing-box" | head -n1)
  if [[ -n "$bin" ]]; then 
    systemctl stop "$SYSTEMD_SERVICE" >/dev/null 2>&1 || true
    install -m 0755 "$bin" "$BIN_PATH"
    success "Sing-Box v${SB_VERSION} 安装成功。"
  else 
    rm -rf "$tmp"
    die "错误：解压后未找到 sing-box 二进制文件。"
  fi
  rm -rf "$tmp"
}

# ===== [8] 配置文件生成 =====
write_config(){
  mkdir -p "$SB_DIR" "$DATA_DIR" "$CERT_DIR"
  load_env; load_ports;
  install_singbox; ensure_creds
  if [[ "$ENABLE_WARP" == "true" ]]; then setup_warp_api; load_warp_env; fi
  local CRT="$CERT_DIR/fullchain.pem" KEY="$CERT_DIR/key.pem"
  
  PORT_VLESSR=${PORT_VLESSR:-443}
  PORT_TROJANR=${PORT_TROJANR:-$(gen_port)}
  PORT_HY2=${PORT_HY2:-$(gen_port)}
  PORT_HY2_OBFS=${PORT_HY2_OBFS:-$(gen_port)}
  PORT_TUIC=${PORT_TUIC:-$(gen_port)}
  PORT_VLESSR_W=${PORT_VLESSR_W:-$(gen_port)}
  PORT_TROJANR_W=${PORT_TROJANR_W:-$(gen_port)}
  PORT_HY2_W=${PORT_HY2_W:-$(gen_port)}
  PORT_HY2_OBFS_W=${PORT_HY2_OBFS_W:-$(gen_port)}
  PORT_TUIC_W=${PORT_TUIC_W:-$(gen_port)}
  WARP_ENDPOINT_PORT=${WARP_ENDPOINT_PORT:-2408}
  WARP_RESERVED_1=${WARP_RESERVED_1:-0}
  WARP_RESERVED_2=${WARP_RESERVED_2:-0}
  WARP_RESERVED_3=${WARP_RESERVED_3:-0}
  
  jq -n \
    --arg RS "$REALITY_SERVER" --argjson RSP "$REALITY_SERVER_PORT" \
    --arg UID "$UUID" --arg RPR "$REALITY_PRIV" --arg SID "$REALITY_SID" \
    --arg HY2 "$HY2_PWD" --arg HY22 "$HY2_PWD2" --arg HY2O "$HY2_OBFS_PWD" \
    --arg CRT "$CRT" --arg KEY "$KEY" \
    --arg TUICUUID "$TUIC_UUID" --arg TUICPWD "$TUIC_PWD" \
    --arg P1 "$PORT_VLESSR" --arg P2 "$PORT_TROJANR" --arg P3 "$PORT_HY2" --arg P4 "$PORT_HY2_OBFS" --arg P5 "$PORT_TUIC" \
    --arg PW1 "$PORT_VLESSR_W" --arg PW2 "$PORT_TROJANR_W" --arg PW3 "$PORT_HY2_W" --arg PW4 "$PORT_HY2_OBFS_W" --arg PW5 "$PORT_TUIC_W" \
    --arg ENABLE_WARP "${ENABLE_WARP:-false}" \
    --arg WPRIV "${WARP_PRIVATE_KEY:-}" --arg WPPUB "${WARP_PEER_PUBLIC_KEY:-}" \
    --arg WHOST "${WARP_ENDPOINT_HOST:-162.159.192.1}" --arg WPORT "${WARP_ENDPOINT_PORT:-2408}" \
    --arg W4 "${WARP_ADDRESS_V4:-}" --arg W6 "${WARP_ADDRESS_V6:-}" \
    --arg WR1 "${WARP_RESERVED_1:-0}" --arg WR2 "${WARP_RESERVED_2:-0}" --arg WR3 "${WARP_RESERVED_3:-0}" \
    --argjson B_UP "$BRUTAL_UP" --argjson B_DOWN "$BRUTAL_DOWN" \
    '
    def brutal: {
      enabled: true,
      padding: true,
      brutal: {
        enabled: true,
        up_mbps: $B_UP,
        down_mbps: $B_DOWN
      }
    };
    
    def ib_vless_reality($p): {
      type: "vless",
      listen: "0.0.0.0",
      listen_port: ($p|tonumber),
      users: [{uuid: $UID, flow: "xtls-rprx-vision"}],
      tls: {
        enabled: true,
        server_name: $RS,
        reality: {
          enabled: true,
          handshake: {
            server: $RS,
            server_port: $RSP
          },
          private_key: $RPR,
          short_id: [$SID]
        }
      },
      multiplex: brutal
    };
    
    def ib_trojan($p): {
      type: "trojan",
      listen: "0.0.0.0",
      listen_port: ($p|tonumber),
      users: [{password: $UID}],
      tls: {
        enabled: true,
        server_name: $RS,
        reality: {
          enabled: true,
          handshake: {
            server: $RS,
            server_port: $RSP
          },
          private_key: $RPR,
          short_id: [$SID]
        }
      },
      multiplex: brutal
    };
    
    def ib_hy2($p): {
      type: "hysteria2",
      listen: "0.0.0.0",
      listen_port: ($p|tonumber),
      users: [{name: "hy2", password: $HY2}],
      tls: {
        enabled: true,
        certificate_path: $CRT,
        key_path: $KEY
      }
    };
    
    def ib_hy2_obfs($p): {
      type: "hysteria2",
      listen: "0.0.0.0",
      listen_port: ($p|tonumber),
      users: [{name: "hy2", password: $HY22}],
      obfs: {
        type: "salamander",
        password: $HY2O
      },
      tls: {
        enabled: true,
        certificate_path: $CRT,
        key_path: $KEY,
        alpn: ["h3"]
      }
    };
    
    def ib_tuic($p): {
      type: "tuic",
      listen: "0.0.0.0",
      listen_port: ($p|tonumber),
      users: [{uuid: $TUICUUID, password: $TUICPWD}],
      congestion_control: "bbr",
      tls: {
        enabled: true,
        certificate_path: $CRT,
        key_path: $KEY,
        alpn: ["h3"]
      }
    };
    
    def warp_out: {
      type: "wireguard",
      tag: "warp",
      local_address: (if ($W6|length)>0 then [$W4, $W6] else [$W4] end),
      private_key: $WPRIV,
      peers: [{
        server: $WHOST,
        server_port: ($WPORT|tonumber),
        public_key: $WPPUB,
        reserved: [$WR1, $WR2, $WR3],
        allowed_ips: ["0.0.0.0/0", "::/0"]
      }],
      mtu: 1280
    };
    
    {
      log: {level: "info"},
      dns: {
        servers: [
          {tag: "remote", address: "https://1.1.1.1/dns-query", detour: "direct"},
          {address: "8.8.8.8", detour: "direct"}
        ],
        strategy: "prefer_ipv4"
      },
      inbounds: [
        (ib_vless_reality($P1) + {tag: "vless-reality"}),
        (ib_trojan($P2) + {tag: "trojan-reality"}),
        (ib_hy2($P3) + {tag: "hy2"}),
        (ib_hy2_obfs($P4) + {tag: "hy2-obfs"}),
        (ib_tuic($P5) + {tag: "tuic"})
      ] + (
        if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then [
          (ib_vless_reality($PW1) + {tag: "vless-reality-w"}),
          (ib_trojan($PW2) + {tag: "trojan-reality-w"}),
          (ib_hy2($PW3) + {tag: "hy2-w"}),
          (ib_hy2_obfs($PW4) + {tag: "hy2-obfs-w"}),
          (ib_tuic($PW5) + {tag: "tuic-w"})
        ] else [] end
      ),
      outbounds: (
        if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then [
          {type: "direct", tag: "direct"},
          warp_out,
          {type: "block", tag: "block"}
        ] else [
          {type: "direct", tag: "direct"},
          {type: "block", tag: "block"}
        ] end
      ),
      route: (
        if $ENABLE_WARP=="true" and ($WPRIV|length)>1 then {
          rules: [
            {
              inbound: ["vless-reality-w", "trojan-reality-w", "hy2-w", "hy2-obfs-w", "tuic-w"],
              outbound: "warp"
            }
          ],
          final: "direct"
        } else {
          final: "direct"
        } end
      )
    }
    ' > "$CONF_JSON"
    
  info "正在校验配置文件..."
  if ! "$BIN_PATH" check -c "$CONF_JSON"; then
    echo -e "
${C_RED}[ERROR] 配置文件校验失败！${C_RESET}"
    die "部署中止。请检查上方错误日志。"
  fi
}

# ===== [9] Systemd & Firewall =====
install_systemd(){
  cat > "/etc/systemd/system/$SYSTEMD_SERVICE" <<EOF
[Unit]
Description=Sing-Box Service
After=network-online.target
Requires=network-online.target
[Service]
Type=simple
Environment=ENABLE_DEPRECATED_WIREGUARD_OUTBOUND=true
ExecStart=${BIN_PATH} run -c ${CONF_JSON} -D ${DATA_DIR}
Restart=on-failure
RestartSec=3
LimitNOFILE=infinity
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SYSTEMD_SERVICE"
}

manage_firewall(){
  local action=$1; local ports=("${@:2}"); [[ ${#ports[@]} -eq 0 ]] && return
  if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "active"; then
    for p in "${ports[@]}"; do if [[ "$action" == "allow" ]]; then ufw allow "$p/tcp"; ufw allow "$p/udp"; else ufw delete allow "$p/tcp" || true; ufw delete allow "$p/udp" || true; fi; done; ufw reload >/dev/null 2>&1
  elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
    for p in "${ports[@]}"; do if [[ "$action" == "allow" ]]; then firewall-cmd --permanent --add-port="$p/tcp" >/dev/null; firewall-cmd --permanent --add-port="$p/udp" >/dev/null; else firewall-cmd --permanent --remove-port="$p/tcp" >/dev/null || true; firewall-cmd --permanent --remove-port="$p/udp" >/dev/null || true; fi; done; firewall-cmd --reload >/dev/null 2>&1
  else
    for p in "${ports[@]}"; do
      if [[ "$action" == "allow" ]]; then
        iptables -C INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$p" -j ACCEPT
        iptables -C INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport "$p" -j ACCEPT
      else
        iptables -D INPUT -p tcp --dport "$p" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null || true
      fi
    done
    command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
  fi
}

get_current_port_values(){ local vals=(); for v in "${PORT_VARS[@]}"; do [[ -n "${!v:-}" ]] && vals+=("${!v}"); done; echo "${vals[@]}"; }

# ===== [10] 主流程 =====
rotate_ports_action(){
  info "更换所有端口..."
  load_ports; OLD_PORTS=($(get_current_port_values))
  
  rand_ports_reset; for v in "${PORT_VARS[@]}"; do eval "$v=\"\""; done; generate_all_ports
  write_config
  if [[ ${#OLD_PORTS[@]} -gt 0 ]]; then info "清理旧规则..."; manage_firewall "delete" "${OLD_PORTS[@]}"; fi
  NEW_PORTS=($(get_current_port_values)); manage_firewall "allow" "${NEW_PORTS[@]}"
  systemctl restart "$SYSTEMD_SERVICE" 2>/dev/null || systemctl restart "$SYSTEMD_SERVICE"
  success "端口已更换"
  print_links
}

deploy(){
  info "开始部署..."
  install_base_deps; mkdir -p "$SB_DIR" "$DATA_DIR" "$CERT_DIR"; mk_cert || warn "mk_cert 返回非 0 状态"
  load_ports
  install_singbox
  generate_all_ports; write_config; install_systemd
  NEW_PORTS=($(get_current_port_values)); manage_firewall "allow" "${NEW_PORTS[@]}"
  systemctl restart "$SYSTEMD_SERVICE"; success "部署成功！"; print_links
  local sys_algo; sys_algo=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
  if [[ "$sys_algo" != "bbr" ]]; then
    echo -e "${C_YELLOW}提示：当前系统 TCP 拥塞控制算法为 [$sys_algo]。建议开启 BBR 以获得 TUIC/Hysteria 的最佳性能。${C_RESET}"
  fi
}

uninstall(){
  echo -e "${C_YELLOW}正在进行彻底卸载...${C_RESET}"
  systemctl stop "$SYSTEMD_SERVICE" >/dev/null 2>&1 || true
  systemctl disable "$SYSTEMD_SERVICE" >/dev/null 2>&1 || true
  systemctl reset-failed "$SYSTEMD_SERVICE" >/dev/null 2>&1 || true
  if [[ -f "$SB_DIR/ports.env" ]]; then
    load_ports
    OLD_PORTS=($(get_current_port_values))
    if [[ ${#OLD_PORTS[@]} -gt 0 ]]; then
      manage_firewall "delete" "${OLD_PORTS[@]}"
    fi
  fi
  rm -f "/etc/systemd/system/$SYSTEMD_SERVICE"
  systemctl daemon-reload
  if [[ -f "$BIN_PATH" ]]; then rm -f "$BIN_PATH"; info "已删除二进制文件"; fi
  if [[ -d "$SB_DIR" ]]; then rm -rf "$SB_DIR"; info "已删除配置目录"; fi
  echo -e "${C_GREEN}✅ 卸载完成！${C_RESET}"
  echo -e "${C_YELLOW}提示：为了系统安全，依赖项 (如 jq, wireguard-tools) 未自动卸载。${C_RESET}"
}

get_ip(){ curl -fsSL --connect-timeout 5 ipv4.icanhazip.com || curl -fsSL --connect-timeout 5 ip.sb || echo "YOUR_IP"; }

print_links(){
  load_env; ensure_creds; load_ports; local IP; IP=$(get_ip)
  echo -e "
${C_GREEN}===== 节点分享 (Sing-Box v${SB_VERSION}) =====${C_RESET}"
  echo -e "${C_CYAN}>> 直连节点范例:${C_RESET}"
  echo "vless://${UUID}@${IP}:${PORT_VLESSR}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SERVER}&fp=chrome&pbk=${REALITY_PUB}&sid=${REALITY_SID}&type=tcp#vless-reality"
  echo "hysteria2://${HY2_PWD}@${IP}:${PORT_HY2}?insecure=1&sni=${REALITY_SERVER}#hy2"
  echo "tuic://${UUID}:${TUIC_PWD}@${IP}:${PORT_TUIC}?congestion_control=bbr&alpn=h3&sni=${REALITY_SERVER}&allow_insecure=1#tuic"
  echo -e "
${C_CYAN}>> WARP 节点范例:${C_RESET}"
  echo "vless://${UUID}@${IP}:${PORT_VLESSR_W}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SERVER}&fp=chrome&pbk=${REALITY_PUB}&sid=${REALITY_SID}&type=tcp#vless-reality-warp"
  echo -e "
配置文件: ${C_BOLD}$CONF_JSON${C_RESET}"
}

menu(){
  clear; echo -e "${C_PURPLE}Sing-Box Manager (v4.8 Stability Fix)${C_RESET}"
  echo "1. 安装 / 重装 (v${SB_VERSION})"
  echo "2. 查看链接"
  echo "3. 更换端口 (含 443 检测)"
  echo "4. 重启服务"
  echo "8. 卸载 (含清理)"
  echo "0. 退出"
  read -p "选择: " num
  case "$num" in 1) deploy ;; 2) print_links ;; 3) rotate_ports_action; read -p "按回车继续..." ;; 4) systemctl restart "$SYSTEMD_SERVICE"; info "已重启"; sleep 1; menu ;; 8) uninstall ;; 0) exit 0 ;; *) menu ;; esac
}

