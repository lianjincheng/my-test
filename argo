#!/bin/bash

# =========================================================
#  Xray Argo 专用增强版 (Direct/Warp 分流)
#  1. 支持双 UUID：一个走 VPS 直连，一个走 WARP 落地
#  2. 支持原生 WARP：自动申请账户并计算 Reserved 字节
#  3. 逻辑严谨：防进程冲突，支持深度卸载，一键换域名
# =========================================================

# --- 配置路径 ---
XRAY_PATH="/usr/local/bin/xray"
XRAY_CONFIG_DIR="/usr/local/etc/xray"
XRAY_CONFIG_FILE="${XRAY_CONFIG_DIR}/config.json"
XRAY_SERVICE_FILE="/etc/systemd/system/xray.service"
XRAY_SHARE_DIR="/usr/local/share/xray"

CLOUDFLARED_PATH="/usr/local/bin/cloudflared"
ARGO_LOG_FILE="${XRAY_CONFIG_DIR}/argo.log"
ARGO_SERVICE_FILE="/etc/systemd/system/argo.service"
PERSISTENT_INFO_FILE="${XRAY_CONFIG_DIR}/.xray_argo_info"

# --- 节点默认值 ---
ARGO_PATH="/argo"
CF_IPS=("8.223.63.150" "206.190.235.108" "34.143.159.175")
CF_DOMAIN="yg1.ygkkk.dpdns.org"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 基础工具函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }

check_root() {
    [[ $EUID -ne 0 ]] && error "需 root 权限运行。" && exit 1
}

# --- 核心清理：防止进程冲突 ---
force_cleanup() {
    info "正在清理可能存在的残留进程与服务..."
    systemctl stop xray argo 2>/dev/null
    systemctl disable xray argo 2>/dev/null
    
    # 强制杀死进程
    pkill -9 xray 2>/dev/null
    pkill -9 cloudflared 2>/dev/null
    
    # 如果端口仍被占用，强制释放
    if [ -f "$PERSISTENT_INFO_FILE" ]; then
        source "$PERSISTENT_INFO_FILE"
        [ -n "$ARGO_PORT" ] && fuser -k -n tcp $ARGO_PORT 2>/dev/null
    fi
    
    rm -f "$ARGO_LOG_FILE"
    sleep 1
}

# --- 依赖安装 ---
check_dependencies() {
    info "检查并安装依赖..."
    local deps=("curl" "jq" "openssl" "wireguard-tools" "xxd" "psmisc")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            apt-get update -y && apt-get install -y "$dep" || yum install -y "$dep"
        fi
    done
}

# --- 安装内核 ---
install_cores() {
    if [ ! -f "$XRAY_PATH" ]; then
        info "安装 Xray-core..."
        bash <(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh) --skip-config
    fi
    
    if [ ! -f "$CLOUDFLARED_PATH" ]; then
        info "安装 Cloudflared..."
        local ARCH=$(uname -m)
        [[ "$ARCH" == "x86_64" ]] && ARCH="amd64" || ARCH="arm64"
        curl -L -o "$CLOUDFLARED_PATH" "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}"
        chmod +x "$CLOUDFLARED_PATH"
    fi
}

# --- WARP 账户申请逻辑 ---
setup_warp() {
    info "申请 WARP 账户并获取落地配置..."
    local PRIV=$(wg genkey)
    local PUB=$(echo "$PRIV" | wg pubkey)
    local RESP=$(curl -s -X POST -H "Content-Type: application/json" --data "{\"key\":\"${PUB}\",\"type\":\"Android\",\"model\":\"PC\"}" https://api.cloudflareclient.com/v0a2158/reg)
    
    WARP_PRIVATE_KEY="$PRIV"
    WARP_PEER_PUBLIC_KEY=$(echo "$RESP" | jq -r '.config.peers[0].public_key')
    WARP_ADDRESS=$(echo "$RESP" | jq -r '.config.interface.addresses.v4' | sed 's/\/.*//g')
    
    # 提取并转换 Reserved 字节 (Xray 落地关键)
    local CLIENT_ID=$(echo "$RESP" | jq -r '.config.clientId' | tr -d '"')
    if [ -n "$CLIENT_ID" ] && [ "$CLIENT_ID" != "null" ]; then
        WARP_RESERVED=$(echo "$CLIENT_ID" | base64 -d | xxd -p | sed 's/../0x&,/g' | sed 's/,$//')
        WARP_RESERVED="[${WARP_RESERVED}]"
    else
        WARP_RESERVED="[0,0,0]"
    fi
}

# --- 生成配置文件 ---
create_configs() {
    mkdir -p "$XRAY_CONFIG_DIR"
    cat > "$XRAY_CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "error" },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "user": ["user-direct"], "outboundTag": "direct" },
      { "type": "field", "user": ["user-warp"], "outboundTag": "warp" },
      { "type": "field", "protocol": ["dns"], "outboundTag": "direct" }
    ]
  },
  "inbounds": [
    {
      "port": ${ARGO_PORT},
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "${UUID_DIRECT}", "email": "user-direct" },
          { "id": "${UUID_WARP}", "email": "user-warp" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "${ARGO_PATH}" }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    {
      "protocol": "wireguard",
      "tag": "warp",
      "settings": {
        "secretKey": "${WARP_PRIVATE_KEY}",
        "address": ["${WARP_ADDRESS}/32"],
        "peers": [
          {
            "publicKey": "${WARP_PEER_PUBLIC_KEY}",
            "endpoint": "engage.cloudflareclient.com:2408"
          }
        ],
        "reserved": ${WARP_RESERVED}
      }
    },
    { "protocol": "blackhole", "tag": "block" }
  ]
}
EOF
}

# --- 创建 Systemd 服务 ---
create_services() {
    cat > "$XRAY_SERVICE_FILE" <<EOF
[Unit]
Description=Xray Service
After=network.target
[Service]
ExecStart=${XRAY_PATH} run -c ${XRAY_CONFIG_FILE}
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
EOF

    cat > "$ARGO_SERVICE_FILE" <<EOF
[Unit]
Description=Argo Tunnel
After=network.target
[Service]
ExecStart=${CLOUDFLARED_PATH} tunnel --url http://127.0.0.1:${ARGO_PORT} --no-autoupdate
Restart=always
RestartSec=5
StandardOutput=append:${ARGO_LOG_FILE}
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray argo >/dev/null 2>&1
    systemctl restart xray argo
}

# --- 节点展示逻辑 ---
display_nodes() {
    if [ ! -f "$PERSISTENT_INFO_FILE" ]; then
        error "未发现安装记录。"
        return
    fi
    source "$PERSISTENT_INFO_FILE"

    info "正在从日志解析 Argo 域名 (约需 5-10 秒)..."
    local ARGO_DOMAIN=""
    local count=0
    while [ $count -lt 12 ]; do
        ARGO_DOMAIN=$(grep -o 'https://[a-zA-Z0-9.-]*\.trycloudflare.com' "$ARGO_LOG_FILE" | head -n 1 | sed 's/https:\/\///')
        [ -n "$ARGO_DOMAIN" ] && break
        echo -n "."
        sleep 1
        ((count++))
    done
    echo

    if [ -z "$ARGO_DOMAIN" ]; then
        error "Argo 域名获取失败。请检查日志: cat $ARGO_LOG_FILE"
        return
    fi

    echo -e "\n${MAGENTA}====================================================${NC}"
    echo -e "${CYAN}   Xray Argo 隧道节点列表 (Warp已启用)   ${NC}"
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${YELLOW}Argo 临时域名: ${ARGO_DOMAIN}${NC}"
    echo
    
    # 生成直连节点 (UUID_DIRECT)
    echo -e "${GREEN}>>> 类型1：优选 IP (走 Direct 直连)${NC}"
    for ip in "${CF_IPS[@]}"; do
        echo -e "vless://${UUID_DIRECT}@${ip}:443?encryption=none&security=tls&sni=${ARGO_DOMAIN}&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH}#Argo_Direct_${ip}"
    done
    echo

    # 生成 WARP 节点 (UUID_WARP)
    echo -e "${GREEN}>>> 类型2：优选域名 (走 Warp 落地)${NC}"
    echo -e "vless://${UUID_WARP}@${CF_DOMAIN}:443?encryption=none&security=tls&sni=${ARGO_DOMAIN}&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH}#Argo_Warp_落地"
    echo -e "\n${CYAN}提示：连接后缀为 '落地' 的节点，IP 将显示为 Cloudflare WARP IP。${NC}"
}

# --- 菜单功能实现 ---
install_argo_xray() {
    force_cleanup
    check_dependencies
    install_cores
    setup_warp

    ARGO_PORT=$(shuf -i 10000-60000 -n 1)
    UUID_DIRECT=$(xray uuid)
    UUID_WARP=$(xray uuid)

    # 持久化存储
    cat > "$PERSISTENT_INFO_FILE" <<EOF
ARGO_PORT="${ARGO_PORT}"
UUID_DIRECT="${UUID_DIRECT}"
UUID_WARP="${UUID_WARP}"
WARP_PRIVATE_KEY="${WARP_PRIVATE_KEY}"
WARP_PEER_PUBLIC_KEY="${WARP_PEER_PUBLIC_KEY}"
WARP_ADDRESS="${WARP_ADDRESS}"
WARP_RESERVED="${WARP_RESERVED}"
EOF

    create_configs
    create_services
    success "安装/重置完成！"
    display_nodes
}

restart_and_refresh() {
    info "强制重启服务以刷新域名..."
    # 核心逻辑：必须先杀掉 cloudflared 进程并清空日志
    pkill -9 cloudflared 2>/dev/null
    rm -f "$ARGO_LOG_FILE"
    systemctl restart xray argo
    display_nodes
}

uninstall_xray_argo() {
    read -p "确定要深度卸载吗？此操作将清除所有文件和配置 (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        force_cleanup
        rm -f "$XRAY_SERVICE_FILE" "$ARGO_SERVICE_FILE"
        rm -f "$XRAY_PATH" "$CLOUDFLARED_PATH"
        rm -rf "$XRAY_CONFIG_DIR" "$XRAY_SHARE_DIR"
        systemctl daemon-reload
        systemctl reset-failed
        success "卸载完成，环境已恢复纯净。"
    fi
}

# --- 主菜单 ---
show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}     Xray Argo 专用版 (Direct/Warp 分流)     ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装/重置 (纯净Argo版)"
    echo -e "2. 查看节点 (Direct/Warp)"
    echo -e "3. 重启服务 (换域名)"
    echo -e "4. 卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    read -p "请选择: " choice
    case "$choice" in
        1) install_argo_xray ;;
        2) display_nodes ;;
        3) restart_and_refresh ;;
        4) uninstall_xray_argo ;;
        0) exit 0 ;;
        *) echo "无效选项" ;;
    esac
    echo
    read -p "按回车键返回主菜单..." dummy
}

# --- 脚本入口 ---
check_root
while true; do
    show_menu
done
