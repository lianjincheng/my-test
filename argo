#!/bin/bash

# =========================================================
#  Xray Argo 专用版 (Warp/Direct 分流) - 强制 IPv4 WARP 版
# =========================================================

# --- Configuration ---
XRAY_PATH="/usr/local/bin/xray"
XRAY_CONFIG_DIR="/usr/local/etc/xray"
XRAY_CONFIG_FILE="${XRAY_CONFIG_DIR}/config.json"
XRAY_SERVICE_FILE="/etc/systemd/system/xray.service"

CLOUDFLARED_PATH="/usr/local/bin/cloudflared"
ARGO_LOG_FILE="${XRAY_CONFIG_DIR}/argo.log"
ARGO_SERVICE_FILE="/etc/systemd/system/argo.service"

# 持久化信息存储文件
PERSISTENT_INFO_FILE="${XRAY_CONFIG_DIR}/.xray_argo_info"

# Fixed Addresses (优选)
CF_IPS=("8.223.63.150" "34.143.159.175")
CF_DOMAIN="yg9.ygkkk.dpdns.org"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- Utils ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

check_root() {
    [[ $EUID -ne 0 ]] && error "需 root 权限" && exit 1
}

prepare_dir() {
    mkdir -p "$XRAY_CONFIG_DIR"
}

save_config() {
    prepare_dir
    cat > "$PERSISTENT_INFO_FILE" <<EOF
ARGO_PORT=$ARGO_PORT
ARGO_PATH=$ARGO_PATH
UUID_DIRECT=$UUID_DIRECT
UUID_WARP=$UUID_WARP
WARP_PRIVATE_KEY=$WARP_PRIVATE_KEY
WARP_PEER_PUBLIC_KEY=$WARP_PEER_PUBLIC_KEY
WARP_ADDRESS=$WARP_ADDRESS
WARP_RESERVED=$WARP_RESERVED
EOF
}

load_config() {
    if [ -f "$PERSISTENT_INFO_FILE" ]; then
        source "$PERSISTENT_INFO_FILE"
        return 0
    fi
    return 1
}

# --- Core Functions ---

check_dependencies() {
    info "检查依赖组件..."
    local deps=("curl" "jq" "openssl" "wireguard-tools" "bsdmainutils")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            if [[ "$dep" == "bsdmainutils" ]]; then
                apt-get update -y && apt-get install -y bsdmainutils || yum install -y util-linux
            else
                apt-get update -y && apt-get install -y "$dep" || yum install -y "$dep"
            fi
        fi
    done
}

install_binaries() {
    if [ ! -f "$XRAY_PATH" ]; then
        info "安装 Xray-core..."
        bash <(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)
    fi
    
    if [ ! -f "$CLOUDFLARED_PATH" ]; then
        info "安装 Cloudflared..."
        local ARCH=$(uname -m)
        [[ "$ARCH" == "x86_64" ]] && ARCH="amd64" || ARCH="arm64"
        curl -L -o "$CLOUDFLARED_PATH" "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}"
        chmod +x "$CLOUDFLARED_PATH"
    fi
}

setup_warp() {
    if [[ -n "$WARP_PRIVATE_KEY" && -n "$WARP_PEER_PUBLIC_KEY" && -n "$WARP_ADDRESS" ]]; then
    return 0
    fi

    info "正在注册 WARP 账户..."
    local PRIV=$(wg genkey)
    local PUB=$(echo "$PRIV" | wg pubkey)
    local RESP=$(curl -s -X POST -H "Content-Type: application/json" --data "{\"key\":\"${PUB}\",\"type\":\"Android\",\"model\":\"PC\"}" https://api.cloudflareclient.com/v0a2158/reg)
    
    WARP_PRIVATE_KEY="$PRIV"
    WARP_PEER_PUBLIC_KEY=$(echo "$RESP" | jq -r '.config.peers[0].public_key // empty')
    WARP_ADDRESS=$(echo "$RESP" | jq -r '.config.interface.addresses.v4 // empty' | sed 's/\/.*//g')
    
    local CLIENT_ID_B64=$(echo "$RESP" | jq -r '.config.clientId // empty')
    if [[ -n "$CLIENT_ID_B64" ]]; then
        WARP_RESERVED=$(echo "$CLIENT_ID_B64" | base64 -d | hexdump -v -e '1/1 "%u,"' | sed 's/,$//')
        WARP_RESERVED="[${WARP_RESERVED}]"
    else
        WARP_RESERVED="[0,0,0]"
    fi

    if [[ -z "$WARP_PEER_PUBLIC_KEY" || "$WARP_PEER_PUBLIC_KEY" == "null" ]]; then
        error "WARP 注册失败，请检查网络。"
        exit 1
    fi
}

create_xray_config() {
    info "生成 Xray 配置文件 (强制 IPv4 WARP)..."
    cat > "$XRAY_CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "error" },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "user": ["user-direct"], "outboundTag": "direct" },
      { "type": "field", "user": ["user-warp"], "outboundTag": "warp" }
    ]
  },
  "inbounds": [
    {
      "port": ${ARGO_PORT},
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "${UUID_DIRECT}", "email": "user-direct" },
          { "id": "${UUID_WARP}", "email": "user-warp" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "${ARGO_PATH}" }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct","settings": {"domainStrategy": "UseIPv4"}},
    {
      "protocol": "wireguard",
      "tag": "warp",
      "settings": {
        "secretKey": "${WARP_PRIVATE_KEY}",
        "address": ["${WARP_ADDRESS}/32"],
        "mtu": 1280,
        "peers": [
          {
            "publicKey": "${WARP_PEER_PUBLIC_KEY}",
            "endpoint": "162.159.192.1:2408"
          }
        ],
        "reserved": ${WARP_RESERVED}
      }
    }
  ]
}
EOF
}

create_services() {
    cat > "$XRAY_SERVICE_FILE" <<EOF
[Unit]
Description=Xray Service
After=network.target
[Service]
ExecStart=${XRAY_PATH} run -c ${XRAY_CONFIG_FILE}
Restart=always
[Install]
WantedBy=multi-user.target
EOF

    cat > "$ARGO_SERVICE_FILE" <<EOF
[Unit]
Description=Argo Tunnel
After=network.target
[Service]
ExecStart=${CLOUDFLARED_PATH} tunnel --url http://127.0.0.1:${ARGO_PORT} --no-autoupdate
Restart=always
StandardOutput=append:${ARGO_LOG_FILE}
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray
    systemctl enable argo
    systemctl restart xray
    systemctl restart argo

}

install_all() {
    prepare_dir
    check_dependencies
    install_binaries
    
    if ! load_config || [[ -z "$UUID_DIRECT" ]]; then
        ARGO_PORT=$(shuf -i 10000-65535 -n 1)
        ARGO_PATH="/argo$(openssl rand -hex 4)"
        UUID_DIRECT=$(xray uuid)
        UUID_WARP=$(xray uuid)
        setup_warp
        save_config
    else
        info "检测到已有配置，正在重新应用..."
        setup_warp
        save_config
    fi
    
    create_xray_config
    # 自动校验配置
    if $XRAY_PATH run -test -c "$XRAY_CONFIG_FILE" &>/dev/null; then
        create_services
        success "安装并启动完成！"
        display_nodes
    else
        error "配置文件校验失败，请检查逻辑！"
        $XRAY_PATH run -test -c "$XRAY_CONFIG_FILE"
    fi
}

reset_argo() {
    info "正在重置 Argo 临时域名..."
    systemctl stop argo
    rm -f "$ARGO_LOG_FILE"
    systemctl start argo
    success "Argo 已重启，正在获取新域名..."
    display_nodes
}

uninstall_all() {
    printf "${RED}确定要卸载所有组件吗？(y/n): ${NC}"
    read -r choice
    if [[ "$choice" == "y" ]]; then
        systemctl stop xray argo 2>/dev/null
        systemctl disable xray argo 2>/dev/null
        rm -f "$XRAY_SERVICE_FILE" "$ARGO_SERVICE_FILE"
        systemctl daemon-reload
        rm -rf "$XRAY_CONFIG_DIR"
        success "卸载完成。"
    else
        info "已取消。"
    fi
}

display_nodes() {
    if ! load_config; then
        error "未发现配置文件，请先安装。"
        return
    fi

    info "正在获取 Argo 域名 (最多等待 30 秒)..."
    local count=0
    local ARGO_DOMAIN=""
    while [ $count -lt 15 ]; do
        if [ -f "$ARGO_LOG_FILE" ]; then
            ARGO_DOMAIN=$(grep -o 'https://[a-zA-Z0-9.-]*\.trycloudflare.com' "$ARGO_LOG_FILE" | tail -n 1 | sed 's/https:\/\///')
        fi
        if [[ -n "$ARGO_DOMAIN" ]]; then break; fi
        sleep 2
        ((count++))
    done
    
    if [[ -z "$ARGO_DOMAIN" ]]; then
        error "未能获取 Argo 域名。"
        return
    fi

    echo -e "\n${GREEN}===== Xray Argo 节点列表 =====${NC}"
    echo -e "${YELLOW}Argo 域名: ${ARGO_DOMAIN}${NC}"
    echo -e "${YELLOW}路径: ${ARGO_PATH}${NC}\n"

    echo -e "${BLUE}1. 直连节点 (走 VPS IP):${NC}"
    for ip in "${CF_IPS[@]}"; do
        echo "vless://${UUID_DIRECT}@${ip}:443?encryption=none&security=tls&sni=${ARGO_DOMAIN}&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH}#Argo_Direct_${ip}"
    done

    echo -e "\n${BLUE}2. WARP 节点 (走 Cloudflare 落地):${NC}"
    echo "vless://${UUID_WARP}@${CF_DOMAIN}:443?encryption=none&security=tls&sni=${ARGO_DOMAIN}&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH}#Argo_Warp"
    echo -e "\n${NC}"
}

main_menu() {
    clear
    echo -e "${GREEN}====================================${NC}"
    echo -e "${GREEN}    Xray Argo (WARP 分流) 管理脚本    ${NC}"
    echo -e "${GREEN}====================================${NC}"
    echo -e " 1. 安装 / 启动服务 (修复 IPv4 连接)"
    echo -e " 2. 查看当前节点信息"
    echo -e " 3. 重置 Argo 域名 (重新生成)"
    echo -e " 4. 卸载服务"
    echo -e " 0. 退出"
    echo -e "${GREEN}====================================${NC}"
    printf "请输入数字 [0-4]: "
    read -r choice

    case "$choice" in
        1) install_all ;;
        2) display_nodes ;;
        3) reset_argo ;;
        4) uninstall_all ;;
        0) exit 0 ;;
        *) error "无效输入"; sleep 1; main_menu ;;
    esac
}

check_root
load_config >/dev/null 2>&1

while true; do
    main_menu
    echo -e "\n按回车键返回主菜单..."
    read -r
done
