#!/bin/bash

# Script for Sing-Box Hysteria2 & Reality & Argo Temporary Tunnel
# Based on Sing-box 1.8.0

# --- Author Information ---
AUTHOR_NAME="Singbox 3-Node + Argo Tunnel (Pure IPv4 Ultimate)"

# --- Configuration ---
SINGBOX_INSTALL_PATH_EXPECTED="/usr/local/bin/sing-box"
SINGBOX_CONFIG_DIR="/usr/local/etc/sing-box"
SINGBOX_CONFIG_FILE="${SINGBOX_CONFIG_DIR}/config.json"
SINGBOX_SERVICE_FILE="/etc/systemd/system/sing-box.service"

# Argo 相关配置
CLOUDFLARED_PATH="/usr/local/bin/cloudflared"
ARGO_LOG_FILE="${SINGBOX_CONFIG_DIR}/argo.log"
ARGO_PORT_FILE="${SINGBOX_CONFIG_DIR}/argo_port.info"

HYSTERIA_CERT_DIR="/etc/hysteria"
HYSTERIA_CERT_KEY="${HYSTERIA_CERT_DIR}/private.key"
HYSTERIA_CERT_PEM="${HYSTERIA_CERT_DIR}/cert.pem"

PERSISTENT_INFO_FILE="${SINGBOX_CONFIG_DIR}/.last_singbox_script_info"

# 默认值
DEFAULT_HYSTERIA_MASQUERADE_CN="www.bing.com"
DEFAULT_REALITY_SNI="itunes.apple.com"

# 全局 SINGBOX_CMD
SINGBOX_CMD=""

# --- 全局变量 ---
LAST_SERVER_IP=""
# 智能分流组
HY2_SMART_PORT=""
HY2_SMART_PASSWORD=""
# 全局直连组
HY2_DIRECT_PORT=""
HY2_DIRECT_PASSWORD=""
# Hy2 混淆密码
HY2_OBFS_PASSWORD=""

REALITY_DIRECT_PORT=""
REALITY_DIRECT_UUID=""
REALITY_DIRECT_PUBLIC_KEY=""
REALITY_DIRECT_PRIVATE_KEY_FOR_CONFIG=""
REALITY_DIRECT_SHORT_ID=""

# Argo 组
ARGO_PORT=""
ARGO_UUID=""
ARGO_PATH="/argo" 
# WARP 配置
WARP_PRIVATE_KEY=""
WARP_PEER_PUBLIC_KEY=""
WARP_ADDRESS=""
WARP_RESERVED=""

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

print_author_info() {
    echo -e "${MAGENTA}${BOLD}================================================${NC}"
    echo -e "${CYAN}${BOLD} Sing-Box 全能管理脚本 (纯 IPv4 极速版) ${NC}"
    echo -e "${MAGENTA}${BOLD}================================================${NC}"
}

load_persistent_info() {
    if [ -f "$PERSISTENT_INFO_FILE" ]; then
        source "$PERSISTENT_INFO_FILE"
    fi
}

save_persistent_info() {
    mkdir -p "$(dirname "$PERSISTENT_INFO_FILE")"
    cat > "$PERSISTENT_INFO_FILE" <<EOF
LAST_SERVER_IP="${LAST_SERVER_IP}"
HY2_SMART_PORT="${HY2_SMART_PORT}"
HY2_SMART_PASSWORD="${HY2_SMART_PASSWORD}"
HY2_OBFS_PASSWORD="${HY2_OBFS_PASSWORD}"
REALITY_DIRECT_PORT="${REALITY_DIRECT_PORT}"
REALITY_DIRECT_UUID="${REALITY_DIRECT_UUID}"
REALITY_DIRECT_PUBLIC_KEY="${REALITY_DIRECT_PUBLIC_KEY}"
REALITY_DIRECT_SHORT_ID="${REALITY_DIRECT_SHORT_ID}"
HY2_DIRECT_PORT="${HY2_DIRECT_PORT}"
HY2_DIRECT_PASSWORD="${HY2_DIRECT_PASSWORD}"
ARGO_PORT="${ARGO_PORT}"
ARGO_UUID="${ARGO_UUID}"
WARP_PRIVATE_KEY="${WARP_PRIVATE_KEY}"
WARP_PEER_PUBLIC_KEY="${WARP_PEER_PUBLIC_KEY}"
WARP_ADDRESS="${WARP_ADDRESS}"
WARP_RESERVED="${WARP_RESERVED}"
EOF
}

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "需 root 权限运行。"
        exit 1
    fi
}

attempt_install_package() {
    local package_name="$1"
    local check_cmd="$package_name"

    if [[ "$package_name" == "wireguard-tools" ]]; then
        check_cmd="wg"
    elif [[ "$package_name" == "cron" ]]; then
        check_cmd="crontab"
    fi

    if command -v "$check_cmd" &>/dev/null; then 
        return 0
    fi
    
    info "正在安装依赖: $package_name ..."
    if command -v apt-get &>/dev/null; then
        apt-get update -y && apt-get install -y "$package_name"
    elif command -v yum &>/dev/null; then
        yum install -y "$package_name"
    else
        error "无法确定包管理器 (非 apt/yum)，请手动安装 $package_name"
        exit 1
    fi

    if ! command -v "$check_cmd" &>/dev/null; then
        error "依赖 $package_name 安装失败！(未找到命令: $check_cmd)"
        exit 1
    fi
}

check_dependencies() {
    local core_deps=("curl" "openssl" "jq" "lsof" "cron")
    for dep in "${core_deps[@]}"; do
        attempt_install_package "$dep"
    done
}

find_and_set_singbox_cmd() {
    if [ -x "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
        SINGBOX_CMD="$SINGBOX_INSTALL_PATH_EXPECTED"
    else
        SINGBOX_CMD=""
    fi
}

get_server_ip() {
    # 强制 IPv4 (-s4)
    SERVER_IP=$(curl -s4 https://api.ipify.org || curl -s4 ip.sb)
    if [ -z "$SERVER_IP" ]; then
        error "无法获取服务器 IP，请检查网络连接。"
        exit 1
    fi
    LAST_SERVER_IP="$SERVER_IP"
}

generate_random_password() {
    openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 16
}

install_cloudflared() {
    if [ -f "$CLOUDFLARED_PATH" ]; then
        info "Cloudflared 已安装。"
        return 0
    fi
    info "正在安装 Cloudflared..."
    local ARCH
    case "$(uname -m)" in
        x86_64) ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        *) error "Cloudflared 不支持的架构: $(uname -m)"; exit 1 ;;
    esac
    
    local URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}"
    # 强制 IPv4 下载
    (command -v curl>/dev/null 2>&1 && curl -4 -L -o "$CLOUDFLARED_PATH" "$URL") || (command -v wget>/dev/null 2>&1 && wget -4 -O "$CLOUDFLARED_PATH" "$URL")
    
    if [ ! -f "$CLOUDFLARED_PATH" ]; then
        error "Cloudflared 下载失败，文件不存在。"
        exit 1
    fi

    chmod +x "$CLOUDFLARED_PATH"
    success "Cloudflared 安装成功。"
}

start_argo_tunnel() {
    pkill -f cloudflared
    info "正在启动 Argo 临时隧道 (端口转发: $ARGO_PORT)..."
    
    echo "" > "$ARGO_LOG_FILE"

    # 1. 禁用 IPv6 (--edge-ip-version 4)
    # 2. 启用 HTTP2 (--protocol http2)
    nohup "$CLOUDFLARED_PATH" tunnel --url http://127.0.0.1:${ARGO_PORT} --edge-ip-version 4 --no-autoupdate --protocol http2 > "$ARGO_LOG_FILE" 2>&1 &
    
    sleep 2
    if ! pgrep -f cloudflared > /dev/null; then
        error "Cloudflared 进程启动失败！"
        cat "$ARGO_LOG_FILE"
        return 1
    fi

    local cron_cmd="@reboot sleep 10 && nohup $CLOUDFLARED_PATH tunnel --url http://127.0.0.1:${ARGO_PORT} --edge-ip-version 4 --no-autoupdate --protocol http2 > $ARGO_LOG_FILE 2>&1 &"
    (crontab -l 2>/dev/null | grep -v "cloudflared") | crontab -
    (crontab -l 2>/dev/null; echo "$cron_cmd") | crontab -
}

wait_for_argo_connection() {
    info "正在验证 Argo 隧道连通性 (最多等待 30 秒)..."
    local timeout=30
    local elapsed=0
    
    while [ $elapsed -lt $timeout ]; do
        if grep -q "Registered tunnel connection" "$ARGO_LOG_FILE"; then
            success "Argo 隧道已成功建立！"
            return 0
        fi
        
        if ! pgrep -f cloudflared > /dev/null; then
            error "检测到 Cloudflared 进程意外退出！"
            return 1
        fi
        
        sleep 1
        ((elapsed++))
        echo -ne "."
    done
    
    echo ""
    error "Argo 隧道启动超时 (30秒内未连接成功)。"
    warn "以下是 Argo 日志的最后 10 行，请检查错误原因："
    echo "------------------------------------------------"
    tail -n 10 "$ARGO_LOG_FILE"
    echo "------------------------------------------------"
    warn "常见原因：IP 被 Cloudflare 限制、网络不通、或 Cloudflare 服务抖动。"
    return 1
}

install_singbox_core() {
    local target_version="v1.8.0"
    if [ -f "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
        find_and_set_singbox_cmd
        return 0
    fi
    
    info "正在安装 Sing-box $target_version..."
    local ARCH
    case "$(uname -m)" in
        x86_64) ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        *) error "Sing-box 不支持的架构: $(uname -m)"; exit 1 ;;
    esac
    
    local version_num=${target_version#v}
    local download_url="https://github.com/SagerNet/sing-box/releases/download/${target_version}/sing-box-${version_num}-linux-${ARCH}.tar.gz"
    
    local tmp_dir=$(mktemp -d)
    # 强制 IPv4 下载 (-4)
    if ! curl -4 -L -o "${tmp_dir}/sing-box.tar.gz" "$download_url"; then
        error "Sing-box 下载失败！请检查网络。"
        rm -rf "$tmp_dir"
        exit 1
    fi
    
    tar -xzf "${tmp_dir}/sing-box.tar.gz" -C "$tmp_dir"
    install -m 755 "${tmp_dir}/sing-box-${version_num}-linux-${ARCH}/sing-box" "$SINGBOX_INSTALL_PATH_EXPECTED"
    rm -rf "$tmp_dir"
    find_and_set_singbox_cmd

    if [ ! -x "$SINGBOX_CMD" ]; then
        error "Sing-box 安装失败，可执行文件未找到。"
        exit 1
    fi
}

setup_warp() {
    if [ -n "$WARP_PRIVATE_KEY" ]; then return 0; fi
    info "配置 WARP..."
    attempt_install_package "wireguard-tools"
    attempt_install_package "jq"
    
    local PRIV=$(wg genkey)
    local PUB=$(echo "$PRIV" | wg pubkey)
    # 强制 IPv4 注册 (-4)
    local RESP=$(curl -4 -s -X POST -H "Content-Type: application/json" --data "{\"key\":\"${PUB}\",\"type\":\"Android\",\"model\":\"PC\"}" https://api.cloudflareclient.com/v0a2158/reg)
    
    WARP_PRIVATE_KEY="$PRIV"
    WARP_PEER_PUBLIC_KEY=$(echo "$RESP" | jq -r '.config.peers[0].public_key')
    WARP_ADDRESS=$(echo "$RESP" | jq -r '.config.interface.addresses.v4' | sed 's/\/.*//g')
    WARP_RESERVED="[0,0,0]"

    if [[ -z "$WARP_ADDRESS" || "$WARP_ADDRESS" == "null" ]]; then
        error "WARP 注册失败，无法获取 IP 地址。"
        exit 1
    fi
}

generate_self_signed_cert() {
    if [ -f "$HYSTERIA_CERT_PEM" ]; then return 0; fi
    mkdir -p "$HYSTERIA_CERT_DIR"
    openssl req -new -x509 -days 36500 -nodes -subj "/CN=$DEFAULT_HYSTERIA_MASQUERADE_CN" -keyout "$HYSTERIA_CERT_KEY" -out "$HYSTERIA_CERT_PEM"
}

generate_single_reality_credentials() {
    local -n _uuid=$1 _priv=$2 _pub=$3 _sid=$4
    find_and_set_singbox_cmd
    _uuid=$($SINGBOX_CMD generate uuid)
    local KP=$($SINGBOX_CMD generate reality-keypair)
    _priv=$(echo "$KP" | awk '/PrivateKey/{print $2}')
    _pub=$(echo "$KP" | awk '/PublicKey/{print $2}')
    _sid=$(openssl rand -hex 8)
}

create_config_json() {
    find_and_set_singbox_cmd
    mkdir -p "$SINGBOX_CONFIG_DIR"

    # --- 终极 IPv4 纯净版配置 ---
    # 1. listen: 0.0.0.0 (只监听 IPv4)
    # 2. dns strategy: ipv4_only
    # 3. outbounds strategy: ipv4_only
    
    cat > "$SINGBOX_CONFIG_FILE" <<EOF
{
  "log": { "level": "error", "timestamp": true },
  "dns": {
    "servers": [
      { "tag": "google", "address": "8.8.8.8", "detour": "direct" }
    ],
    "strategy": "ipv4_only","independent_cache": true,"final": "google"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-smart",
      "listen": "0.0.0.0", 
      "listen_port": ${HY2_SMART_PORT},
      "users": [ { "password": "${HY2_SMART_PASSWORD}" } ],
      "tls": { "enabled": true, "key_path": "${HYSTERIA_CERT_KEY}", "certificate_path": "${HYSTERIA_CERT_PEM}" },
      "obfs": { "type": "salamander", "password": "${HY2_OBFS_PASSWORD}" }
    },
    {
      "type": "vless",
      "tag": "reality-direct",
      "listen": "0.0.0.0",
      "listen_port": ${REALITY_DIRECT_PORT},
      "users": [ { "uuid": "${REALITY_DIRECT_UUID}", "flow": "xtls-rprx-vision" } ],
      "tls": {
        "enabled": true, "server_name": "${DEFAULT_REALITY_SNI}",
        "reality": { "enabled": true, "handshake": { "server": "${DEFAULT_REALITY_SNI}", "server_port": 443 }, "private_key": "${REALITY_DIRECT_PRIVATE_KEY_FOR_CONFIG}", "short_id": "${REALITY_DIRECT_SHORT_ID}" }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-direct",
      "listen": "0.0.0.0",
      "listen_port": ${HY2_DIRECT_PORT},
      "users": [ { "password": "${HY2_DIRECT_PASSWORD}" } ],
      "tls": { "enabled": true, "key_path": "${HYSTERIA_CERT_KEY}", "certificate_path": "${HYSTERIA_CERT_PEM}" },
      "obfs": { "type": "salamander", "password": "${HY2_OBFS_PASSWORD}" }
    },
    {
      "type": "vless",
      "tag": "vless-argo",
      "listen": "127.0.0.1",
      "listen_port": ${ARGO_PORT},
      "users": [ { "uuid": "${ARGO_UUID}" } ],
      "transport": { "type": "ws", "path": "${ARGO_PATH}" }
    }
  ],
  "outbounds": [
    {
      "type": "wireguard",
      "tag": "warp-out",
      "local_address": [ "${WARP_ADDRESS}/32" ],
      "private_key": "${WARP_PRIVATE_KEY}",
      "peer_public_key": "${WARP_PEER_PUBLIC_KEY}",
      "server": "162.159.192.1",
      "server_port": 2408,
      "reserved": ${WARP_RESERVED},
      "domain_strategy": "ipv4_only"
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_strategy": "ipv4_only"
    },
    { "type": "dns", "tag": "dns-out" }
  ],
  "route": {
    "rules": [
      { "protocol": "dns", "outbound": "dns-out" },
      { "inbound": "hy2-direct", "outbound": "direct" },
      { "inbound": "reality-direct", "outbound": "direct" },
      { "inbound": "vless-argo", "outbound": "direct" },
      { "inbound": "hy2-smart", "outbound": "warp-out" }
    ]
  }
}
EOF
}

create_systemd_service() {
    cat > "$SINGBOX_SERVICE_FILE" <<EOF
[Unit]
Description=Sing-Box Service
After=network.target
[Service]
User=root
WorkingDirectory=${SINGBOX_CONFIG_DIR}
ExecStart=${SINGBOX_CMD} run -c ${SINGBOX_CONFIG_FILE}
Restart=on-failure
[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable sing-box
}

display_and_store_config_info() {
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 1. [智能] Hysteria2 (WARP出站)${NC}"
    echo -e "    hy2://${HY2_SMART_PASSWORD}@${LAST_SERVER_IP}:${HY2_SMART_PORT}?sni=${DEFAULT_HYSTERIA_MASQUERADE_CN}&insecure=1&obfs=salamander&obfs-password=${HY2_OBFS_PASSWORD}#Hy2-Smart"
    echo
    echo -e "${GREEN} 2. [直连] Reality (TCP-Vision)${NC}"
    echo -e "    vless://${REALITY_DIRECT_UUID}@${LAST_SERVER_IP}:${REALITY_DIRECT_PORT}?security=reality&sni=${DEFAULT_REALITY_SNI}&fp=chrome&pbk=${REALITY_DIRECT_PUBLIC_KEY}&sid=${REALITY_DIRECT_SHORT_ID}&type=tcp&flow=xtls-rprx-vision#Reality-Direct"
    echo
    echo -e "${GREEN} 3. [直连] Hysteria2 (备用)${NC}"
    echo -e "    hy2://${HY2_DIRECT_PASSWORD}@${LAST_SERVER_IP}:${HY2_DIRECT_PORT}?sni=${DEFAULT_HYSTERIA_MASQUERADE_CN}&insecure=1&obfs=salamander&obfs-password=${HY2_OBFS_PASSWORD}#Hy2-Direct"
    echo
    
    echo -e "${CYAN}================== Argo 临时隧道 ==================${NC}"
    info "正在从日志文件抓取域名..."
    
    local ARGO_DOMAIN=""
    if [ -f "$ARGO_LOG_FILE" ]; then
        ARGO_DOMAIN=$(grep -a "trycloudflare.com" "$ARGO_LOG_FILE" | tail -n 10 | grep -o 'https://.*trycloudflare.com' | sed 's/https:\/\///' | head -n 1)
    fi
    
    if [ -n "$ARGO_DOMAIN" ]; then
        success "抓取成功！当前隧道域名: ${ARGO_DOMAIN}"
        echo -e "${YELLOW}说明: 以下生成 13 个优选域名节点 (yg1 - yg13)${NC}"
        echo
        
        local base_domain="ygkkk.dpdns.org"
        for i in {1..13}; do
            local current_cf_ip="yg${i}.${base_domain}"
            local node_name="Argo-YG${i}"
            local argo_link="vless://${ARGO_UUID}@${current_cf_ip}:443?encryption=none&security=tls&sni=${ARGO_DOMAIN}&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH}#${node_name}"
            
            echo -e "${GREEN} [Argo] 优选节点 ${i} (${current_cf_ip})${NC}"
            echo -e "    ${argo_link}"
        done
    else
        error "无法获取 Argo 域名 (虽然隧道已连接)。"
        warn "请运行 'cat $ARGO_LOG_FILE' 查看详情。"
    fi
    
    echo -e "${MAGENTA}====================================================${NC}"
    save_persistent_info
}

install_all_nodes() {
    install_singbox_core
    install_cloudflared
    get_server_ip
    setup_warp

    if lsof -i :443 >/dev/null 2>&1; then
        warn "443 端口被占用，Reality 将使用随机端口。"
        REALITY_DIRECT_PORT=$(shuf -i 10000-65535 -n 1)
    else
        REALITY_DIRECT_PORT=443
    fi
    HY2_SMART_PORT=$(shuf -i 10000-65535 -n 1)
    HY2_DIRECT_PORT=$(shuf -i 10000-65535 -n 1)
    ARGO_PORT=$(shuf -i 10000-65535 -n 1)
    
    HY2_SMART_PASSWORD=$(generate_random_password)
    HY2_DIRECT_PASSWORD=$(generate_random_password)
    HY2_OBFS_PASSWORD=$(generate_random_password)
    ARGO_UUID=$($SINGBOX_CMD generate uuid) 
    generate_single_reality_credentials REALITY_DIRECT_UUID REALITY_DIRECT_PRIVATE_KEY_FOR_CONFIG REALITY_DIRECT_PUBLIC_KEY REALITY_DIRECT_SHORT_ID
    generate_self_signed_cert

    # 1. 创建配置
    create_config_json
    
    # 2. 检查语法
    info "正在检查配置文件语法..."
    if ! $SINGBOX_CMD check -c "$SINGBOX_CONFIG_FILE"; then
        error "配置文件语法检查失败！"
        exit 1
    fi

    # 3. 启动 Sing-box
    create_systemd_service
    systemctl restart sing-box

    sleep 2
    if ! systemctl is-active --quiet sing-box; then
        error "Sing-box 服务启动失败！"
        journalctl -u sing-box --no-pager -n 20
        exit 1
    else
        success "Sing-box 服务已成功启动。"
    fi
    
    # 4. 启动 Argo
    start_argo_tunnel
    
    # 5. 等待 Argo 连通
    if wait_for_argo_connection; then
        display_and_store_config_info
    else
        error "Argo 隧道建立失败，跳过节点展示。"
    fi
    
    echo
    echo -e "${YELLOW}[重要提醒] 请手动在防火墙放行以下端口：${NC}"
    echo -e "   Reality TCP: ${REALITY_DIRECT_PORT}"
    echo -e "   Hy2 UDP: ${HY2_SMART_PORT}"
    echo -e "   Hy2 UDP: ${HY2_DIRECT_PORT}"
    echo
}

uninstall_singbox() {
    read -p "确定卸载? (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        systemctl stop sing-box
        systemctl disable sing-box
        rm -f "$SINGBOX_SERVICE_FILE" "$SINGBOX_CMD"
        rm -rf "$SINGBOX_CONFIG_DIR"
        rm -rf "$HYSTERIA_CERT_DIR"
        
        info "清理 Cloudflared..."
        pkill -f cloudflared
        (crontab -l | grep -v "cloudflared") | crontab -
        rm -f "$CLOUDFLARED_PATH"
        
        success "卸载完成。"
    fi
}

show_menu() {
    clear
    print_author_info
    echo "1. 安装/重置 所有节点 (Hy2 + Reality + Argo)"
    echo "2. 查看节点链接 (含 Argo 域名刷新)"
    echo "3. 重启 Sing-box 服务"
    echo "4. 卸载"
    echo "0. 退出"
    read -p "选择: " choice
    case "$choice" in
        1) install_all_nodes ;;
        2) display_and_store_config_info ;;
        3) systemctl restart sing-box && success "已重启" ;;
        4) uninstall_singbox ;;
        0) exit 0 ;;
        *) echo "无效" ;;
    esac
    read -p "按回车继续..."
}

check_root
check_dependencies
find_and_set_singbox_cmd
load_persistent_info

while true; do show_menu; done
