  "log": { "level": "error", "timestamp": true },
  "dns": {
    "independent_cache": true, "strategy": "ipv4_only", "final": "cloudflare",
    "servers": [
      { "tag": "cloudflare", "address": "https://1.1.1.1/dns-query", "detour": "direct" }
    ],
    "rules": [
      { "outbound": "any", "server": "cloudflare" }
    ]
  },
  "inbounds": [
    {
      "type": "hysteria2", "tag": "hy2-smart", "listen": "0.0.0.0", "listen_port": ${HY2_SMART_PORT},
      "up_mbps": 0, "down_mbps": 0,
      "users": [ { "password": "${HY2_SMART_PASSWORD}" } ],
      "tls": {
        "enabled": true, "server_name": "${DEFAULT_HYSTERIA_MASQUERADE_CN}",
        "alpn": [ "h2", "http/1.1", "h3" ],
        "certificate_path": "${HYSTERIA_CERT_PEM}", "key_path": "${HYSTERIA_CERT_KEY}"
      }
    },
    {
      "type": "vless", "tag": "reality-smart", "listen": "0.0.0.0", "listen_port": ${REALITY_SMART_PORT},"tcp_fast_open": true,
      "users": [ { "uuid": "${REALITY_SMART_UUID}", "flow": "xtls-rprx-vision" } ],
      "tls": {
        "enabled": true, "server_name": "${DEFAULT_REALITY_SNI}",
        "reality": {
