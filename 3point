REALITY_SMART_SHORT_ID="${REALITY_SMART_SHORT_ID}"
HY2_DIRECT_PORT="${HY2_DIRECT_PORT}"
HY2_DIRECT_PASSWORD="${HY2_DIRECT_PASSWORD}"
WARP_PRIVATE_KEY="${WARP_PRIVATE_KEY}"
WARP_PEER_PUBLIC_KEY="${WARP_PEER_PUBLIC_KEY}"
WARP_ADDRESS="${WARP_ADDRESS}"
WARP_RESERVED="${WARP_RESERVED}"
EOF
    if [ $? -eq 0 ]; then
        success "配置信息保存成功。"
    else
        error "配置信息保存失败。"
    fi
}


check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        error "此脚本需要以 root 权限运行。请使用 'sudo bash $0'"
        exit 1
    fi
}

attempt_install_package() {
    local package_name="$1"
    local friendly_name="${2:-$package_name}"

    # 在某些系统上，wireguard-tools的命令是wg，但包名不同
    if [[ "$package_name" == "wireguard-tools" ]] && command -v wg &>/dev/null; then
        return 0
    fi

    if command -v "$package_name" &>/dev/null; then
        return 0
    fi

    read -p "依赖 '${friendly_name}' 未安装。是否尝试自动安装? (y/N): " install_confirm
    if [[ ! "$install_confirm" =~ ^[Yy]$ ]]; then
        warn "跳过安装 '${friendly_name}'。某些功能可能因此不可用或显示不完整。"
        return 1
    fi

    info "正在尝试安装 '${friendly_name}'..."
    if command -v apt-get &>/dev/null; then
        apt-get update -y && apt-get install -y "$package_name"
    elif command -v yum &>/dev/null; then
        # For CentOS/RHEL, wireguard-tools might be in EPEL repo
        if [[ "$package_name" == "wireguard-tools" ]]; then
            yum install -y epel-release && yum install -y wireguard-tools
        else
             yum install -y "$package_name"
        fi
    elif command -v dnf &>/dev/null; then
        dnf install -y "$package_name"
    else
        error "未找到已知的包管理器 (apt, yum, dnf)。请手动安装 '${friendly_name}'。"
        return 1
    fi

    local check_cmd="$package_name"
    if [[ "$package_name" == "wireguard-tools" ]]; then
        check_cmd="wg"
    fi

    if command -v "$check_cmd" &>/dev/null; then
        success "'${friendly_name}' 安装成功。"
        return 0
    else
        error "'${friendly_name}' 安装失败。请检查错误信息并尝试手动安装。"
        return 1
    fi
}


check_dependencies() {
    info "检查核心依赖..."
    local core_deps=("curl" "openssl" "jq" "lsof")
    local all_deps_met=true
    for dep in "${core_deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            if ! attempt_install_package "$dep"; then
                all_deps_met=false
            fi
        fi
    done

    if ! $all_deps_met; then
        error "部分核心依赖未能安装。脚本可能无法正常运行。请手动安装后重试。"
        exit 1
    fi
    success "核心依赖检查通过。"
}

check_and_prepare_qrencode() {
    if ! command -v qrencode &>/dev/null; then
        if attempt_install_package "qrencode" "二维码生成工具(qrencode)"; then
            return 0
        else
            warn "未安装 'qrencode'。将无法生成二维码。"
            return 1
        fi
    fi
    return 0
}


find_and_set_singbox_cmd() {
    if [ -x "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
        SINGBOX_CMD="$SINGBOX_INSTALL_PATH_EXPECTED"
    elif command -v sing-box &>/dev/null; then
        SINGBOX_CMD=$(command -v sing-box)
    else
        SINGBOX_CMD=""
    fi
    if [ -n "$SINGBOX_CMD" ]; then
        info "Sing-box 命令已设置为: $SINGBOX_CMD"
    else
        warn "初始未找到 Sing-box 命令。"
    fi
}


get_server_ip() {
    SERVER_IP=$(curl -s4 --max-time 5 ip.sb || curl -s4 --max-time 5 https://api.ipify.org || curl -s4 --max-time 5 https://checkip.amazonaws.com)
    if [ -z "$SERVER_IP" ]; then
        warn "无法自动获取服务器公网 IP。你可能需要手动配置客户端。"
        read -p "请输入你的服务器公网 IP (留空则尝试从hostname获取): " MANUAL_SERVER_IP
        if [ -n "$MANUAL_SERVER_IP" ]; then
            SERVER_IP="$MANUAL_SERVER_IP"
        else
            SERVER_IP=$(hostname -I | awk '{print $1}')
            if [ -z "$SERVER_IP" ]; then
                warn "无法从hostname获取IP，请确保网络连接正常或手动输入。"
            fi
        fi
    fi
    info "检测到服务器 IP: ${SERVER_IP}"
    LAST_SERVER_IP="$SERVER_IP"
}

generate_random_password() {
    openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 16
}

install_singbox_core() {
    local target_version="v1.8.0"

    if [ -f "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
        info "Sing-box 已检测到在 $SINGBOX_INSTALL_PATH_EXPECTED."
        current_version=$("$SINGBOX_INSTALL_PATH_EXPECTED" version | awk '{print $3}' 2>/dev/null)
        if [ -n "$current_version" ]; then
            info "当前版本: $current_version"
            if [[ "$current_version" == "$target_version" ]]; then
                read -p "已安装目标版本 ($target_version)。是否仍然重新安装? (y/N): " reinstall_choice
                if [[ ! "$reinstall_choice" =~ ^[Yy]$ ]]; then
                    find_and_set_singbox_cmd
                    return 0
                fi
            else
                warn "当前版本 ($current_version) 与目标版本 ($target_version) 不同。"
                read -p "是否安装/覆盖为目标版本 $target_version? (y/N): " reinstall_choice
                if [[ ! "$reinstall_choice" =~ ^[Yy]$ ]]; then
                    return 0
                fi
            fi
        fi
    fi

    info "正在准备安装 Sing-box (指定版本: $target_version)..."

    local ARCH
    case "$(uname -m)" in
        x86_64) ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        armv7l) ARCH="armv7" ;;
        *) error "不支持的系统架构: $(uname -m)"; return 1 ;;
    esac
    info "检测到系统架构: $ARCH"

    local version_num=${target_version#v}
    local download_url="https://github.com/SagerNet/sing-box/releases/download/${target_version}/sing-box-${version_num}-linux-${ARCH}.tar.gz"
    
    local tmp_dir
    tmp_dir=$(mktemp -d)
    if [ ! -d "$tmp_dir" ]; then
        error "无法创建临时目录"
        return 1
    fi
    
    info "正在从 GitHub Releases 下载: $download_url"
    if ! curl -L -o "${tmp_dir}/sing-box.tar.gz" "$download_url"; then
        error "下载失败。请检查网络或确认链接是否有效。"
        rm -rf "$tmp_dir"
        return 1
    fi
    success "下载成功。"

    info "正在解压文件..."
    if ! command -v tar &> /dev/null; then
        attempt_install_package "tar"
    fi
    if ! tar -xzf "${tmp_dir}/sing-box.tar.gz" -C "$tmp_dir"; then
        error "解压失败。"
        rm -rf "$tmp_dir"
        return 1
    fi

    info "正在安装 sing-box 到 $SINGBOX_INSTALL_PATH_EXPECTED..."
    if ! install -m 755 "${tmp_dir}/sing-box-${version_num}-linux-${ARCH}/sing-box" "$SINGBOX_INSTALL_PATH_EXPECTED"; then
        error "安装失败。请检查权限。"
        rm -rf "$tmp_dir"
        return 1
    fi
    success "Sing-box 版本 $target_version 安装成功。"

    rm -rf "$tmp_dir"
    
    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ]; then
        error "安装后仍无法找到 sing-box 命令。"
        return 1
    fi

    return 0
}

# --- [心脏移植手术] ---
# 全新的、更可靠的 WARP 配置函数 (已修正依赖安装逻辑)
setup_warp() {
    info "正在配置 WARP 出站 (使用更可靠的手动API注册方法)..."

    # 步骤 1: 确保依赖项已安装 (使用通用的安装函数)
    info "步骤 1/4: 检查并安装核心依赖: wireguard-tools, jq..."
    if ! attempt_install_package "wireguard-tools" "WireGuard工具集"; then
        error "依赖项 'wireguard-tools' 安装失败。无法继续配置WARP。"
        return 1
    fi
    if ! attempt_install_package "jq" "JSON处理工具(jq)"; then
        error "依赖项 'jq' 安装失败。无法继续配置WARP。"
        return 1
    fi
    # 再次确认命令是否存在
    if ! command -v wg &>/dev/null || ! command -v jq &>/dev/null; then
        error "依赖项安装后仍无法找到 wg 或 jq 命令。请手动安装后重试。"
        return 1
    fi
    success "WARP所需依赖项已准备就绪。"

    # 步骤 2: 生成全新的密钥对
    info "步骤 2/4: 生成全新的WireGuard密钥对..."
    local PRIVATE_KEY=$(wg genkey)
    local PUBLIC_KEY=$(echo "${PRIVATE_KEY}" | wg pubkey)
    if [ -z "$PRIVATE_KEY" ] || [ -z "$PUBLIC_KEY" ]; then
        error "生成WireGuard密钥失败。"
        return 1
    fi
    success "新密钥对生成成功。"

    # 步骤 3: 手动通过 cURL 向 Cloudflare API 发起注册请求
    info "步骤 3/4: 正在通过API手动注册新的WARP账户..."
    local RESPONSE
    RESPONSE=$(curl -s -X POST \
         -H "Content-Type: application/json" \
         -H "Accept: application/json" \
         -H "User-Agent: okhttp/3.12.1" \
         --data "{\"public_key\":\"${PUBLIC_KEY}\",\"install_id\":\"\",\"fcm_token\":\"\",\"tos\":\"$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")\",\"key\":\"${PUBLIC_KEY}\",\"locale\":\"en_US\",\"type\":\"Android\",\"model\":\"PC\"}" \
         "https://api.cloudflareclient.com/v0a2158/reg")

    # 步骤 4: 解析API响应并设置全局变量
    if [ -n "$RESPONSE" ] && echo "$RESPONSE" | jq -e 'has("config")' > /dev/null; then
        info "步骤 4/4: API注册成功，正在解析配置..."
        WARP_PRIVATE_KEY="$PRIVATE_KEY"
        WARP_PEER_PUBLIC_KEY=$(echo "$RESPONSE" | jq -r '.config.peers[0].public_key')
        WARP_ADDRESS=$(echo "$RESPONSE" | jq -r '.config.interface.addresses.v4')
        WARP_RESERVED="[0,0,0]"
        
        if [ -z "$WARP_PEER_PUBLIC_KEY" ] || [ "$WARP_PEER_PUBLIC_KEY" == "null" ] || [ -z "$WARP_ADDRESS" ] || [ "$WARP_ADDRESS" == "null" ]; then
            error "从API响应中解析配置失败。响应内容: $RESPONSE"
            return 1
        fi
        success "WARP配置已成功获取并设置！"
        save_persistent_info
        return 0
    else
        error "WARP API注册失败。服务器可能无法连接到Cloudflare API或IP信誉不佳。"
        warn "API响应: $RESPONSE"
        return 1
    fi
}

generate_self_signed_cert() {
    local domain_cn="$1"
    if [ -f "$HYSTERIA_CERT_PEM" ] && [ -f "$HYSTERIA_CERT_KEY" ]; then
        info "检测到已存在的证书: ${HYSTERIA_CERT_PEM} 和 ${HYSTERIA_CERT_KEY}"
        existing_cn=$(openssl x509 -in "$HYSTERIA_CERT_PEM" -noout -subject | sed -n 's/.*CN = \([^,]*\).*/\1/p')
        if [ "$existing_cn" == "$domain_cn" ]; then
            info "证书 CN ($existing_cn) 与目标 ($domain_cn) 匹配，跳过重新生成。"
            return 0
        else
            warn "证书 CN ($existing_cn) 与目标 ($domain_cn) 不匹配。"
            read -p "是否使用新的 CN ($domain_cn) 重新生成证书? (y/N): " regen_cert_choice
            if [[ ! "$regen_cert_choice" =~ ^[Yy]$ ]]; then
                info "保留现有证书。"
                return 0
            fi
        fi
    fi

    info "正在为 Hysteria2 生成自签名证书 (CN=${domain_cn})..."
    mkdir -p "$HYSTERIA_CERT_DIR"
    openssl ecparam -genkey -name prime256v1 -out "$HYSTERIA_CERT_KEY"
    openssl req -new -x509 -days 36500 -key "$HYSTERIA_CERT_KEY" -out "$HYSTERIA_CERT_PEM" -subj "/CN=${domain_cn}"
    if [ $? -eq 0 ]; then
        success "自签名证书生成成功。"
    else
        error "自签名证书生成失败。"
        return 1
    fi
}

generate_single_reality_credentials() {
    local -n _uuid=$1
    local -n _private_key=$2
    local -n _public_key=$3
    local -n _short_id=$4

    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ]; then
        error "Sing-box command 未设置。无法生成凭证。"
        return 1
    fi
    
    _uuid=$($SINGBOX_CMD generate uuid)
    if [ $? -ne 0 ] || [ -z "$_uuid" ]; then
        error "执行 '$SINGBOX_CMD generate uuid' 失败或输出为空。"
        return 1
    fi

    local KEY_PAIR_OUTPUT
    KEY_PAIR_OUTPUT=$($SINGBOX_CMD generate reality-keypair)
    if [ $? -ne 0 ] || [ -z "$KEY_PAIR_OUTPUT" ]; then
        error "执行 '$SINGBOX_CMD generate reality-keypair' 失败或输出为空。"
        return 1
    fi
    
    _private_key=$(echo "$KEY_PAIR_OUTPUT" | awk -F': ' '/PrivateKey:/ {print $2}' | xargs)
    _public_key=$(echo "$KEY_PAIR_OUTPUT" | awk -F': ' '/PublicKey:/ {print $2}' | xargs)
    _short_id=$(openssl rand -hex 8)

    if [ -z "$_uuid" ] || [ -z "$_private_key" ] || [ -z "$_public_key" ] || [ -z "$_short_id" ]; then
        error "生成 Reality凭证失败 (UUID, Key, 或 ShortID 在解析后为空)."
        return 1
    fi
}

