install_all_nodes() {
    info "开始部署三节点混合策略配置..."
    install_singbox_core || return 1
    get_server_ip
    setup_warp || return 1 # 调用新的WARP函数

    info "正在检查 Reality 节点所需端口 (443)..."
    if lsof -i:443 -sTCP:LISTEN >/dev/null ; then
        error "端口 443 已被占用。请先停止占用该端口的程序 (如 Nginx, Caddy) 再运行本脚本。"
        return 1
    fi
    success "Reality 端口 (443) 可用。"
    REALITY_SMART_PORT=443

    info "正在为2个 Hysteria2 节点生成独立凭证和随机端口..."
    HY2_SMART_PASSWORD=$(generate_random_password)
    HY2_DIRECT_PASSWORD=$(generate_random_password)
    success "已生成 2 套 Hysteria2 独立密码。"

    local hy2_ports=()
    while [ ${#hy2_ports[@]} -lt 2 ]; do
        local random_port=$(shuf -i 10000-65535 -n 1)
        if ! lsof -i:"$random_port" >/dev/null && ! [[ " ${hy2_ports[@]} " =~ " ${random_port} " ]]; then
            hy2_ports+=("$random_port")
        fi
    done
    HY2_SMART_PORT=${hy2_ports[0]}
    HY2_DIRECT_PORT=${hy2_ports[1]}
    success "已生成 2 个 Hysteria2 独立端口: ${hy2_ports[*]}"

    info "正在为 Reality 节点生成独立凭证..."
    generate_single_reality_credentials REALITY_SMART_UUID REALITY_SMART_PRIVATE_KEY_FOR_CONFIG REALITY_SMART_PUBLIC_KEY REALITY_SMART_SHORT_ID || return 1
    success "已生成 1 套 Reality 独立凭证 (UUID, KeyPair, ShortID)。"

    info "正在处理 Hysteria2 共享证书..."
    generate_self_signed_cert "$DEFAULT_HYSTERIA_MASQUERADE_CN" || return 1
    
    create_config_json || return 1
    
    create_systemd_service
    start_singbox_service || return 1

    success "三节点混合策略配置部署完成！"
    display_and_store_config_info
}

show_current_import_info() {
    info "显示上次保存的配置信息:"
    display_and_store_config_info
}

uninstall_singbox() {
    warn "你确定要卸载 Sing-box 吗?"
    read -p "此操作将停止并禁用服务，删除可执行文件和相关配置文件目录。是否继续卸载? (y/N): " confirm_uninstall
    if [[ ! "$confirm_uninstall" =~ ^[Yy]$ ]]; then
        info "卸载已取消。"
        return
    fi

    info "正在停止 sing-box 服务..."
    systemctl stop sing-box &>/dev/null
    info "正在禁用 sing-box 服务..."
    systemctl disable sing-box &>/dev/null

    if [ -f "$SINGBOX_SERVICE_FILE" ]; then
        info "正在删除 systemd 服务文件: ${SINGBOX_SERVICE_FILE}"
        rm -f "$SINGBOX_SERVICE_FILE"
        systemctl daemon-reload
    fi

    find_and_set_singbox_cmd
    local singbox_exe_to_remove="$SINGBOX_CMD"
    
    if [ -z "$singbox_exe_to_remove" ]; then
        if [ -f "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
            singbox_exe_to_remove="$SINGBOX_INSTALL_PATH_EXPECTED"
        fi
    fi

    if [ -n "$singbox_exe_to_remove" ] && [ -f "$singbox_exe_to_remove" ]; then
        info "正在删除 sing-box 执行文件: $singbox_exe_to_remove"
        rm -f "$singbox_exe_to_remove"
    else
        warn "未找到明确的 sing-box 执行文件进行删除。"
    fi
    
    read -p "是否删除配置文件目录 ${SINGBOX_CONFIG_DIR} (包含导入信息缓存)? (y/N): " delete_config_dir_confirm
    if [[ "$delete_config_dir_confirm" =~ ^[Yy]$ ]]; then
        if [ -d "$SINGBOX_CONFIG_DIR" ]; then
            info "正在删除配置目录..."
            rm -rf "$SINGBOX_CONFIG_DIR"
        fi
    fi
    
    read -p "是否删除 Hysteria2 证书目录 ${HYSTERIA_CERT_DIR}? (y/N): " delete_cert_dir_confirm
     if [[ "$delete_cert_dir_confirm" =~ ^[Yy]$ ]]; then
        if [ -d "$HYSTERIA_CERT_DIR" ]; then
            info "正在删除 Hysteria2 证书目录..."
            rm -rf "$HYSTERIA_CERT_DIR"
        fi
    fi

    success "Sing-box 卸载完成。"
    # 清理内存中的变量，避免在当前会话中意外使用
    HY2_SMART_PORT="" HY2_SMART_PASSWORD="" REALITY_SMART_PORT="" REALITY_SMART_UUID="" REALITY_SMART_PUBLIC_KEY="" REALITY_SMART_SHORT_ID=""
    HY2_DIRECT_PORT="" HY2_DIRECT_PASSWORD=""
    rm -f "$PERSISTENT_INFO_FILE"
}

manage_singbox() {
    local action=$1
    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ] && [[ "$action" != "start" && "$action" != "stop" ]]; then
        error "无法找到 Sing-box command. 操作中止。"
        return 1
    fi

    case "$action" in
        start|stop|restart|status)
            if [[ "$action" == "restart" ]]; then
                if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                    info "重启前检查配置文件..."
                    if ! $SINGBOX_CMD check -c "$SINGBOX_CONFIG_FILE"; then
                        error "配置文件检查失败，无法重启。请先修复配置文件。"
                        return 1
                    fi
                    success "配置文件检查通过。"
                fi
            fi
            systemctl "$action" sing-box
            if [[ "$action" != "status" ]]; then sleep 1; fi
            if systemctl is-active --quiet sing-box; then
                success "操作成功，服务正在运行。"
            elif [[ "$action" == "stop" ]]; then
                 success "操作成功，服务已停止。"
            else
                warn "操作可能未成功或服务未运行。"
            fi
            ;;
        log)
            journalctl -u sing-box -f --no-pager -n 50
            ;;
        view_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                info "当前配置文件 (${SINGBOX_CONFIG_FILE}):"
                if command -v jq &>/dev/null; then
                    jq . "$SINGBOX_CONFIG_FILE"
                else
                    cat "$SINGBOX_CONFIG_FILE"
                fi
            else
                error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"
            fi
            ;;
        edit_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                if command -v nano &> /dev/null; then
                    nano "$SINGBOX_CONFIG_FILE"
                elif command -v vim &> /dev/null; then
                    vim "$SINGBOX_CONFIG_FILE"
                else
                    error "'nano' 或 'vim' 编辑器未安装。请手动编辑: ${SINGBOX_CONFIG_FILE}"
                    return
                fi
                read -p "配置文件已编辑，是否立即重启 sing-box 服务? (y/N): " restart_confirm
                if [[ "$restart_confirm" =~ ^[Yy]$ ]]; then
                    manage_singbox "restart"
                fi
            else
                error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"
            fi
            ;;
        *)
            error "无效的管理操作: $action"
            ;;
    esac
}

show_menu() {
    clear 
    print_author_info

    echo -e "${GREEN}${BOLD}安装选项:${NC}"
    echo "  1. 安装/重置 三节点混合策略配置"
    echo "------------------------------------------------"
    echo -e "${YELLOW}${BOLD}管理选项:${NC}"
    echo "  2. 启动 Sing-box 服务"
    echo "  3. 停止 Sing-box 服务"
    echo "  4. 重启 Sing-box 服务"
    echo "  5. 查看 Sing-box 服务状态"
    echo "  6. 查看 Sing-box 实时日志"
    echo "  7. 查看当前配置文件 (格式化输出)"
    echo "  8. 编辑当前配置文件 (nano/vim)"
    echo "  9. 显示所有节点导入信息 (含二维码)"
    echo "------------------------------------------------"
    echo -e "${RED}${BOLD}其他选项:${NC}"
    echo "  10. 检查/安装 Sing-box 内核 (v1.8.0)"
    echo "  11. 卸载 Sing-box"
    echo "  0. 退出脚本"
    echo "================================================"
    read -p "请输入选项 [0-11]: " choice

    case "$choice" in
        1) install_all_nodes ;;
        2) manage_singbox "start" ;;
        3) manage_singbox "stop" ;;
        4) manage_singbox "restart" ;;
        5) manage_singbox "status" ;;
        6) manage_singbox "log" ;;
        7) manage_singbox "view_config" ;;
        8) manage_singbox "edit_config" ;;
        9) show_current_import_info ;;
        10) install_singbox_core && manage_singbox "restart" ;;
        11) uninstall_singbox ;;
        0) exit 0 ;;
        *) error "无效选项，请输入 0 到 11 之间的数字。" ;;
    esac
    echo
}

