        }
      },
    "multiplex": {
        "enabled": true,"padding": true,
        "brutal": {
          "enabled": true,
          "up_mbps": 500,
          "down_mbps": 60
        }
      }
    },
    {
      "type": "hysteria2", "tag": "hy2-direct", "listen": "0.0.0.0", "listen_port": ${HY2_DIRECT_PORT},
      "up_mbps": 0, "down_mbps": 0,
      "users": [ { "password": "${HY2_DIRECT_PASSWORD}" } ],
      "tls": {
        "enabled": true, "server_name": "${DEFAULT_HYSTERIA_MASQUERADE_CN}",
        "alpn": [ "h2", "http/1.1", "h3" ],
        "certificate_path": "${HYSTERIA_CERT_PEM}", "key_path": "${HYSTERIA_CERT_KEY}"
      }
    }
  ],
  "outbounds": [
    {
      "type": "wireguard", "tag": "warp-out",
      "local_address": [ "${WARP_ADDRESS}/32" ],
      "private_key": "${WARP_PRIVATE_KEY}",
      "peer_public_key": "${WARP_PEER_PUBLIC_KEY}",
      "server": "162.159.192.1", "server_port": 2408, "mtu": 1420, "reserved": ${WARP_RESERVED},
      "domain_strategy": "ipv4_only"
    },
    { "type": "dns", "tag": "dns-out" },
    { "type": "direct", "tag": "direct", "domain_strategy": "ipv4_only" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      },
      {
