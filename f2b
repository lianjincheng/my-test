#!/bin/bash

# =========================================================
#  Fail2ban 一键安装与加固脚本 (Systemd 优化版)
#  功能: 自动安装、配置增量封禁、修正后端为 Systemd
#  环境: Debian / Ubuntu
# =========================================================

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info() { echo -e "${CYAN}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# --- 检查 Root 权限 ---
if [ "$(id -u)" -ne 0 ]; then
    error "请使用 root 权限运行此脚本 (sudo bash ...)"
    exit 1
fi

# --- 1. 安装依赖与软件 ---
info "正在更新软件源并安装 Fail2ban..."
apt-get update -y
# 关键：先安装 python3-systemd，防止 fail2ban 启动时找不到 systemd 模块
apt-get install -y python3-systemd fail2ban

if ! command -v fail2ban-client &>/dev/null; then
    error "Fail2ban 安装失败，请检查网络或源设置。"
    exit 1
fi
success "Fail2ban 安装完成。"

# --- 2. 写入配置文件 (jail.local) ---
# 采用直接写入新文件的方式，比修改原文件更稳定，且方便管理
info "正在写入加固配置文件 /etc/fail2ban/jail.local ..."

cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
# --- 核心后端设置 (解决无法启动问题) ---
# 现代 Linux 发行版通常使用 systemd 记录日志
backend = systemd

# --- 封禁时间递增机制 (惩罚累加) ---
# 开启递增：被封次数越多，封禁时间越长
bantime.increment = true
# 递增因子：每次封禁时间 = 基础时间 * 因子 * 次数 (这里简化为线性或指数)
bantime.factor = 1
# 最大封禁时间：封太久也没必要，设为 10 周
bantime.maxtime = 10w

# --- 基础策略设置 ---
# 忽略的 IP (白名单)：把你自己的 IP 或者本地 IP 加进去，防止误封
ignoreip = 127.0.0.1/8 ::1

# 封禁时长：1 天 (让攻击者冷静冷静)
bantime = 1d

# 判定窗口：30 分钟 (30分钟内输错 N 次即被封)
findtime = 30m

# 最大尝试次数：3 次 (事不过三，SSH 密钥登录一般一次都不会错)
maxretry = 3

# --- SSH 监狱设置 ---
[sshd]
enabled = true
# 端口：如果你改了 SSH 端口，Fail2ban 会自动检测 sshd_config，通常不用手动改
# 但为了保险，可以设为 'ssh' 或者你具体的端口号，如 '22222'
port    = ssh
logpath = %(sshd_log)s
backend = %(sshd_backend)s
EOF

success "配置文件写入完成。"

# --- 3. 重启与验证 ---
info "正在重启 Fail2ban 服务..."
systemctl restart fail2ban
systemctl enable fail2ban >/dev/null 2>&1

sleep 2

# 检查服务状态
if systemctl is-active --quiet fail2ban; then
    success "Fail2ban 启动成功！"
    echo
    echo -e "${YELLOW}=== 当前运行状态 ===${NC}"
    fail2ban-client status
    echo
    echo -e "${YELLOW}=== SSH 监狱状态 ===${NC}"
    fail2ban-client status sshd
    echo
    echo -e "${GREEN}安装与配置全部完成！您的 SSH 现在固若金汤。${NC}"
else
    error "Fail2ban 启动失败！请运行 'sudo systemctl status fail2ban' 查看详细错误。"
    # 尝试输出最后几行日志帮助排错
    journalctl -u fail2ban --no-pager -n 10
    exit 1
fi
