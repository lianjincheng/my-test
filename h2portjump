#!/bin/bash

# =========================================================
#  Hysteria2 端口跳跃管理脚本 (终极修复版 v3)
#  Fix: 修复 ufw reload 不加载 NAT 表的 Bug，改为手动注入
# =========================================================

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

UFW_RULES_FILE="/etc/ufw/before.rules"
BACKUP_DIR="/root/ufw_backup"

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }

# --- 检查 Root 权限 ---
check_root() { if [ "$(id -u)" -ne 0 ]; then error "请使用 sudo 或 root 权限运行此脚本"; exit 1; fi; }

# --- 检查并强制开启 UFW ---
check_and_enable_ufw() {
    if ! command -v ufw &> /dev/null; then error "系统未检测到 UFW 防火墙！请先安装: apt update && apt install ufw"; exit 1; fi
    while ! ufw status | grep -q "Status: active"; do
        warn "检测到 UFW 防火墙已安装但【未开启】(inactive)。"
        read -p "端口跳跃必须开启防火墙，是否现在开启? (y/n): " e;
        if [[ "$e" =~ ^[Yy]$ ]]; then echo "y" | ufw enable; sleep 1; else error "脚本终止。UFW 未开启。"; exit 1; fi
    done
    success "UFW 状态正常: active"
}

# --- 生成 100% 安全的随机空闲端口范围 ---
get_random_range() {
    local start_port; local busy_ports=$(netstat -tunlp | awk '{print $4}' | grep -oE '[0-9]+$');
    while true; do
        start_port=$(shuf -i 20000-60000 -n 1); local end_port=$((start_port + 49)); local is_clean=true;
        for (( port=start_port; port<=end_port; port++ )); do
            if echo "$busy_ports" | grep -q -w "$port"; then is_clean=false; break; fi
        done
        if $is_clean; then echo "$start_port"; break; fi
    done
}

# --- 外科手术式清理旧规则 ---
surgical_cleanup() {
    info "正在执行精准规则清理 (保护 Docker 映射)..."
    if grep -q "HY2-PORT-HOPPING-START" $UFW_RULES_FILE; then
        local old_range=$(grep -A 5 "HY2-PORT-HOPPING-START" $UFW_RULES_FILE | grep "\-\-dport" | grep -oE "[0-9]+:[0-9]+" | head -n 1)
        local old_target=$(grep -A 5 "HY2-PORT-HOPPING-START" $UFW_RULES_FILE | grep "\-\-to-ports" | awk '{print $NF}' | head -n 1)
        if [[ -n "$old_range" && -n "$old_target" ]]; then
            info "发现旧规则: 范围 $old_range -> 目标 $old_target"
            while iptables -t nat -D PREROUTING -p udp --dport "$old_range" -j REDIRECT --to-ports "$old_target" 2>/dev/null; do
                success "已从内存中移除一条旧 NAT 规则。"
            done
            info "正在删除 UFW 放行规则: ${old_range}/udp"
            ufw delete allow "${old_range}/udp" >/dev/null 2>&1
        fi
        info "正在清理 NAT 配置文件..."
        sed -i '/# --- HY2-PORT-HOPPING-START ---/,/# --- HY2-PORT-HOPPING-END ---/d' $UFW_RULES_FILE
    fi
}

# --- 功能 1: 添加端口跳跃 ---
add_hopping() {
    check_and_enable_ufw
    echo -e "${CYAN}--- 配置 Hysteria2 端口跳跃 (100% 安全扫描) ---${NC}"
    while true; do
        read -p "请输入当前 Hysteria2 节点的监听端口 (必填): " hy2_port
        if [[ -n "$hy2_port" && "$hy2_port" =~ ^[0-9]+$ ]] && [ "$hy2_port" -le 65535 ]; then break; else error "请输入有效的端口号!"; fi
    done

    info "正在智能扫描未被占用的连续 50 个端口..."
    local default_start=$(get_random_range)
    local default_end=$((default_start + 49))
    local default_range_client_format="${default_start}-${default_end}"
    local default_range_iptables_format="${default_start}:${default_end}"

    echo -e "请输入跳跃端口范围 (格式: 50000-50050 或 50000:50050)"
    echo -e "已为你扫描出可用范围: ${GREEN}${default_range_client_format}${NC}"
    read -p "请直接回车使用此范围，或手动输入: " input_range

    local target_range_client=""
    local target_range_iptables=""
    if [ -z "$input_range" ]; then
        target_range_client="$default_range_client_format"
        target_range_iptables="$default_range_iptables_format"
    else
        input_range_normalized=$(echo "$input_range" | sed 's/-/:/')
        if [[ "$input_range_normalized" =~ ^[0-9]+:[0-9]+$ ]]; then
            target_range_iptables="$input_range_normalized"
            target_range_client=$(echo "$input_range_normalized" | sed 's/:/-/')
        else
            error "格式错误"; return
        fi
    fi

    local range_start=$(echo $target_range_iptables | cut -d: -f1)
    local range_end=$(echo $target_range_iptables | cut -d: -f2)

    echo -e "\n${YELLOW}即将应用配置:${NC}"
    echo "  Hy2 目标端口: $hy2_port"
    echo "  跳跃端口范围: $target_range_client (UDP)"
    read -p "确认继续吗? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then echo "已取消"; return; fi

    surgical_cleanup
    info "正在配置 UFW 放行新端口范围..."
    ufw allow "${target_range_iptables}/udp" >/dev/null

    info "正在写入 UFW 配置文件 (用于持久化)..."
    mkdir -p $BACKUP_DIR
    cp $UFW_RULES_FILE "${BACKUP_DIR}/before.rules.$(date +%F_%T).bak"
    
    local nat_rules_block="# --- HY2-PORT-HOPPING-START ---
*nat
:PREROUTING ACCEPT [0:0]
-A PREROUTING -p udp --dport ${target_range_iptables} -j REDIRECT --to-ports ${hy2_port}
COMMIT
# --- HY2-PORT-HOPPING-END ---"

    local current_rules=$(cat $UFW_RULES_FILE)
    echo "$nat_rules_block" > "$UFW_RULES_FILE"
    echo "$current_rules" >> "$UFW_RULES_FILE"
    
    # [修复] 不再依赖 ufw reload，手动将规则注入内存
    info "正在将 NAT 规则注入内核内存 (立即生效)..."
    iptables -t nat -A PREROUTING -p udp --dport ${target_range_iptables} -j REDIRECT --to-ports ${hy2_port}
    
    # 验证规则是否成功注入
    if iptables -t nat -C PREROUTING -p udp --dport ${target_range_iptables} -j REDIRECT --to-ports ${hy2_port} 2>/dev/null; then
        success "端口跳跃配置完成！规则已立即生效。"
        echo
        echo -e "${GREEN}当前 NAT 规则验证:${NC}"
        iptables -t nat -L PREROUTING -n -v --line-numbers | grep "dpts:${range_start}:${range_end}"
    else
        error "NAT 规则注入失败！"
        warn "正在尝试回滚..."
        cp "${BACKUP_DIR}/before.rules.$(date +%F_%T).bak" $UFW_RULES_FILE
        surgical_cleanup
        ufw reload
        error "回滚完成。请检查系统日志。"
        exit 1
    fi
}

# --- 功能 2: 显示规则 ---
show_rules() {
    check_and_enable_ufw
    echo "  Hy2 目标端口: $hy2_port"
    echo "  跳跃端口范围: $target_range_client (UDP)"
    echo -e "${CYAN}--- 当前端口跳跃规则状态 ---${NC}"
    echo -e "\n${YELLOW}[1] 配置文件内容 ($UFW_RULES_FILE):${NC}"
    if grep -q "HY2-PORT-HOPPING-START" $UFW_RULES_FILE; then sed -n '/HY2-PORT-HOPPING-START/,/HY2-PORT-HOPPING-END/p' $UFW_RULES_FILE; else echo "未发现脚本管理的跳跃配置。"; fi
    echo -e "\n${YELLOW}[2] 内存中生效的 REDIRECT 规则:${NC}"
    iptables -t nat -L PREROUTING -n -v --line-numbers | grep "REDIRECT"
    echo -e "\n${YELLOW}[3] UFW 放行状态:${NC}"
    ufw status verbose
}

# --- 功能 3: 删除规则 ---
remove_all() {
    check_and_enable_ufw; echo -e "${RED}警告：这将清除由本脚本添加的所有端口跳跃设置！${NC}"
    read -p "确定要清空还原吗? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then echo "已取消"; return; fi
    surgical_cleanup
    # 清理完 NAT 文件后，执行一次 reload 让其从内存中也消失
    ufw reload > /dev/null
    success "清理完成。请再次运行 'ufw status' 确认。"
}

# --- 主菜单 ---
show_menu() {
    clear
    echo -e "${CYAN}==============================================${NC}"
    echo -e "${GREEN}  Hysteria2 端口跳跃助手 (终极修复版)  ${NC}"
    echo -e "${CYAN}==============================================${NC}"
    echo -e "1. 添加/重置 端口跳跃 (Add Hopping)"
    echo -e "2. 查看 当前规则状态 (Show Rules)"
    echo -e "3. 删除 所有跳跃配置 (Remove All)"
    echo -e "0. 退出脚本 (Exit)"
    echo -e "----------------------------------------------"
    read -p "请输入选项 [0-3]: " choice
    case "$choice" in 1) add_hopping ;; 2) show_rules ;; 3) remove_all ;; 0) exit 0 ;; *) error "无效输入";; esac
    echo; read -p "按回车键返回菜单..."
}

# --- 运行入口 ---
check_root
if ! command -v netstat &>/dev/null; then
    apt-get update -y && apt-get install -y net-tools >/dev/null 2>&1
fi
while true; do show_menu; done
