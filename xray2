#!/bin/bash

# =========================================================
#  Xray 双协议管理脚本 (V5 终极重构版)
#  UI: 恢复原版经典界面
#  Fix: 彻底修复 JSON 语法错误 (采用预组装模式)
#  Feature: 入口即出口 (严格分流) + 防偷跑 + 大流量伪装
#  SNI: www.icloud.com | Port: 65535 (Local)
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/root/xray_dual_node"
CONFIG_FILE="${INSTALL_DIR}/config.json"
XRAY_BIN="${INSTALL_DIR}/xray"
SERVICE_FILE="/etc/systemd/system/xray-dual.service"
INFO_FILE="${INSTALL_DIR}/.xray_dual_info"

# 默认伪装域名
DEFAULT_REALITY_SNI="www.icloud.com"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 变量初始化 ---
UUID=""
PORT_XHTTP="8443"
PORT_VISION="443"
PORT_LO="65535"
PRIVATE_KEY=""
PUBLIC_KEY=""
SHORT_ID=""
REALITY_SNI=""
IPV4_ADDR=""
IPV6_ADDR=""

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

check_root() { if [[ $EUID -ne 0 ]]; then error "请使用 root 权限"; exit 1; fi; }

force_cleanup() {
    systemctl stop xray-dual >/dev/null 2>&1
    systemctl disable xray-dual >/dev/null 2>&1
    # 清理旧服务名防止冲突
    systemctl stop xray-vision >/dev/null 2>&1
    systemctl disable xray-vision >/dev/null 2>&1
    systemctl stop xray-xhttp >/dev/null 2>&1
    systemctl disable xray-xhttp >/dev/null 2>&1
    
    local pid=$(pgrep -f "${XRAY_BIN}")
    if [ -n "$pid" ]; then kill -9 $pid >/dev/null 2>&1; fi
    rm -rf "${INSTALL_DIR}"
}

check_dependencies() {
    local deps=("curl" "wget" "tar" "jq" "openssl" "unzip" "net-tools")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            info "安装依赖: $dep"
            if command -v apt-get &>/dev/null; then apt-get update -y && apt-get install -y "$dep"
            elif command -v yum &>/dev/null; then yum install -y "$dep"; fi
        fi
    done
}

check_port_443() {
    if netstat -tlunp | grep -w ":443" > /dev/null 2>&1; then
        error "443 端口被占用！请先停止 Nginx/Apache。"
        echo -e "${YELLOW}占用详情:${NC}"
        netstat -tlunp | grep -w ":443"
        exit 1
    fi
}

save_info() {
    mkdir -p "${INSTALL_DIR}"
    cat > "$INFO_FILE" <<EOF
UUID="${UUID}"
PORT_XHTTP="${PORT_XHTTP}"
PORT_VISION="${PORT_VISION}"
PRIVATE_KEY="${PRIVATE_KEY}"
PUBLIC_KEY="${PUBLIC_KEY}"
SHORT_ID="${SHORT_ID}"
REALITY_SNI="${REALITY_SNI}"
IPV4_ADDR="${IPV4_ADDR}"
IPV6_ADDR="${IPV6_ADDR}"
EOF
}

load_info() {
    if [ -f "$INFO_FILE" ]; then source "$INFO_FILE"; return 0; else return 1; fi
}

# --- 稳健的 IP 获取 ---
get_ip() {
    # 使用 icanhazip 获取纯文本 IP，并过滤掉所有非 IP 字符
    IPV4_ADDR=$(curl -s4m5 https://ipv4.icanhazip.com -k | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n1)
    IPV6_ADDR=$(curl -s6m5 https://ipv6.icanhazip.com -k | grep -Eo '([a-f0-9:]+:+)+[a-f0-9]+' | head -n1)

    info "IPv4: $IPV4_ADDR"
    info "IPv6: $IPV6_ADDR"
}

# --- 核心：安装逻辑 ---
install_node() {
    force_cleanup
    check_dependencies
    check_port_443
    mkdir -p "$INSTALL_DIR"
    
    info "下载 Xray 官方内核..."
    local ARCH=$(uname -m)
    local DOWNLOAD_URL=""
    case "$ARCH" in
        aarch64) DOWNLOAD_URL="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-arm64-v8a.zip" ;;
        x86_64) DOWNLOAD_URL="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip" ;;
        *) error "不支持的架构: $ARCH"; exit 1 ;;
    esac

    wget -O "${INSTALL_DIR}/xray.zip" "$DOWNLOAD_URL" --tries=3
    unzip -o "${INSTALL_DIR}/xray.zip" -d "$INSTALL_DIR" >/dev/null 2>&1
    chmod +x "$XRAY_BIN"

    get_ip
    
    info "生成配置参数..."
    # 使用内核命令生成 UUID，绝对纯净
    if [ -f /proc/sys/kernel/random/uuid ]; then
        UUID=$(cat /proc/sys/kernel/random/uuid | tr -d '\n\r')
    else
        UUID=$("$XRAY_BIN" uuid)
    fi

    local KEY_PAIR=$("$XRAY_BIN" x25519)
    PRIVATE_KEY=$(echo "$KEY_PAIR" | grep "PrivateKey" | awk '{print $2}' | tr -d '\n\r')
    PUBLIC_KEY=$(echo "$KEY_PAIR" | grep "Password" | awk '{print $2}' | tr -d '\n\r')
    SHORT_ID=$(openssl rand -hex 4 | tr -d '\n\r')
    REALITY_SNI="$DEFAULT_REALITY_SNI"

    #while true; do
        #PORT_XHTTP=$(shuf -i 10000-65534 -n 1)
        #if [ "$PORT_XHTTP" != "443" ]; then break; fi
    #done

    # ==========================================
    #  配置组装区 (解决 JSON 逗号问题的核心)
    # ==========================================
    
    # 1. Dokodemo (本地回环) - 始终存在
    local INBOUND_DOKODEMO='{
      "tag": "dokodemo-in",
      "listen": "127.0.0.1",
      "port": '$PORT_LO',
      "protocol": "dokodemo-door",
      "settings": { "address": "'$REALITY_SNI'", "port": 443, "network": "tcp" },
      "sniffing": { "enabled": true, "destOverride": ["tls"], "routeOnly": true }
    }'

    # 2. IPv4 配置块
    local INBOUND_V4=""
    if [ -n "$IPV4_ADDR" ]; then
        INBOUND_V4=',{
            "tag": "xhttp-v4",
            "listen": "'$IPV4_ADDR'",
            "port": '$PORT_XHTTP',
            "protocol": "vless",
            "settings": { "clients": [ { "id": "'$UUID'", "flow": "" } ], "decryption": "none" },
            "streamSettings": {
                "network": "xhttp",
                "security": "reality",
                "realitySettings": {
                    "fingerprint": "chrome",
                    "dest": "127.0.0.1:'$PORT_LO'",
                    "serverNames": [ "'$REALITY_SNI'" ],
                    "privateKey": "'$PRIVATE_KEY'",
                    "shortIds": ["'$SHORT_ID'"],"spiderX": "/"
                },
                "xhttpSettings": { "path": "'$UUID'-xh", "mode": "auto" }
            },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "metadataOnly": false }
        },
        {
            "tag": "vision-v4",
            "listen": "'$IPV4_ADDR'",
            "port": '$PORT_VISION',
            "protocol": "vless",
            "settings": { "clients": [ { "id": "'$UUID'", "flow": "xtls-rprx-vision" } ], "decryption": "none" },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "fingerprint": "chrome",
                    "dest": "127.0.0.1:'$PORT_LO'",
                    "serverNames": [ "'$REALITY_SNI'" ],
                    "privateKey": "'$PRIVATE_KEY'",
                    "shortIds": ["'$SHORT_ID'"],"spiderX": "/"
                }
            },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "metadataOnly": false }
        }'
    fi

    # 3. IPv6 配置块
    local INBOUND_V6=""
    if [ -n "$IPV6_ADDR" ]; then
        INBOUND_V6=',{
            "tag": "xhttp-v6",
            "listen": "'$IPV6_ADDR'",
            "port": '$PORT_XHTTP',
            "protocol": "vless",
            "settings": { "clients": [ { "id": "'$UUID'", "flow": "" } ], "decryption": "none" },
            "streamSettings": {
                "network": "xhttp",
                "security": "reality",
                "realitySettings": {
                    "fingerprint": "chrome",
                    "dest": "127.0.0.1:'$PORT_LO'",
                    "serverNames": [ "'$REALITY_SNI'" ],
                    "privateKey": "'$PRIVATE_KEY'",
                    "shortIds": ["'$SHORT_ID'"],"spiderX": "/"
                },
                "xhttpSettings": { "path": "'$UUID'-xh", "mode": "auto" }
            },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "metadataOnly": false }
        },
        {
            "tag": "vision-v6",
            "listen": "'$IPV6_ADDR'",
            "port": '$PORT_VISION',
            "protocol": "vless",
            "settings": { "clients": [ { "id": "'$UUID'", "flow": "xtls-rprx-vision" } ], "decryption": "none" },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "fingerprint": "chrome",
                    "dest": "127.0.0.1:'$PORT_LO'",
                    "serverNames": [ "'$REALITY_SNI'" ],
                    "privateKey": "'$PRIVATE_KEY'",
                    "shortIds": ["'$SHORT_ID'"],"spiderX": "/"
                }
            },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "metadataOnly": false }
        }'
    fi

    # --- 最终写入 config.json ---
    # 利用变量拼接，避免了 cat EOF 的语法陷阱
    
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "error" },
  "dns": { "servers": ["1.1.1.1", "8.8.8.8"] },
  "inbounds": [
    $INBOUND_DOKODEMO
    $INBOUND_V4
    $INBOUND_V6
  ],
  "outbounds": [
    { "tag": "direct-v4", "protocol": "freedom", "settings": { "domainStrategy": "UseIPv4" } },
    { "tag": "direct-v6", "protocol": "freedom", "settings": { "domainStrategy": "UseIPv6" } },
    { "protocol": "blackhole", "tag": "block" }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      { "inboundTag": ["dokodemo-in"], "domain": ["$REALITY_SNI"], "outboundTag": "direct-v4" },
      { "inboundTag": ["dokodemo-in"], "outboundTag": "block" },
      { "inboundTag": ["xhttp-v4", "vision-v4"], "outboundTag": "direct-v4" },
      { "inboundTag": ["xhttp-v6", "vision-v6"], "outboundTag": "direct-v6" }
    ]
  }
}
EOF

    # 验证
    if ! "$XRAY_BIN" run -test -c "$CONFIG_FILE" >/dev/null 2>&1; then
        error "配置文件依然有误，请手动检查 config.json"
        "$XRAY_BIN" run -test -c "$CONFIG_FILE"
        exit 1
    fi

    # 配置 Systemd
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Xray Dual Service
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${XRAY_BIN} run -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray-dual >/dev/null 2>&1
    systemctl restart xray-dual
    
    save_info
    
    sleep 2
    if systemctl is-active --quiet xray-dual; then
        success "安装成功！双栈严格分流模式已生效。"
        display_info
    else
        error "服务启动失败！"
        journalctl -u xray-dual --no-pager -n 10
    fi
}

# --- 显示信息 ---
display_info() {
    load_info
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 节点 1: XHTTP-Reality (伪装: ${REALITY_SNI})${NC}"
    echo -e " Port: ${PORT_XHTTP} | Path: ${UUID}-xh "
    local P_XH=":${PORT_XHTTP}?encryption=none&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=xhttp&path=${UUID}-xh&mode=auto"
    
    if [ -n "$IPV4_ADDR" ]; then
        echo -e "${YELLOW}vless://${UUID}@${IPV4_ADDR}${P_XH}#XHTTP-IPv4${NC}"
    fi
    if [ -n "$IPV6_ADDR" ]; then
        echo -e "${YELLOW}vless://${UUID}@[${IPV6_ADDR}]${P_XH}#XHTTP-IPv6${NC}"
    fi
    echo
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 节点 2: Vision-Reality (伪装: ${REALITY_SNI})${NC}"
    echo -e " Port: ${PORT_VISION} | Flow: xtls-rprx-vision "
    local P_VS=":${PORT_VISION}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=tcp&headerType=none"

    if [ -n "$IPV4_ADDR" ]; then
        echo -e "${YELLOW}vless://${UUID}@${IPV4_ADDR}${P_VS}#Vision-IPv4${NC}"
    fi
    if [ -n "$IPV6_ADDR" ]; then
        echo -e "${YELLOW}vless://${UUID}@[${IPV6_ADDR}]${P_VS}#Vision-IPv6${NC}"
    fi

    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${CYAN}提示：客户端连接 IPv4 地址 -> 强制走 IPv4 出口；连接 IPv6 地址 -> 强制走 IPv6 出口。${NC}"
}

# --- 菜单 ---
show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}   Xray 双协议极简管理 (V5 终极修复版)   ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装 / 重置 (双协议 + 分流)"
    echo -e "2. 查看节点链接"
    echo -e "3. 重启服务"
    echo -e "4. 卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    read -p "选择: " c
    case "$c" in
        1) install_node ;;
        2) display_info ;;
        3) systemctl restart xray-dual && success "已重启" ;;
        4) force_cleanup; rm -f "$SERVICE_FILE"; success "已卸载" ;;
        0) exit 0 ;;
        *) echo "无效" ;;
    esac
    read -p "按回车继续..."
}

check_root
while true; do show_menu; done
