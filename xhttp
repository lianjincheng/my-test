#!/bin/bash

# =========================================================
#  Xray Vless-xhttp-reality-enc 管理脚本 (菜单版)
#  Target Core: yonggekkk Custom Xray (with vlessenc)
#  Feature: 双栈链接 + UseIP自动路由 + DNS优化 + 安全审计(ACL)
#  Fix: 自适应监听 + 资源下载校验 + 强力清理
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/root/xray_enc_node"
CONFIG_FILE="${INSTALL_DIR}/config.json"
XRAY_BIN="${INSTALL_DIR}/xray"
SERVICE_FILE="/etc/systemd/system/xray-enc.service"
INFO_FILE="${INSTALL_DIR}/.xray_enc_info"

# 默认伪装域名
DEFAULT_REALITY_SNI="itunes.apple.com"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 全局变量 ---
UUID=""
PORT=""
PRIVATE_KEY=""
PUBLIC_KEY=""
SHORT_ID=""
DECRYPTION_KEY=""
ENCRYPTION_KEY=""
REALITY_SNI=""
# IP 变量
IPV4_ADDR=""
IPV6_ADDR=""

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

# --- 检查 Root ---
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "必须使用 root 权限运行此脚本。"
        exit 1
    fi
}

# --- 强力清理旧进程 ---
force_cleanup() {
    # 1. 停止服务
    if systemctl list-units --full -all | grep -q "xray-enc.service"; then
        systemctl stop xray-enc
        systemctl disable xray-enc >/dev/null 2>&1
    fi

    # 2. 精确清理 Xray 进程
    local pid=$(pgrep -f "^${XRAY_BIN}")
    if [ -n "$pid" ]; then
        kill -9 $pid >/dev/null 2>&1
    fi
}

# --- 检查/安装依赖 ---
check_dependencies() {
    local deps=("curl" "wget" "tar" "jq" "openssl")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            info "正在安装依赖: $dep ..."
            if command -v apt-get &>/dev/null; then
                apt-get update -y && apt-get install -y "$dep"
            elif command -v yum &>/dev/null; then
                yum install -y "$dep"
            else
                warn "无法自动安装 $dep，请手动安装。"
            fi
        fi
    done
}

# --- 保存配置信息 ---
save_info() {
    cat > "$INFO_FILE" <<EOF
UUID="${UUID}"
PORT="${PORT}"
PRIVATE_KEY="${PRIVATE_KEY}"
PUBLIC_KEY="${PUBLIC_KEY}"
SHORT_ID="${SHORT_ID}"
DECRYPTION_KEY="${DECRYPTION_KEY}"
ENCRYPTION_KEY="${ENCRYPTION_KEY}"
REALITY_SNI="${REALITY_SNI}"
EOF
}

# --- 加载配置信息 ---
load_info() {
    if [ -f "$INFO_FILE" ]; then
        source "$INFO_FILE"
        return 0
    else
        return 1
    fi
}

# --- 获取 IP (双栈独立获取) ---
get_ip() {
    # 获取 IPv4 (带备用源)
    IPV4_ADDR=$(curl -s4m5 https://icanhazip.com -k || curl -s4m5 ip.sb -k)
    
    # 获取 IPv6 (带备用源)
    IPV6_ADDR=$(curl -s6m5 https://icanhazip.com -k || curl -s6m5 ip.sb -k)

    if [ -z "$IPV4_ADDR" ] && [ -z "$IPV6_ADDR" ]; then
        warn "无法获取任何公网 IP！"
        IPV4_ADDR="127.0.0.1"
    fi
}

# --- 安装核心逻辑 ---
install_node() {
    force_cleanup
    check_dependencies
    mkdir -p "$INSTALL_DIR"
    
    info "正在检测架构并下载专用内核..."
    local ARCH=$(uname -m)
    local CPU=""
    case "$ARCH" in
        aarch64) CPU="arm64" ;;
        x86_64) CPU="amd64" ;;
        *) error "不支持的架构: $ARCH"; exit 1 ;;
    esac

    local DOWNLOAD_URL="https://github.com/yonggekkk/argosbx/releases/download/argosbx/xray-$CPU"
    
    if command -v curl &>/dev/null; then
        curl -L -o "$XRAY_BIN" "$DOWNLOAD_URL" --retry 3
    else
        wget -O "$XRAY_BIN" "$DOWNLOAD_URL" --tries=3
    fi

    if [ ! -f "$XRAY_BIN" ]; then
        error "核心下载失败！请检查网络。"
        exit 1
    fi
    chmod +x "$XRAY_BIN"
    
    if ! "$XRAY_BIN" help | grep -q "vlessenc"; then
        warn "下载的内核似乎不支持 vlessenc，尝试强制继续..."
    fi

    info "正在生成密钥与配置..."
    
    UUID=$("$XRAY_BIN" uuid)

    local KEY_PAIR=$("$XRAY_BIN" x25519)
    PRIVATE_KEY=$(echo "$KEY_PAIR" | grep "PrivateKey" | awk '{print $2}')
    PUBLIC_KEY=$(echo "$KEY_PAIR" | grep "Password" | awk '{print $2}')
    SHORT_ID=$(openssl rand -hex 4)

    local ENC_KEY_PAIR=$("$XRAY_BIN" vlessenc)
    DECRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"decryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')
    ENCRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"encryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')

    PORT=$(shuf -i 10000-65535 -n 1)
    REALITY_SNI="$DEFAULT_REALITY_SNI"

    # --- 自适应监听地址 ---
    # 默认监听 :: (支持 IPv6/IPv4 双栈)
    local LISTEN_ADDR="::"
    
    # 检测 1: 通过 sysctl 检测是否禁用 IPv6
    if sysctl net.ipv6.conf.all.disable_ipv6 2>/dev/null | grep -q "1"; then
        LISTEN_ADDR="0.0.0.0"
        info "检测到 IPv6 已被 Sysctl 禁用，切换监听地址为 0.0.0.0"
    fi
    
    # 检测 2: 某些精简系统可能没有 if_inet6 文件
    if [ ! -f /proc/net/if_inet6 ]; then
        LISTEN_ADDR="0.0.0.0"
        info "检测到系统不支持 IPv6 协议栈，切换监听地址为 0.0.0.0"
    fi
    # --------------------------------

    info "正在写入配置文件 (UseIP + DNS优化 + ACL + 自适应监听)..."
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "none" },

  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },

  "inbounds": [
    {
      "tag": "xhttp-reality",
      "listen": "${LISTEN_ADDR}",
      "port": ${PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${UUID}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "${DECRYPTION_KEY}"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "target": "${REALITY_SNI}:443",
          "serverNames": [ "${REALITY_SNI}" ],
          "privateKey": "${PRIVATE_KEY}",
          "shortIds": ["${SHORT_ID}"]
        },
        "xhttpSettings": {
          "host": "",
          "path": "${UUID}-xh",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false
      }
    }
  ],

  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {
        "domainStrategy": "UseIP"
      }
    }
  ]
}
EOF

    # 验证配置文件
    if ! "$XRAY_BIN" run -test -c "$CONFIG_FILE" >/dev/null 2>&1; then
        error "生成的配置文件语法校验失败！"
        "$XRAY_BIN" run -test -c "$CONFIG_FILE"
        exit 1
    fi

    info "配置系统服务..."
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Xray Encrypted Service
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${XRAY_BIN} run -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray-enc >/dev/null 2>&1
    systemctl restart xray-enc
    
    save_info
    
    sleep 2
    if systemctl is-active --quiet xray-enc; then
        success "安装并启动成功！"
        display_info
    else
        error "服务启动失败！"
        journalctl -u xray-enc --no-pager -n 10
    fi
}

# --- 显示节点信息 (支持双栈同时显示) ---
display_info() {
    if ! load_info; then
        error "未找到配置信息，请先安装。"
        return
    fi
    get_ip
    
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 节点类型: Vless-xhttp-reality-enc (Xray定制版)${NC}"
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e " 端口 (Port): ${PORT}"
    echo -e " 用户 ID (UUID): ${UUID}"
    echo -e " 加密 Key (Encryption): ${ENCRYPTION_KEY}"
    echo -e " 伪装域名 (SNI): ${REALITY_SNI}"
    echo -e " 路径 (Path): ${UUID}-xh"
    echo -e "----------------------------------------------------"
    
    # 构建链接部分
    local LINK_BASE="vless://${UUID}@"
    local LINK_PARAMS=":${PORT}?encryption=${ENCRYPTION_KEY}&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=xhttp&path=${UUID}-xh&mode=auto"
    
    # 1. 输出 IPv4 链接 (如果有)
    if [ -n "$IPV4_ADDR" ]; then
        local LINK_V4="${LINK_BASE}${IPV4_ADDR}${LINK_PARAMS}#Xray-IPv4"
        echo -e "${YELLOW}[IPv4] 分享链接:${NC}"
        echo -e "${LINK_V4}"
        echo
    fi

    # 2. 输出 IPv6 链接 (如果有)
    if [ -n "$IPV6_ADDR" ]; then
        local LINK_V6="${LINK_BASE}[${IPV6_ADDR}]${LINK_PARAMS}#Xray-IPv6"
        echo -e "${YELLOW}[IPv6] 分享链接 (需客户端网络支持IPv6):${NC}"
        echo -e "${LINK_V6}"
        echo
    fi

    if [ -z "$IPV4_ADDR" ] && [ -z "$IPV6_ADDR" ]; then
        error "未获取到公网IP，无法生成链接。"
        warn "如果您的 VPS 有内网 IP，请手动替换链接中的 127.0.0.1"
        local LINK_LOCAL="${LINK_BASE}127.0.0.1${LINK_PARAMS}#Xray-Local"
        echo -e "${LINK_LOCAL}"
    fi

    echo -e "${MAGENTA}====================================================${NC}"
}

# --- 卸载 ---
uninstall_node() {
    read -p "确定要卸载 Xray-Enc 吗? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        force_cleanup
        rm -f "$SERVICE_FILE"
        systemctl daemon-reload
        rm -rf "$INSTALL_DIR"
        success "卸载完成。"
    else
        info "已取消。"
    fi
}

# --- 菜单 ---
show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}   Xray-Enc 极简管理脚本 (自动适配IPv4/IPv6环境)   ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装 / 重置节点"
    echo -e "2. 查看节点链接"
    echo -e "3. 重启服务"
    echo -e "4. 卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    
    if systemctl is-active --quiet xray-enc; then
        echo -e "当前状态: ${GREEN}运行中${NC}"
    else
        echo -e "当前状态: ${RED}未运行${NC}"
    fi
    echo -e "------------------------------------------------"
    
    read -p "请选择 [0-4]: " choice
    case "$choice" in
        1) install_node ;;
        2) display_info ;;
        3) 
           systemctl restart xray-enc
           if systemctl is-active --quiet xray-enc; then
               success "服务已重启"
           else
               error "重启失败"
           fi
           ;;
        4) uninstall_node ;;
        0) exit 0 ;;
        *) echo "无效输入" ;;
    esac
    read -p "按回车键继续..."
}

# --- 主逻辑 ---
check_root
while true; do show_menu; done
