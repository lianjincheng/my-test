#!/bin/bash

# =========================================================
#  Argosbx 精简版 - 仅 Vless-xhttp-reality-enc 节点
#  Target: Xray-core (Custom)
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/root/xray_enc_node"
CONFIG_FILE="${INSTALL_DIR}/config.json"
XRAY_BIN="${INSTALL_DIR}/xray"
SERVICE_FILE="/etc/systemd/system/xray-enc.service"

# 默认伪装域名 (原脚本默认值为 apple.com)
REALITY_SNI="apple.com"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# --- 1. 环境检查与依赖安装 ---
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}错误：请使用 root 权限运行此脚本。${NC}"
    exit 1
fi

echo -e "${GREEN}1. 安装必要依赖...${NC}"
if command -v apt-get >/dev/null; then
    apt-get update -y && apt-get install -y curl wget tar jq openssl
elif command -v yum >/dev/null; then
    yum install -y curl wget tar jq openssl
else
    echo -e "${YELLOW}未检测到 apt 或 yum，尝试直接运行...${NC}"
fi

mkdir -p "$INSTALL_DIR"

# --- 2. 下载专用 Xray 内核 ---
# 说明：必须下载原作者提供的内核，因为包含标准的 Xray 没有的 vlessenc 功能
echo -e "${GREEN}2. 下载 Xray 专用内核...${NC}"
ARCH=$(uname -m)
case "$ARCH" in
    aarch64) CPU="arm64" ;;
    x86_64) CPU="amd64" ;;
    *) echo -e "${RED}不支持的架构: $ARCH${NC}"; exit 1 ;;
esac

# 使用原脚本的下载源
DOWNLOAD_URL="https://github.com/yonggekkk/argosbx/releases/download/argosbx/xray-$CPU"

# 尝试 curl 下载，失败则尝试 wget
if command -v curl >/dev/null; then
    curl -L -o "$XRAY_BIN" "$DOWNLOAD_URL" --retry 2
elif command -v wget >/dev/null; then
    wget -O "$XRAY_BIN" "$DOWNLOAD_URL" --tries=2
fi

if [ ! -f "$XRAY_BIN" ]; then
    echo -e "${RED}内核下载失败，请检查网络连接。${NC}"
    exit 1
fi

chmod +x "$XRAY_BIN"
CURRENT_VER=$("$XRAY_BIN" version 2>/dev/null | head -n 1)
echo -e "${GREEN}内核安装成功: $CURRENT_VER${NC}"

# --- 3. 生成密钥与配置参数 ---
echo -e "${GREEN}3. 生成加密密钥与配置参数...${NC}"

# 生成 UUID
UUID=$("$XRAY_BIN" uuid)
if [ -z "$UUID" ]; then echo -e "${RED}UUID 生成失败${NC}"; exit 1; fi

# 生成 Reality 密钥对
# [重要] 原脚本使用的内核特性：Public Key 的字段名显示为 "Password"
# 必须保留此 grep 逻辑，否则无法获取公钥
KEY_PAIR=$("$XRAY_BIN" x25519)
PRIVATE_KEY=$(echo "$KEY_PAIR" | grep "PrivateKey" | awk '{print $2}')
PUBLIC_KEY=$(echo "$KEY_PAIR" | grep "Password" | awk '{print $2}')
SHORT_ID=$(openssl rand -hex 4)

# 生成 Vless-ENC 密钥 (核心步骤)
# 使用原脚本的 sed/cut 逻辑提取
ENC_KEY_PAIR=$("$XRAY_BIN" vlessenc)
DECRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"decryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')
ENCRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"encryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')

# 随机端口
PORT=$(shuf -i 10000-65535 -n 1)

# --- 4. 生成配置文件 (config.json) ---
# 完全复刻原脚本的 tag: "xhttp-reality" 配置段
echo -e "${GREEN}4. 写入配置文件...${NC}"
cat > "$CONFIG_FILE" <<EOF
{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "xhttp-reality",
      "listen": "::",
      "port": ${PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${UUID}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "${DECRYPTION_KEY}"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "target": "${REALITY_SNI}:443",
          "serverNames": [
            "${REALITY_SNI}"
          ],
          "privateKey": "${PRIVATE_KEY}",
          "shortIds": ["${SHORT_ID}"]
        },
        "xhttpSettings": {
          "host": "",
          "path": "${UUID}-xh",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}
EOF

# --- 5. 配置 Systemd 服务 ---
echo -e "${GREEN}5. 配置系统服务...${NC}"
cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Xray Vless-Enc Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${XRAY_BIN} run -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable xray-enc >/dev/null 2>&1
systemctl restart xray-enc

# --- 6. 生成分享链接与输出 ---
echo -e "${GREEN}6. 获取 IP 并生成链接...${NC}"

# 获取 IP (尝试 IPv4 优先，IPv6 备用)
SERVER_IP=$(curl -s4m5 https://icanhazip.com -k || curl -s6m5 https://icanhazip.com -k)
if [ -z "$SERVER_IP" ]; then
    SERVER_IP=$(curl -s4m5 ip.sb -k || curl -s6m5 ip.sb -k)
fi

# 拼接链接 - 格式与原脚本完全一致
# 格式: vless://uuid@ip:port?encryption=key&flow=vision&...#name
LINK="vless://${UUID}@${SERVER_IP}:${PORT}?encryption=${ENCRYPTION_KEY}&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=xhttp&path=${UUID}-xh&mode=auto#Xray-Enc-Node"

sleep 2
if systemctl is-active --quiet xray-enc; then
    echo
    echo -e "${GREEN}=========================================================${NC}"
    echo -e "${GREEN}       Vless-xhttp-reality-enc 节点部署完成              ${NC}"
    echo -e "${GREEN}=========================================================${NC}"
    echo -e " 核心版本: ${CURRENT_VER}"
    echo -e " 端口: ${PORT}"
    echo -e " 加密 Key: ${ENCRYPTION_KEY}"
    echo -e " 伪装域名: ${REALITY_SNI}"
    echo -e "---------------------------------------------------------"
    echo -e "${YELLOW}节点分享链接:${NC}"
    echo -e "${LINK}"
    echo -e "---------------------------------------------------------"
    echo -e " 配置文件: ${CONFIG_FILE}"
    echo -e " 服务控制: systemctl restart xray-enc"
    echo -e "${GREEN}=========================================================${NC}"
else
    echo -e "${RED}错误：Xray 服务启动失败！${NC}"
    echo -e "请运行 journalctl -u xray-enc -n 20 查看日志。"
fi
