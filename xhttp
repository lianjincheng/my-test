#!/bin/bash

# =========================================================
#  Xray Vless-xhttp-reality-enc 管理脚本 (菜单版)
#  Target Core: yonggekkk Custom Xray (with vlessenc)
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/root/xray_enc_node"
CONFIG_FILE="${INSTALL_DIR}/config.json"
XRAY_BIN="${INSTALL_DIR}/xray"
SERVICE_FILE="/etc/systemd/system/xray-enc.service"
INFO_FILE="${INSTALL_DIR}/.xray_enc_info"

# 默认伪装域名
DEFAULT_REALITY_SNI="itunes.apple.com"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 全局变量 (用于读取/保存) ---
UUID=""
PORT=""
PRIVATE_KEY=""
PUBLIC_KEY=""
SHORT_ID=""
DECRYPTION_KEY=""
ENCRYPTION_KEY=""
REALITY_SNI=""
SERVER_IP=""

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

# --- 检查 Root ---
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "必须使用 root 权限运行此脚本。"
        exit 1
    fi
}

# --- 检查/安装依赖 ---
check_dependencies() {
    local deps=("curl" "wget" "tar" "jq" "openssl")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            info "正在安装依赖: $dep ..."
            if command -v apt-get &>/dev/null; then
                apt-get update -y && apt-get install -y "$dep"
            elif command -v yum &>/dev/null; then
                yum install -y "$dep"
            else
                warn "无法自动安装 $dep，请手动安装。"
            fi
        fi
    done
}

# --- 保存配置信息 ---
save_info() {
    cat > "$INFO_FILE" <<EOF
UUID="${UUID}"
PORT="${PORT}"
PRIVATE_KEY="${PRIVATE_KEY}"
PUBLIC_KEY="${PUBLIC_KEY}"
SHORT_ID="${SHORT_ID}"
DECRYPTION_KEY="${DECRYPTION_KEY}"
ENCRYPTION_KEY="${ENCRYPTION_KEY}"
REALITY_SNI="${REALITY_SNI}"
EOF
}

# --- 加载配置信息 ---
load_info() {
    if [ -f "$INFO_FILE" ]; then
        source "$INFO_FILE"
        return 0
    else
        return 1
    fi
}

# --- 获取 IP ---
get_ip() {
    SERVER_IP=$(curl -s4m5 https://icanhazip.com -k || curl -s6m5 https://icanhazip.com -k)
    if [ -z "$SERVER_IP" ]; then
        SERVER_IP=$(curl -s4m5 ip.sb -k || curl -s6m5 ip.sb -k)
    fi
    if [ -z "$SERVER_IP" ]; then
        SERVER_IP="127.0.0.1"
        warn "无法获取公网 IP，已使用 127.0.0.1"
    fi
}

# --- 安装核心逻辑 ---
install_node() {
    check_dependencies
    mkdir -p "$INSTALL_DIR"
    
    info "正在检测架构并下载专用内核..."
    local ARCH=$(uname -m)
    local CPU=""
    case "$ARCH" in
        aarch64) CPU="arm64" ;;
        x86_64) CPU="amd64" ;;
        *) error "不支持的架构: $ARCH"; exit 1 ;;
    esac

    # 必须使用 yonggekkk 的源，因为它包含 vlessenc
    local DOWNLOAD_URL="https://github.com/yonggekkk/argosbx/releases/download/argosbx/xray-$CPU"
    
    # 尝试下载
    if command -v curl &>/dev/null; then
        curl -L -o "$XRAY_BIN" "$DOWNLOAD_URL" --retry 3
    else
        wget -O "$XRAY_BIN" "$DOWNLOAD_URL" --tries=3
    fi

    if [ ! -f "$XRAY_BIN" ]; then
        error "核心下载失败！请检查网络。"
        exit 1
    fi
    chmod +x "$XRAY_BIN"
    
    # 验证 vlessenc 命令是否存在 (确保是定制内核)
    if ! "$XRAY_BIN" help | grep -q "vlessenc"; then
        warn "下载的内核似乎不支持 vlessenc，尝试强制继续..."
    fi

    info "正在生成密钥与配置..."
    
    # 1. UUID
    UUID=$("$XRAY_BIN" uuid)

    # 2. Reality Keys (特殊解析逻辑)
    # 原脚本注：public_key 在定制内核输出中显示为 "Password"
    local KEY_PAIR=$("$XRAY_BIN" x25519)
    PRIVATE_KEY=$(echo "$KEY_PAIR" | grep "PrivateKey" | awk '{print $2}')
    # !!! 关键点：匹配 Password 而非 Public Key !!!
    PUBLIC_KEY=$(echo "$KEY_PAIR" | grep "Password" | awk '{print $2}')
    SHORT_ID=$(openssl rand -hex 4)

    # 3. Vless Enc Keys
    local ENC_KEY_PAIR=$("$XRAY_BIN" vlessenc)
    # 严格沿用原脚本的提取逻辑
    DECRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"decryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')
    ENCRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"encryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')

    # 4. Port & SNI
    PORT=$(shuf -i 10000-65535 -n 1)
    REALITY_SNI="$DEFAULT_REALITY_SNI"

    info "正在写入配置文件..."
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "none" },
  "inbounds": [
    {
      "tag": "xhttp-reality",
      "listen": "::",
      "port": ${PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${UUID}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "${DECRYPTION_KEY}"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "target": "${REALITY_SNI}:443",
          "serverNames": [ "${REALITY_SNI}" ],
          "privateKey": "${PRIVATE_KEY}",
          "shortIds": ["${SHORT_ID}"]
        },
        "xhttpSettings": {
          "host": "",
          "path": "${UUID}-xh",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" }
  ]
}
EOF

    info "配置系统服务..."
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Xray Encrypted Service
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${XRAY_BIN} run -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray-enc >/dev/null 2>&1
    systemctl restart xray-enc
    
    save_info
    
    sleep 2
    if systemctl is-active --quiet xray-enc; then
        success "安装并启动成功！"
        display_info
    else
        error "服务启动失败！"
        journalctl -u xray-enc --no-pager -n 10
    fi
}

# --- 显示节点信息 ---
display_info() {
    if ! load_info; then
        error "未找到配置信息，请先安装。"
        return
    fi
    get_ip
    
    # 链接构建 (1:1 还原原脚本格式)
    # vless://uuid@ip:port?encryption=key&flow=vision&security=reality&sni=...&fp=chrome&pbk=...&sid=...&type=xhttp&path=uuid-xh&mode=auto#Name
    local LINK="vless://${UUID}@${SERVER_IP}:${PORT}?encryption=${ENCRYPTION_KEY}&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=xhttp&path=${UUID}-xh&mode=auto#Xray-Enc-Node"

    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 节点类型: Vless-xhttp-reality-enc (Xray定制版)${NC}"
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e " 地址 (IP): ${SERVER_IP}"
    echo -e " 端口 (Port): ${PORT}"
    echo -e " 用户 ID (UUID): ${UUID}"
    echo -e " 加密 Key (Encryption): ${ENCRYPTION_KEY}"
    echo -e " 伪装域名 (SNI): ${REALITY_SNI}"
    echo -e " 路径 (Path): ${UUID}-xh"
    echo -e "----------------------------------------------------"
    echo -e "${YELLOW}分享链接 (复制导入):${NC}"
    echo -e "${LINK}"
    echo -e "${MAGENTA}====================================================${NC}"
}

# --- 卸载 ---
uninstall_node() {
    read -p "确定要卸载 Xray-Enc 吗? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        info "正在停止服务..."
        systemctl stop xray-enc
        systemctl disable xray-enc >/dev/null 2>&1
        rm -f "$SERVICE_FILE"
        systemctl daemon-reload
        
        info "正在删除文件..."
        rm -rf "$INSTALL_DIR"
        
        success "卸载完成。"
    else
        info "已取消。"
    fi
}

# --- 菜单 ---
show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}   Xray-Enc 极简管理脚本 (Vless-xhttp-enc)   ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装 / 重置节点"
    echo -e "2. 查看节点链接"
    echo -e "3. 重启服务"
    echo -e "4. 卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    
    # 状态显示
    if systemctl is-active --quiet xray-enc; then
        echo -e "当前状态: ${GREEN}运行中${NC}"
    else
        echo -e "当前状态: ${RED}未运行${NC}"
    fi
    echo -e "------------------------------------------------"
    
    read -p "请选择 [0-4]: " choice
    case "$choice" in
        1) install_node ;;
        2) display_info ;;
        3) 
           systemctl restart xray-enc
           if systemctl is-active --quiet xray-enc; then
               success "服务已重启"
           else
               error "重启失败"
           fi
           ;;
        4) uninstall_node ;;
        0) exit 0 ;;
        *) echo "无效输入" ;;
    esac
    read -p "按回车键继续..."
}

# --- 主逻辑 ---
check_root
while true; do show_menu; done
