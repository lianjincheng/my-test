uninstall_singbox() {
    warn "你确定要卸载 Sing-box 吗?"; read -p "此操作将停止并禁用服务，清理所有组件。是否继续卸载? (y/N): " uninstall_choice
    if [[ ! "$uninstall_choice" =~ ^[Yy]$ ]]; then info "卸载已取消。"; return; fi
    info "正在清理防火墙规则..."; load_persistent_info
    if command -v ufw &>/dev/null; then
        local ports_to_close=( "${REALITY_TCP_SMART_PORT}/tcp" "${REALITY_HTTP_SMART_PORT}/tcp" "${REALITY_TCP_DIRECT_PORT}/tcp" "${REALITY_HTTP_DIRECT_PORT}/tcp" "${HY2_SMART_PORT}/udp" "${HY2_DIRECT_PORT}/udp" "${TUIC_SMART_PORT}/udp" "${TUIC_DIRECT_PORT}/udp" "${SOCKS5_PORT}/tcp" "443/tcp" )
        for port_rule in "${ports_to_close[@]}"; do
            if [ -n "$port_rule" ] && [[ "$port_rule" != "/" ]]; then ufw delete allow "$port_rule" >/dev/null 2>&1; fi
        done; ufw reload >/dev/null 2>&1; success "已清理由本脚本创建的防火墙规则。"
    fi
    info "正在停止并禁用 sing-box 服务..."; systemctl stop sing-box &>/dev/null; systemctl disable sing-box &>/dev/null
    rm -f "$SINGBOX_SERVICE_FILE"; systemctl daemon-reload
    info "正在删除文件..."; rm -f "$SINGBOX_INSTALL_PATH_EXPECTED"; rm -rf "$SINGBOX_CONFIG_DIR"
    read -p "是否删除 Hysteria2/TUIC 共享证书目录 ${HYSTERIA_CERT_DIR}? (y/N): " delete_cert_dir_choice
    if [[ "$delete_cert_dir_choice" =~ ^[Yy]$ ]]; then rm -rf "$HYSTERIA_CERT_DIR"; fi
    success "Sing-box 卸载完成。"
}

manage_singbox() {
    local action=$1
    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ] && [[ ! "$action" =~ ^(start|stop|status)$ ]]; then error "无法找到 Sing-box command. 操作中止。"; return 1; fi
    case "$action" in
        start|stop|restart|status)
            if [[ "$action" == "restart" ]]; then
                if [ -f "$SINGBOX_CONFIG_FILE" ]; then info "重启前检查配置文件..."
                    if ! $SINGBOX_CMD check -c "$SINGBOX_CONFIG_FILE"; then error "配置文件检查失败，无法重启。请先修复配置文件。"; return 1; fi
                fi
            fi
            systemctl "$action" sing-box; sleep 1; if [[ "$action" == "status" ]]; then return; fi
            if systemctl is-active --quiet sing-box; then success "操作成功，服务正在运行。"
            elif [[ "$action" == "stop" ]]; then success "操作成功，服务已停止。"
            else warn "操作可能未成功或服务未运行。"; fi
            ;;
        log) journalctl -u sing-box -f --no-pager -n 50 ;;
        view_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then info "当前配置文件 (${SINGBOX_CONFIG_FILE}):"
                if command -v jq &>/dev/null; then jq . "$SINGBOX_CONFIG_FILE"; else cat "$SINGBOX_CONFIG_FILE"; fi
            else error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"; fi
            ;;
        edit_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                if command -v nano &>/dev/null; then nano "$SINGBOX_CONFIG_FILE"; elif command -v vim &>/dev/null; then vim "$SINGBOX_CONFIG_FILE"; else error "'nano' 或 'vim' 编辑器未安装。"; return; fi
                read -p "配置文件已编辑，是否立即重启 sing-box 服务? (y/N): " restart_confirm
                if [[ "$restart_confirm" =~ ^[Yy]$ ]]; then manage_singbox "restart"; fi
            else error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"; fi
            ;;
        *) error "无效的管理操作: $action" ;;
    esac
}

show_menu() {
    clear; print_author_info
    echo -e "${GREEN}${BOLD}安装与重置:${NC}"; echo "  1. 安装 / 重置 终极节点矩阵 (8+1)"
    echo "------------------------------------------------"
    echo -e "${YELLOW}${BOLD}核心管理:${NC}"; echo "  2. 启动 Sing-box 服务"; echo "  3. 停止 Sing-box 服务"; echo "  4. 重启 Sing-box 服务"; echo "  5. 查看 Sing-box 服务状态"; echo "  6. 查看 Sing-box 实时日志"
    echo "------------------------------------------------"
    echo -e "${CYAN}${BOLD}配置与节点:${NC}"; echo "  7. 显示所有节点导入信息 (二维码)"; echo "  8. 更换端口 (子菜单)"; echo "  9. 查看当前配置文件 (格式化)"; echo "  10. 手动编辑配置文件 (nano/vim)"
    echo "------------------------------------------------"
    echo -e "${RED}${BOLD}系统与维护:${NC}"; echo "  11. 检查/安装 Sing-box 内核 (v1.8.0)"; echo "  12. 卸载 (清理所有组件)"; echo "  0. 退出脚本"
    echo "================================================"
    read -p "请输入选项 [0-12]: " choice

    case "$choice" in
        1) install_all_nodes ;; 2) manage_singbox "start" ;; 3) manage_singbox "stop" ;; 4) manage_singbox "restart" ;;
        5) manage_singbox "status" ;; 6) manage_singbox "log" ;; 7) show_current_import_info ;; 8) show_rotate_ports_menu ;;
        9) manage_singbox "view_config" ;; 10) manage_singbox "edit_config" ;; 11) install_singbox_core && manage_singbox "restart" ;;
        12) uninstall_singbox ;; 0) exit 0 ;; *) error "无效选项，请输入 0 到 12 之间的数字。" ;;
    esac; echo
}

