bootstrap_dependencies() {
    info "开始检查并安装所有必需的依赖..."
    local core_deps=("curl" "tar" "jq" "openssl" "lsof" "ufw")
    local warp_deps=("wireguard-tools" "jq")
    local optional_deps=("qrencode")
    local all_deps=("${core_deps[@]}" "${warp_deps[@]}" "${optional_deps[@]}")
    local unique_deps=($(echo "${all_deps[@]}" | tr ' ' '\n' | sort -u | tr '\n' ' '))
    local pkgs_to_install=()
    for pkg in "${unique_deps[@]}"; do
        local check_cmd="$pkg"
        if [[ "$pkg" == "wireguard-tools" ]]; then check_cmd="wg"; fi
        if ! command -v "$check_cmd" &>/dev/null; then pkgs_to_install+=("$pkg"); fi
    done
    if [ ${#pkgs_to_install[@]} -eq 0 ]; then success "所有依赖项均已安装。"; return 0; fi
    info "正在准备安装缺失的依赖: ${pkgs_to_install[*]}"
    if command -v apt-get &>/dev/null; then
        apt-get update -y && apt-get install -y "${pkgs_to_install[@]}"
    elif command -v yum &>/dev/null || command -v dnf &>/dev/null; then
        local pm
        if command -v yum &>/dev/null; then pm="yum"; else pm="dnf"; fi
        if [[ " ${pkgs_to_install[@]} " =~ " wireguard-tools " || " ${pkgs_to_install[@]} " =~ " jq " ]]; then
            info "在 RHEL/CentOS 系统上，需要 EPEL 源来安装部分依赖..."
            $pm install -y epel-release
        fi
        $pm install -y "${pkgs_to_install[@]}"
    else
        error "无法确定包管理器 (apt, yum, dnf)。请手动安装: ${pkgs_to_install[*]}"; return 1
    fi
    for pkg in "${unique_deps[@]}"; do
        local check_cmd="$pkg"
        if [[ "$pkg" == "wireguard-tools" ]]; then check_cmd="wg"; fi
        if ! command -v "$check_cmd" &>/dev/null; then
            if [[ "$pkg" == "qrencode" ]]; then warn "可选依赖 'qrencode' 安装失败。二维码将不可用。"
            else error "核心依赖 '$pkg' 安装失败。脚本无法继续。"; return 1; fi
        fi
    done
    success "依赖项准备完成。"
}

