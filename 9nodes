check_root
# 在主逻辑开始前就运行依赖检查
bootstrap_dependencies || exit 1
find_and_set_singbox_cmd
load_persistent_info

# 主循环
while true; do
    show_menu
    read -n 1 -s -r -p "按任意键返回主菜单 (或按 Ctrl+C 退出)..."
done
