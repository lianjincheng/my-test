    info "正在批量生成 9 个节点的独立凭证..."
    HY2_SMART_PASSWORD=$(generate_random_string) && HY2_DIRECT_PASSWORD=$(generate_random_string)
    success "已生成 2 套 Hysteria2 独立密码。"
    TUIC_SMART_UUID=$(generate_random_string) && TUIC_SMART_PASSWORD=$(generate_random_string)
    TUIC_DIRECT_UUID=$(generate_random_string) && TUIC_DIRECT_PASSWORD=$(generate_random_string)
    success "已生成 2 套 TUIC v5 独立凭证。"
    generate_single_reality_credentials REALITY_TCP_SMART_UUID REALITY_TCP_SMART_PRIVATE_KEY_FOR_CONFIG REALITY_TCP_SMART_PUBLIC_KEY REALITY_TCP_SMART_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_HTTP_SMART_UUID REALITY_HTTP_SMART_PRIVATE_KEY_FOR_CONFIG REALITY_HTTP_SMART_PUBLIC_KEY REALITY_HTTP_SMART_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_TCP_DIRECT_UUID REALITY_TCP_DIRECT_PRIVATE_KEY_FOR_CONFIG REALITY_TCP_DIRECT_PUBLIC_KEY REALITY_TCP_DIRECT_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_HTTP_DIRECT_UUID REALITY_HTTP_DIRECT_PRIVATE_KEY_FOR_CONFIG REALITY_HTTP_DIRECT_PUBLIC_KEY REALITY_HTTP_DIRECT_SHORT_ID || return 1
    success "已生成 4 套 Reality 独立凭证。"
    SOCKS5_USERNAME=$(generate_random_string) && SOCKS5_PASSWORD=$(generate_random_string)
    success "已生成 1 套 SOCKS5 独立凭证。"
    
    # --- 端口批量分配 ---
    info "正在为 9 个节点分配端口..."
    REALITY_TCP_SMART_PORT=443
    if lsof -i:443 -sTCP:LISTEN >/dev/null ; then error "端口 443 已被占用。"; return 1; fi
    success "主 Reality 节点将使用端口: ${GREEN}443${NC}"

    local used_ports=("443")
    local high_conceal_ports_shuffled=($(shuf -e "${REALITY_HIGH_AVAILABILITY_PORTS[@]}"))
    local high_conceal_idx=0
    
    for var in REALITY_HTTP_SMART_PORT REALITY_TCP_DIRECT_PORT REALITY_HTTP_DIRECT_PORT; do
        local found=false
        for ((i=high_conceal_idx; i<${#high_conceal_ports_shuffled[@]}; i++)); do
            p=${high_conceal_ports_shuffled[i]}
            if ! lsof -i:"$p" >/dev/null && ! [[ " ${used_ports[@]} " =~ " ${p} " ]]; then
                declare "$var=$p"
                used_ports+=("$p")
                high_conceal_idx=$((i+1))
                found=true
                break
            fi
        done
        if ! $found; then error "高隐蔽性端口池已用尽或全部被占用。"; return 1; fi
    done
    success "已从高隐蔽性端口池分配 3 个 Reality 端口: ${REALITY_HTTP_SMART_PORT}, ${REALITY_TCP_DIRECT_PORT}, ${REALITY_HTTP_DIRECT_PORT}"

    for var in HY2_SMART_PORT HY2_DIRECT_PORT TUIC_SMART_PORT TUIC_DIRECT_PORT SOCKS5_PORT; do
        while true; do
            local random_port
            if [[ "$var" == "SOCKS5_PORT" ]]; then
                random_port=$(shuf -i 10800-10900 -n 1)
            else
