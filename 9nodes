            fi
            if ! lsof -i:"$random_port" >/dev/null && ! [[ " ${used_ports[@]} " =~ " ${random_port} " ]]; then
                declare "$var=$random_port"
                used_ports+=("$random_port")
                break
            fi
        done
    done
    success "已分配 4 个随机 UDP 端口和 1 个 SOCKS5 端口。"
    
    # --- 生成共享证书 ---
    generate_self_signed_cert "$DEFAULT_HYSTERIA_MASQUERADE_CN" || return 1
    
    # --- 生成配置文件 ---
    create_config_json || return 1

    # --- 更新防火墙 ---
    update_firewall_rules
    
    # --- 启动服务 ---
    create_systemd_service
    start_singbox_service || return 1

    success "8+1 终极节点矩阵部署完成！"
    display_and_store_config_info
}

# --- START: New Port Rotation Functions ---

# Helper function to find a new random port
# Usage: new_port_var=$(find_new_port "type" "used_ports_array")
find_new_port() {
    local type=$1
    shift
    local used_ports_array=("$@")
    local random_port

    while true; do
        if [[ "$type" == "socks5" ]]; then
            random_port=$(shuf -i 10800-10900 -n 1)
        else # hy2 or tuic
            random_port=$(shuf -i 10000-65535 -n 1)
        fi
        
        # Check if port is in use by system OR by our script
        if ! lsof -i:"$random_port" >/dev/null && ! [[ " ${used_ports_array[@]} " =~ " ${random_port} " ]]; then
            echo "$random_port"
            return
        fi
    done
}

# Helper function to find new reality ports
# Usage: read -r p1 p2 p3 <<< $(find_new_reality_ports "used_ports_array")
find_new_reality_ports() {
    local used_ports_array=("$@")
    local high_conceal_ports_shuffled=($(shuf -e "${REALITY_HIGH_AVAILABILITY_PORTS[@]}"))
    local new_ports=()
    
    for p in "${high_conceal_ports_shuffled[@]}"; do
        if ! lsof -i:"$p" >/dev/null && ! [[ " ${used_ports_array[@]} " =~ " ${p} " ]]; then
            new_ports+=("$p")
            if [ ${#new_ports[@]} -eq 3 ]; then
                echo "${new_ports[@]}"
                return
            fi
        fi
    done
    
    # If we reach here, not enough ports were found
    echo "" # Return empty string on failure
}

execute_port_rotation() {
    local targets=("$@")
    if [[ " ${targets[@]} " =~ " all " ]]; then
        targets=("hy2" "tuic" "reality" "socks5")
    fi

    info "开始执行端口更换程序..."
    load_persistent_info

    # --- Step 1: Identify ports to close and build a list of ports that will NOT be changed ---
    info "步骤 1/5: 识别并准备关闭旧端口..."
    local ports_to_close=()
    local static_ports=("443") # 443 never changes

    if ! [[ " ${targets[@]} " =~ " hy2 " ]]; then
        static_ports+=("$HY2_SMART_PORT" "$HY2_DIRECT_PORT")
    else
        ports_to_close+=("${HY2_SMART_PORT}/udp" "${HY2_DIRECT_PORT}/udp")
    fi

    if ! [[ " ${targets[@]} " =~ " tuic " ]]; then
        static_ports+=("$TUIC_SMART_PORT" "$TUIC_DIRECT_PORT")
    else
        ports_to_close+=("${TUIC_SMART_PORT}/udp" "${TUIC_DIRECT_PORT}/udp")
    fi

    if ! [[ " ${targets[@]} " =~ " reality " ]]; then
        static_ports+=("$REALITY_HTTP_SMART_PORT" "$REALITY_TCP_DIRECT_PORT" "$REALITY_HTTP_DIRECT_PORT")
    else
        ports_to_close+=("${REALITY_HTTP_SMART_PORT}/tcp" "${REALITY_TCP_DIRECT_PORT}/tcp" "${REALITY_HTTP_DIRECT_PORT}/tcp")
    fi

    if ! [[ " ${targets[@]} " =~ " socks5 " ]]; then
        static_ports+=("$SOCKS5_PORT")
    else
        ports_to_close+=("${SOCKS5_PORT}/tcp")
    fi
    
    for port_rule in "${ports_to_close[@]}"; do
        if [ -n "$port_rule" ] && [[ "$port_rule" != "/" ]]; then
            info "关闭旧端口规则: ${port_rule}"
            ufw delete allow "$port_rule" >/dev/null 2>&1
        fi
    done

    # --- Step 2: Generate new ports ---
    info "步骤 2/5: 正在生成新端口..."
    local used_ports=("${static_ports[@]}") # Start with the ports that are not changing

    if [[ " ${targets[@]} " =~ " reality " ]]; then
        info "正在为 Reality 分配新端口..."
        local new_reality_ports
        new_reality_ports=$(find_new_reality_ports "${used_ports[@]}")
        if [ -z "$new_reality_ports" ]; then
            error "高隐蔽性端口池已用尽或全部被占用，无法为 Reality 分配新端口。"
            return 1
        fi
        read -r REALITY_HTTP_SMART_PORT REALITY_TCP_DIRECT_PORT REALITY_HTTP_DIRECT_PORT <<< "$new_reality_ports"
        used_ports+=("$REALITY_HTTP_SMART_PORT" "$REALITY_TCP_DIRECT_PORT" "$REALITY_HTTP_DIRECT_PORT")
        success "新的 Reality 端口: ${REALITY_HTTP_SMART_PORT}, ${REALITY_TCP_DIRECT_PORT}, ${REALITY_HTTP_DIRECT_PORT}"
    fi

    if [[ " ${targets[@]} " =~ " hy2 " ]]; then
        info "正在为 Hysteria2 分配新端口..."
        HY2_SMART_PORT=$(find_new_port "hy2" "${used_ports[@]}")
        used_ports+=("$HY2_SMART_PORT")
        HY2_DIRECT_PORT=$(find_new_port "hy2" "${used_ports[@]}")
        used_ports+=("$HY2_DIRECT_PORT")
        success "新的 Hysteria2 端口: ${HY2_SMART_PORT}, ${HY2_DIRECT_PORT}"
    fi

    if [[ " ${targets[@]} " =~ " tuic " ]]; then
        info "正在为 TUIC 分配新端口..."
        TUIC_SMART_PORT=$(find_new_port "tuic" "${used_ports[@]}")
        used_ports+=("$TUIC_SMART_PORT")
        TUIC_DIRECT_PORT=$(find_new_port "tuic" "${used_ports[@]}")
        used_ports+=("$TUIC_DIRECT_PORT")
        success "新的 TUIC 端口: ${TUIC_SMART_PORT}, ${TUIC_DIRECT_PORT}"
    fi

    if [[ " ${targets[@]} " =~ " socks5 " ]]; then
        info "正在为 SOCKS5 分配新端口..."
        SOCKS5_PORT=$(find_new_port "socks5" "${used_ports[@]}")
        used_ports+=("$SOCKS5_PORT")
        success "新的 SOCKS5 端口: ${SOCKS5_PORT}"
    fi
    
    # --- Step 3, 4, 5 ---
    info "步骤 3/5: 更新配置文件..."
    create_config_json || return 1
    
    info "步骤 4/5: 为新端口开放防火墙规则..."
    update_firewall_rules

    info "步骤 5/5: 重启服务并显示新链接..."
    start_singbox_service || return 1
    save_persistent_info
    
    success "端口更换成功！"
    warn "请立即使用下方显示的新链接更新您的客户端配置！"
    display_and_store_config_info
}

