uninstall_singbox() {
    warn "你确定要卸载 Sing-box 吗?"
    read -p "此操作将停止并禁用服务，清理所有组件。是否继续卸载? (y/N): " uninstall_choice
    if [[ ! "$uninstall_choice" =~ ^[Yy]$ ]]; then info "卸载已取消。"; return; fi
    
    info "正在清理防火墙规则..."
    load_persistent_info
    local ports_to_close=(
        "${REALITY_TCP_SMART_PORT}/tcp" "${REALITY_HTTP_SMART_PORT}/tcp" "${REALITY_TCP_DIRECT_PORT}/tcp"
        "${REALITY_HTTP_DIRECT_PORT}/tcp" "${HY2_SMART_PORT}/udp" "${HY2_DIRECT_PORT}/udp"
        "${TUIC_SMART_PORT}/udp" "${TUIC_DIRECT_PORT}/udp" "${SOCKS5_PORT}/tcp" "443/tcp"
    )
    if command -v ufw &>/dev/null; then
        for port_rule in "${ports_to_close[@]}"; do
            if [ -n "$port_rule" ]; then ufw delete allow "$port_rule" >/dev/null 2>&1; fi
        done
        ufw reload >/dev/null 2>&1
        success "已清理由本脚本创建的防火墙规则。"
    fi
    
    info "正在停止并禁用 sing-box 服务..."
    systemctl stop sing-box &>/dev/null
    systemctl disable sing-box &>/dev/null
    rm -f "$SINGBOX_SERVICE_FILE"
    systemctl daemon-reload
    
    info "正在删除文件..."
    rm -f "$SINGBOX_INSTALL_PATH_EXPECTED"
    rm -rf "$SINGBOX_CONFIG_DIR"
    read -p "是否删除 Hysteria2/TUIC 共享证书目录 ${HYSTERIA_CERT_DIR}? (y/N): " delete_cert_dir_choice
    if [[ "$delete_cert_dir_choice" =~ ^[Yy]$ ]]; then
        rm -rf "$HYSTERIA_CERT_DIR"
    fi
    
    success "Sing-box 卸载完成。"
}

manage_singbox() {
    local action=$1
    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ] && [[ "$action" != "start" && "$action" != "stop" && "$action" != "status" ]]; then
        error "无法找到 Sing-box command. 操作中止。"; return 1;
    fi

    case "$action" in
        start|stop|restart|status)
            if [[ "$action" == "restart" ]]; then
                if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                    info "重启前检查配置文件..."
                    if ! $SINGBOX_CMD check -c "$SINGBOX_CONFIG_FILE"; then
                        error "配置文件检查失败，无法重启。请先修复配置文件。"; return 1;
                    fi
                fi
            fi
            systemctl "$action" sing-box
            sleep 1
            if [[ "$action" == "status" ]]; then return; fi
            if systemctl is-active --quiet sing-box; then
                success "操作成功，服务正在运行。"
            elif [[ "$action" == "stop" ]]; then
                 success "操作成功，服务已停止。"
            else
                warn "操作可能未成功或服务未运行。"
            fi
            ;;
        log) journalctl -u sing-box -f --no-pager -n 50 ;;
        view_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                info "当前配置文件 (${SINGBOX_CONFIG_FILE}):"
                if command -v jq &>/dev/null; then jq . "$SINGBOX_CONFIG_FILE"; else cat "$SINGBOX_CONFIG_FILE"; fi
            else error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"; fi
            ;;
        edit_config)
            if [ -f "$SINGBOX_CONFIG_FILE" ]; then
                if command -v nano &>/dev/null; then nano "$SINGBOX_CONFIG_FILE"; elif command -v vim &>/dev/null; then vim "$SINGBOX_CONFIG_FILE"; else error "'nano' 或 'vim' 编辑器未安装。"; return; fi
                read -p "配置文件已编辑，是否立即重启 sing-box 服务? (y/N): " restart_confirm
                if [[ "$restart_confirm" =~ ^[Yy]$ ]]; then manage_singbox "restart"; fi
            else error "配置文件不存在: ${SINGBOX_CONFIG_FILE}"; fi
            ;;
        *) error "无效的管理操作: $action" ;;
    esac
}

