install_singbox_core() {
    local target_version="v1.8.0"

    if [ -f "$SINGBOX_INSTALL_PATH_EXPECTED" ]; then
        info "Sing-box 已检测到在 $SINGBOX_INSTALL_PATH_EXPECTED."
        current_version=$("$SINGBOX_INSTALL_PATH_EXPECTED" version | awk '{print $3}' 2>/dev/null)
        if [ -n "$current_version" ]; then
            info "当前版本: $current_version"
            if [[ "$current_version" == "$target_version" ]]; then
                info "已安装目标版本，跳过安装。"
                find_and_set_singbox_cmd
                return 0
            else
                warn "当前版本 ($current_version) 与目标版本 ($target_version) 不同。"
                read -p "是否覆盖为目标版本 $target_version? (Y/n): " reinstall_choice
                if [[ ! "$reinstall_choice" =~ ^[Yy]$ && -n "$reinstall_choice" ]]; then
                    return 0
                fi
            fi
        fi
    fi

    info "正在准备安装 Sing-box (指定版本: $target_version)..."

    local ARCH
    case "$(uname -m)" in
        x86_64) ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        armv7l) ARCH="armv7" ;;
        *) error "不支持的系统架构: $(uname -m)"; return 1 ;;
    esac
    info "检测到系统架构: $ARCH"

    local version_num=${target_version#v}
    local download_url="https://github.com/SagerNet/sing-box/releases/download/${target_version}/sing-box-${version_num}-linux-${ARCH}.tar.gz"
    
    local tmp_dir
    tmp_dir=$(mktemp -d)
    
    info "正在从 GitHub Releases 下载: $download_url"
    if ! curl -L --progress-bar -o "${tmp_dir}/sing-box.tar.gz" "$download_url"; then
        error "下载失败。请检查网络或确认链接是否有效。"
        rm -rf "$tmp_dir"
        return 1
    fi
    success "下载成功。"

    info "正在解压文件..."
    if ! command -v tar &> /dev/null; then 
        (apt-get update -y && apt-get install -y tar) || (yum install -y tar) || (dnf install -y tar)
    fi
    if ! tar -xzf "${tmp_dir}/sing-box.tar.gz" -C "$tmp_dir"; then
        error "解压失败。"
        rm -rf "$tmp_dir"
        return 1
    fi

    info "正在安装 sing-box 到 $SINGBOX_INSTALL_PATH_EXPECTED..."
    if ! install -m 755 "${tmp_dir}/sing-box-${version_num}-linux-${ARCH}/sing-box" "$SINGBOX_INSTALL_PATH_EXPECTED"; then
        error "安装失败。请检查权限。"
        rm -rf "$tmp_dir"
        return 1
    fi
    success "Sing-box 版本 $target_version 安装成功。"

    rm -rf "$tmp_dir"
    
    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ]; then
        error "安装后仍无法找到 sing-box 命令。"
        return 1
    fi

    return 0
}

generate_self_signed_cert() {
    local domain_cn="$1"
    if [ -f "$HYSTERIA_CERT_PEM" ] && [ -f "$HYSTERIA_CERT_KEY" ]; then
        info "检测到已存在的证书，跳过生成。"
        return 0
    fi

    info "正在为 Hysteria2 & TUIC 生成共享自签名证书 (CN=${domain_cn})..."
    mkdir -p "$HYSTERIA_CERT_DIR"
    
    local openssl_conf
    openssl_conf=$(mktemp)
    cat > "$openssl_conf" <<EOF
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no
[req_distinguished_name]
CN = ${domain_cn}
[v3_req]
subjectAltName = @alt_names
[alt_names]
DNS.1 = ${domain_cn}
EOF

    if openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 3650 -nodes \
      -keyout "$HYSTERIA_CERT_KEY" -out "$HYSTERIA_CERT_PEM" -config "$openssl_conf" >/dev/null 2>&1; then
        success "共享证书 (含SAN) 生成成功。"
    else
        error "共享证书生成失败。"
        rm -f "$openssl_conf"
        return 1
    fi
    
    rm -f "$openssl_conf"
}

generate_single_reality_credentials() {
    local -n _uuid=$1
    local -n _private_key=$2
    local -n _public_key=$3
    local -n _short_id=$4

    find_and_set_singbox_cmd
    if [ -z "$SINGBOX_CMD" ]; then error "Sing-box command 未设置。"; return 1; fi
    
    _uuid=$($SINGBOX_CMD generate uuid)
    if [ $? -ne 0 ] || [ -z "$_uuid" ]; then error "生成 Reality UUID 失败。"; return 1; fi

    local KEY_PAIR_OUTPUT
    KEY_PAIR_OUTPUT=$($SINGBOX_CMD generate reality-keypair)
    if [ $? -ne 0 ] || [ -z "$KEY_PAIR_OUTPUT" ]; then error "生成 Reality KeyPair 失败。"; return 1; fi
    
    _private_key=$(echo "$KEY_PAIR_OUTPUT" | awk -F': ' '/PrivateKey:/ {print $2}' | xargs)
    _public_key=$(echo "$KEY_PAIR_OUTPUT" | awk -F': ' '/PublicKey:/ {print $2}' | xargs)
    _short_id=$(openssl rand -hex 8)

    if [ -z "$_uuid" ] || [ -z "$_private_key" ] || [ -z "$_public_key" ] || [ -z "$_short_id" ]; then
        error "生成 Reality 凭证失败。"
        return 1
    fi
}
setup_warp() {
    info "正在配置 WARP 出站..."
    
    info "步骤 1/2: 尝试使用 wgcf 自动注册并获取 WARP 配置..."
    if ! command -v wgcf &>/dev/null; then
        info "未找到 'wgcf'，正在尝试从 GitHub 下载..."
        local wgcf_arch
        case "$(uname -m)" in
            x86_64) wgcf_arch="amd64" ;;
            aarch64) wgcf_arch="arm64" ;;
            *) warn "wgcf 不支持您的架构 ($(uname -m))，将使用固定配置。"; wgcf_arch="" ;;
        esac
        
        if [ -n "$wgcf_arch" ]; then
            local wgcf_url="https://github.com/ViRb3/wgcf/releases/download/v2.2.9/wgcf_2.2.9_linux_${wgcf_arch}"
            if curl -L -o /usr/local/bin/wgcf "$wgcf_url" && chmod +x /usr/local/bin/wgcf; then
                success "wgcf 安装成功。"
            else
                warn "wgcf 安装失败。"
            fi
        fi
    fi
    
    if command -v wgcf &>/dev/null; then
        # 增加 --accept-tos 避免交互，增加超时
        if timeout 60 wgcf register --accept-tos && timeout 60 wgcf generate; then
            local profile="wgcf-profile.conf"
            WARP_PRIVATE_KEY=$(grep 'PrivateKey' "$profile" | cut -d '=' -f 2 | xargs)
            WARP_PEER_PUBLIC_KEY=$(grep 'PublicKey' "$profile" | cut -d '=' -f 2 | xargs)
            WARP_ADDRESS=$(grep 'Address' "$profile" | cut -d '=' -f 2 | xargs | cut -d ',' -f 1)
            
            if [ -n "$WARP_PRIVATE_KEY" ] && [ -n "$WARP_PEER_PUBLIC_KEY" ] && [ -n "$WARP_ADDRESS" ]; then
                WARP_RESERVED="[0,0,0]"
                success "WARP 自动配置成功！"
                save_persistent_info
                # 清理wgcf生成的文件
                rm -f wgcf-account.toml wgcf-profile.conf
                return 0
            else
                warn "wgcf 成功运行，但未能提取出完整的密钥信息。"
            fi
        else
            warn "wgcf 自动注册/生成配置失败 (可能由于网络或 Cloudflare 风控)。"
        fi
        # 清理wgcf生成的文件
        rm -f wgcf-account.toml wgcf-profile.conf
    else
        warn "wgcf 工具不可用。"
    fi
    
    info "步骤 2/2: 自动配置失败，正在回退到内置的固定 WARP 配置..."
    WARP_PRIVATE_KEY="$FIXED_WARP_PRIVATE_KEY"
    WARP_PEER_PUBLIC_KEY="$FIXED_WARP_PEER_PUBLIC_KEY"
    WARP_RESERVED="$FIXED_WARP_RESERVED"
    WARP_ADDRESS="$FIXED_WARP_ADDRESS"
    success "已成功加载内置的备用 WARP 配置。"
    save_persistent_info
}

setup_firewall() {
    if ! command -v ufw &>/dev/null; then
        info "未检测到 ufw，可能不是基于 Debian 的系统，跳过防火墙自动配置。"
        return
    fi
    
    if ufw status | grep -q "Status: active"; then
        info "UFW 防火墙已处于活动状态。"
    else
        info "正在初始化 UFW 防火墙基础规则..."
        ufw default deny incoming >/dev/null
        ufw default allow outgoing >/dev/null
        ufw allow ssh >/dev/null
        ufw limit ssh >/dev/null
        if ufw --force enable; then
            success "UFW 防火墙已成功初始化并启用。"
        else
            error "UFW 启用失败。"
            return 1
        fi
    fi
}

update_firewall_rules() {
    info "正在更新防火墙规则..."
    
    local ports_to_open=(
        "${REALITY_TCP_SMART_PORT}/tcp"
        "${REALITY_HTTP_SMART_PORT}/tcp"
        "${REALITY_TCP_DIRECT_PORT}/tcp"
        "${REALITY_HTTP_DIRECT_PORT}/tcp"
        "${HY2_SMART_PORT}/udp"
        "${HY2_DIRECT_PORT}/udp"
        "${TUIC_SMART_PORT}/udp"
        "${TUIC_DIRECT_PORT}/udp"
        "${SOCKS5_PORT}/tcp"
    )
    
    for port_rule in "${ports_to_open[@]}"; do
        if ufw status | grep -q "${port_rule}"; then
            info "端口 ${port_rule} 规则已存在，跳过。"
        else
            info "正在开放端口: ${port_rule}"
            ufw allow "${port_rule}" >/dev/null
        fi
    done
    
    if ufw reload >/dev/null; then
        success "防火墙规则已成功更新并加载。"
    else
        warn "UFW 重新加载失败，新端口可能未生效。"
    fi
}


