    # bootstrap_dependencies is called at script entry
    install_singbox_core || return 1
    get_server_ip
    setup_firewall || return 1
    setup_warp || return 1
    
    info "正在批量生成 9 个节点的独立凭证..."
    HY2_SMART_PASSWORD=$(generate_random_string) && HY2_DIRECT_PASSWORD=$(generate_random_string)
    TUIC_SMART_UUID=$(generate_random_string) && TUIC_SMART_PASSWORD=$(generate_random_string)
    TUIC_DIRECT_UUID=$(generate_random_string) && TUIC_DIRECT_PASSWORD=$(generate_random_string)
    generate_single_reality_credentials REALITY_TCP_SMART_UUID REALITY_TCP_SMART_PRIVATE_KEY_FOR_CONFIG REALITY_TCP_SMART_PUBLIC_KEY REALITY_TCP_SMART_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_HTTP_SMART_UUID REALITY_HTTP_SMART_PRIVATE_KEY_FOR_CONFIG REALITY_HTTP_SMART_PUBLIC_KEY REALITY_HTTP_SMART_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_TCP_DIRECT_UUID REALITY_TCP_DIRECT_PRIVATE_KEY_FOR_CONFIG REALITY_TCP_DIRECT_PUBLIC_KEY REALITY_TCP_DIRECT_SHORT_ID || return 1
    generate_single_reality_credentials REALITY_HTTP_DIRECT_UUID REALITY_HTTP_DIRECT_PRIVATE_KEY_FOR_CONFIG REALITY_HTTP_DIRECT_PUBLIC_KEY REALITY_HTTP_DIRECT_SHORT_ID || return 1
    SOCKS5_USERNAME=$(generate_random_string) && SOCKS5_PASSWORD=$(generate_random_string)
    success "所有节点凭证生成完毕。"
    
    info "正在为 9 个节点分配端口..."
    REALITY_TCP_SMART_PORT=443
    if lsof -i:443 -sTCP:LISTEN >/dev/null ; then error "端口 443 已被占用。"; return 1; fi
    success "主 Reality 节点将使用端口: ${GREEN}443${NC}"

    local used_ports=("443")
    local high_conceal_ports_shuffled=($(shuf -e "${REALITY_HIGH_AVAILABILITY_PORTS[@]}"))
    local high_conceal_idx=0
    
    for var in REALITY_HTTP_SMART_PORT REALITY_TCP_DIRECT_PORT REALITY_HTTP_DIRECT_PORT; do
        local found=false
        for ((i=high_conceal_idx; i<${#high_conceal_ports_shuffled[@]}; i++)); do
            p=${high_conceal_ports_shuffled[i]}
            if ! lsof -i:"$p" >/dev/null && ! [[ " ${used_ports[@]} " =~ " ${p} " ]]; then
                declare "$var=$p"
                used_ports+=("$p")
                high_conceal_idx=$((i+1))
                found=true
                break
            fi
        done
        if ! $found; then error "高隐蔽性端口池已用尽或全部被占用。"; return 1; fi
    done
    success "已从高隐蔽性端口池分配 3 个 Reality 端口。"

    for var in HY2_SMART_PORT HY2_DIRECT_PORT TUIC_SMART_PORT TUIC_DIRECT_PORT SOCKS5_PORT; do
        while true; do
            local random_port
            if [[ "$var" == "SOCKS5_PORT" ]]; then
                random_port=$(shuf -i 10800-10900 -n 1)
            else
                random_port=$(shuf -i 10000-65535 -n 1)
            fi
            if ! lsof -i:"$random_port" >/dev/null && ! [[ " ${used_ports[@]} " =~ " ${random_port} " ]]; then
                declare "$var=$random_port"
                used_ports+=("$random_port")
                break
            fi
        done
    done
    success "已分配 5 个随机端口。"
    
    generate_self_signed_cert "$DEFAULT_HYSTERIA_MASQUERADE_CN" || return 1
    
    create_config_json || return 1

    update_firewall_rules
    
    create_systemd_service
    start_singbox_service || return 1

    success "8+1 终极节点矩阵部署完成！"
    display_and_store_config_info
}

# --- START: Port Rotation Functions ---
find_new_port() {
    local type=$1; shift; local used_ports_array=("$@"); local random_port
    while true; do
        if [[ "$type" == "socks5" ]]; then random_port=$(shuf -i 10800-10900 -n 1)
        else random_port=$(shuf -i 10000-65535 -n 1); fi
        if ! lsof -i:"$random_port" >/dev/null && ! [[ " ${used_ports_array[@]} " =~ " ${random_port} " ]]; then
            echo "$random_port"; return
        fi
    done
}
find_new_reality_ports() {
    local used_ports_array=("$@"); local high_conceal_ports_shuffled=($(shuf -e "${REALITY_HIGH_AVAILABILITY_PORTS[@]}")); local new_ports=()
    for p in "${high_conceal_ports_shuffled[@]}"; do
        if ! lsof -i:"$p" >/dev/null && ! [[ " ${used_ports_array[@]} " =~ " ${p} " ]]; then
            new_ports+=("$p")
            if [ ${#new_ports[@]} -eq 3 ]; then echo "${new_ports[@]}"; return; fi
        fi
    done; echo ""
}
execute_port_rotation() {
    local targets=("$@")
    if [[ " ${targets[@]} " =~ " all " ]]; then targets=("hy2" "tuic" "reality" "socks5"); fi
    info "开始执行端口更换程序..."; load_persistent_info
    info "步骤 1/5: 识别并准备关闭旧端口..."; local ports_to_close=(); local static_ports=("443")
    if ! [[ " ${targets[@]} " =~ " hy2 " ]]; then static_ports+=("$HY2_SMART_PORT" "$HY2_DIRECT_PORT"); else ports_to_close+=("${HY2_SMART_PORT}/udp" "${HY2_DIRECT_PORT}/udp"); fi
    if ! [[ " ${targets[@]} " =~ " tuic " ]]; then static_ports+=("$TUIC_SMART_PORT" "$TUIC_DIRECT_PORT"); else ports_to_close+=("${TUIC_SMART_PORT}/udp" "${TUIC_DIRECT_PORT}/udp"); fi
    if ! [[ " ${targets[@]} " =~ " reality " ]]; then static_ports+=("$REALITY_HTTP_SMART_PORT" "$REALITY_TCP_DIRECT_PORT" "$REALITY_HTTP_DIRECT_PORT"); else ports_to_close+=("${REALITY_HTTP_SMART_PORT}/tcp" "${REALITY_TCP_DIRECT_PORT}/tcp" "${REALITY_HTTP_DIRECT_PORT}/tcp"); fi
    if ! [[ " ${targets[@]} " =~ " socks5 " ]]; then static_ports+=("$SOCKS5_PORT"); else ports_to_close+=("${SOCKS5_PORT}/tcp"); fi
    for port_rule in "${ports_to_close[@]}"; do
        if [ -n "$port_rule" ] && [[ "$port_rule" != "/" ]]; then info "关闭旧端口规则: ${port_rule}"; ufw delete allow "$port_rule" >/dev/null 2>&1; fi
    done
    info "步骤 2/5: 正在生成新端口..."; local used_ports=("${static_ports[@]}")
    if [[ " ${targets[@]} " =~ " reality " ]]; then
        local new_reality_ports=$(find_new_reality_ports "${used_ports[@]}"); if [ -z "$new_reality_ports" ]; then error "高隐蔽性端口池已用尽或全部被占用。"; return 1; fi
        read -r REALITY_HTTP_SMART_PORT REALITY_TCP_DIRECT_PORT REALITY_HTTP_DIRECT_PORT <<< "$new_reality_ports"; used_ports+=("$REALITY_HTTP_SMART_PORT" "$REALITY_TCP_DIRECT_PORT" "$REALITY_HTTP_DIRECT_PORT")
        success "新的 Reality 端口: ${REALITY_HTTP_SMART_PORT}, ${REALITY_TCP_DIRECT_PORT}, ${REALITY_HTTP_DIRECT_PORT}"
    fi
    if [[ " ${targets[@]} " =~ " hy2 " ]]; then
        HY2_SMART_PORT=$(find_new_port "hy2" "${used_ports[@]}"); used_ports+=("$HY2_SMART_PORT"); HY2_DIRECT_PORT=$(find_new_port "hy2" "${used_ports[@]}"); used_ports+=("$HY2_DIRECT_PORT")
        success "新的 Hysteria2 端口: ${HY2_SMART_PORT}, ${HY2_DIRECT_PORT}"
    fi
    if [[ " ${targets[@]} " =~ " tuic " ]]; then
        TUIC_SMART_PORT=$(find_new_port "tuic" "${used_ports[@]}"); used_ports+=("$TUIC_SMART_PORT"); TUIC_DIRECT_PORT=$(find_new_port "tuic" "${used_ports[@]}"); used_ports+=("$TUIC_DIRECT_PORT")
        success "新的 TUIC 端口: ${TUIC_SMART_PORT}, ${TUIC_DIRECT_PORT}"
    fi
    if [[ " ${targets[@]} " =~ " socks5 " ]]; then
        SOCKS5_PORT=$(find_new_port "socks5" "${used_ports[@]}"); used_ports+=("$SOCKS5_PORT"); success "新的 SOCKS5 端口: ${SOCKS5_PORT}"
    fi
    info "步骤 3/5: 更新配置文件..."; create_config_json || return 1
    info "步骤 4/5: 为新端口开放防火墙规则..."; update_firewall_rules
    info "步骤 5/5: 重启服务并显示新链接..."; start_singbox_service || return 1
    save_persistent_info; success "端口更换成功！"; warn "请立即使用下方显示的新链接更新您的客户端配置！"; display_and_store_config_info
}
