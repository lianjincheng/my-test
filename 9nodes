bootstrap_dependencies() {
    info "开始检查并安装核心依赖..."
    local pkgs_to_install=()
    
    for pkg in curl tar jq openssl lsof ufw; do
        if ! command -v "$pkg" &>/dev/null; then
            pkgs_to_install+=("$pkg")
        fi
    done
    
    if [ ${#pkgs_to_install[@]} -gt 0 ]; then
        info "正在安装缺失的依赖: ${pkgs_to_install[*]}"
        if command -v apt-get &>/dev/null; then
            apt-get update -y && apt-get install -y "${pkgs_to_install[@]}"
        elif command -v yum &>/dev/null; then
            yum install -y "${pkgs_to_install[@]}"
        elif command -v dnf &>/dev/null; then
            dnf install -y "${pkgs_to_install[@]}"
        else
            error "无法自动安装依赖。请手动安装: ${pkgs_to_install[*]}"
            return 1
        fi
    fi
    
    for pkg in curl tar jq openssl lsof ufw; do
        if ! command -v "$pkg" &>/dev/null; then
            error "依赖 '$pkg' 安装失败。脚本无法继续。"
            return 1
        fi
    done
    
    success "核心依赖检查完成。"
}

