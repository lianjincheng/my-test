#!/bin/bash

# =========================================================
#  Xray Vless-xhttp-reality-enc + Argo 全能版 (完美逻辑版)
#  Target Core: yonggekkk Custom Xray (with vlessenc)
#  Update: 重置/重启/卸载均强制清理残留进程，杜绝端口占用
# =========================================================

# --- 基础配置 ---
INSTALL_DIR="/root/xray_enc_node"
CONFIG_FILE="${INSTALL_DIR}/config.json"
XRAY_BIN="${INSTALL_DIR}/xray"
XRAY_SERVICE_FILE="/etc/systemd/system/xray-enc.service"
INFO_FILE="${INSTALL_DIR}/.xray_enc_info"

# --- Argo 相关配置 ---
CLOUDFLARED_PATH="/usr/local/bin/cloudflared"
ARGO_LOG_FILE="${INSTALL_DIR}/argo.log"
ARGO_SERVICE_FILE="/etc/systemd/system/argo.service"
ARGO_PATH="/argo"

# 默认伪装域名
DEFAULT_REALITY_SNI="itunes.apple.com"

# --- 颜色定义 ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# --- 全局变量 ---
UUID=""
PORT=""
PRIVATE_KEY=""
PUBLIC_KEY=""
SHORT_ID=""
DECRYPTION_KEY=""
ENCRYPTION_KEY=""
REALITY_SNI=""
# IP 变量
IPV4_ADDR=""
IPV6_ADDR=""
# Argo 变量
ARGO_PORT=""
ARGO_DOMAIN=""

# --- 辅助函数 ---
info() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "必须使用 root 权限运行此脚本。"
        exit 1
    fi
}

# --- [核心] 进程强力猎杀函数 ---
# 无论有多少个残留进程，全部循环击杀
kill_all_processes() {
    # 1. 停止并禁用 Systemd 服务
    if systemctl list-units --full -all | grep -q "xray-enc.service"; then
        systemctl stop xray-enc >/dev/null 2>&1
        systemctl disable xray-enc >/dev/null 2>&1
    fi
    if systemctl list-units --full -all | grep -q "argo.service"; then
        systemctl stop argo >/dev/null 2>&1
        systemctl disable argo >/dev/null 2>&1
    fi

    # 2. 强杀 Xray 残留
    # 使用循环处理可能存在的多个进程实例
    local xray_pids=$(pgrep -f "^${XRAY_BIN}")
    if [ -n "$xray_pids" ]; then
        for pid in $xray_pids; do
            kill -9 "$pid" >/dev/null 2>&1
        done
        info "已清理残留 Xray 进程。"
    fi

    # 3. 强杀 Argo (Cloudflared) 残留
    local cf_pids=$(pgrep -f "^${CLOUDFLARED_PATH}")
    if [ -n "$cf_pids" ]; then
        for pid in $cf_pids; do
            kill -9 "$pid" >/dev/null 2>&1
        done
        info "已清理残留 Argo 进程。"
    fi
    
    # 4. 释放端口等待
    sleep 1
}

# --- [核心] 环境清理函数 (用于安装/重置/卸载) ---
# 调用杀进程 + 删除临时文件
force_cleanup_full() {
    info "正在执行深度环境清理 (清理进程与文件)..."
    
    # 调用杀进程逻辑
    kill_all_processes

    # 清理日志和临时文件
    rm -f "$ARGO_LOG_FILE"
    rm -f "$ARGO_SERVICE_FILE"
    # 注意：安装时会覆盖配置文件，卸载时会删除文件夹，此处只删 Argo 相关临时文件
}

check_dependencies() {
    local deps=("curl" "wget" "tar" "jq" "openssl")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            info "正在安装依赖: $dep ..."
            if command -v apt-get &>/dev/null; then
                apt-get update -y && apt-get install -y "$dep"
            elif command -v yum &>/dev/null; then
                yum install -y "$dep"
            fi
        fi
    done
}

install_cloudflared() {
    if [ -f "$CLOUDFLARED_PATH" ]; then return 0; fi
    info "安装 Cloudflared..."
    local ARCH=$(uname -m)
    case "$ARCH" in
        x86_64) ARCH="amd64" ;;
        aarch64) ARCH="arm64" ;;
        *) error "架构不支持: $ARCH"; exit 1 ;;
    esac
    
    local URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}"
    curl -L -o "$CLOUDFLARED_PATH" "$URL" || wget -O "$CLOUDFLARED_PATH" "$URL"
    chmod +x "$CLOUDFLARED_PATH"
}

create_argo_service() {
    info "配置 Argo 系统服务..."
    echo "" > "$ARGO_LOG_FILE"
    chmod 666 "$ARGO_LOG_FILE"

    cat > "$ARGO_SERVICE_FILE" <<EOF
[Unit]
Description=Cloudflared Argo Tunnel
After=network.target xray-enc.service

[Service]
Type=simple
User=root
# 支持 IPv6 (auto)
ExecStart=${CLOUDFLARED_PATH} tunnel --url http://127.0.0.1:${ARGO_PORT} --edge-ip-version auto --no-autoupdate --protocol http2 --retries 10
Restart=always
RestartSec=5s
StandardOutput=append:${ARGO_LOG_FILE}
StandardError=inherit

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable argo >/dev/null 2>&1
    systemctl restart argo
    
    sleep 2
    if ! systemctl is-active --quiet argo; then
        error "Argo 服务启动失败，请检查日志。"
        return 1
    fi
}

wait_for_argo_connection() {
    info "等待 Argo 隧道连接 (最多30秒)..."
    local timeout=30
    local elapsed=0
    while [ $elapsed -lt $timeout ]; do
        if grep -q "Registered tunnel connection" "$ARGO_LOG_FILE"; then
            success "Argo 隧道连接成功！"
            return 0
        fi
        sleep 1
        ((elapsed++))
        echo -ne "."
    done
    echo ""
    error "Argo 连接超时。请运行 'cat $ARGO_LOG_FILE' 查看详情。"
    return 1
}

save_info() {
    cat > "$INFO_FILE" <<EOF
UUID="${UUID}"
PORT="${PORT}"
PRIVATE_KEY="${PRIVATE_KEY}"
PUBLIC_KEY="${PUBLIC_KEY}"
SHORT_ID="${SHORT_ID}"
DECRYPTION_KEY="${DECRYPTION_KEY}"
ENCRYPTION_KEY="${ENCRYPTION_KEY}"
REALITY_SNI="${REALITY_SNI}"
ARGO_PORT="${ARGO_PORT}"
EOF
}

load_info() {
    if [ -f "$INFO_FILE" ]; then source "$INFO_FILE"; return 0; else return 1; fi
}

get_ip() {
    IPV4_ADDR=$(curl -s4m5 https://icanhazip.com -k || curl -s4m5 ip.sb -k)
    IPV6_ADDR=$(curl -s6m5 https://icanhazip.com -k || curl -s6m5 ip.sb -k)
    if [ -z "$IPV4_ADDR" ] && [ -z "$IPV6_ADDR" ]; then IPV4_ADDR="127.0.0.1"; fi
}

# --- 安装/重置 主逻辑 ---
install_node() {
    # Step 1: 必须先清理残留，确保重置无忧
    force_cleanup_full

    check_dependencies
    mkdir -p "$INSTALL_DIR"
    
    info "正在下载专用内核 (Xray with vlessenc)..."
    local ARCH=$(uname -m)
    local CPU=""
    case "$ARCH" in
        aarch64) CPU="arm64" ;;
        x86_64) CPU="amd64" ;;
        *) error "不支持的架构: $ARCH"; exit 1 ;;
    esac

    local DOWNLOAD_URL="https://github.com/yonggekkk/argosbx/releases/download/argosbx/xray-$CPU"
    if command -v curl &>/dev/null; then
        curl -L -o "$XRAY_BIN" "$DOWNLOAD_URL" --retry 3
    else
        wget -O "$XRAY_BIN" "$DOWNLOAD_URL" --tries=3
    fi
    chmod +x "$XRAY_BIN"

    install_cloudflared

    info "正在生成全新配置..."
    UUID=$("$XRAY_BIN" uuid)
    
    local KEY_PAIR=$("$XRAY_BIN" x25519)
    PRIVATE_KEY=$(echo "$KEY_PAIR" | grep "PrivateKey" | awk '{print $2}')
    PUBLIC_KEY=$(echo "$KEY_PAIR" | grep "Password" | awk '{print $2}')
    SHORT_ID=$(openssl rand -hex 4)

    local ENC_KEY_PAIR=$("$XRAY_BIN" vlessenc)
    DECRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"decryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')
    ENCRYPTION_KEY=$(echo "$ENC_KEY_PAIR" | grep '"encryption":' | sed -n '2p' | cut -d' ' -f2- | tr -d '"')

    PORT=$(shuf -i 10000-65535 -n 1)
    ARGO_PORT=$(shuf -i 10000-65535 -n 1)
    while [ "$PORT" == "$ARGO_PORT" ]; do ARGO_PORT=$(shuf -i 10000-65535 -n 1); done
    REALITY_SNI="$DEFAULT_REALITY_SNI"

    local LISTEN_ADDR="::"
    if sysctl net.ipv6.conf.all.disable_ipv6 2>/dev/null | grep -q "1"; then LISTEN_ADDR="0.0.0.0"; fi
    if [ ! -f /proc/net/if_inet6 ]; then LISTEN_ADDR="0.0.0.0"; fi

    info "写入配置文件..."
    cat > "$CONFIG_FILE" <<EOF
{
  "log": { "loglevel": "none" },
  "dns": { "servers": [ "1.1.1.1", "8.8.8.8" ] },
  "inbounds": [
    {
      "tag": "xhttp-reality",
      "listen": "${LISTEN_ADDR}",
      "port": ${PORT},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "${UUID}", "flow": "xtls-rprx-vision" } ],
        "decryption": "${DECRYPTION_KEY}"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "target": "${REALITY_SNI}:443",
          "serverNames": [ "${REALITY_SNI}" ],
          "privateKey": "${PRIVATE_KEY}",
          "shortIds": ["${SHORT_ID}"]
        },
        "xhttpSettings": { "path": "${UUID}-xh", "mode": "auto" }
      },
      "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] }
    },
    {
      "tag": "argo-in",
      "listen": "127.0.0.1",
      "port": ${ARGO_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [ { "id": "${UUID}" } ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "${ARGO_PATH}" }
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct", "settings": { "domainStrategy": "UseIP" } }
  ]
}
EOF

    cat > "$XRAY_SERVICE_FILE" <<EOF
[Unit]
Description=Xray Encrypted Service
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${XRAY_BIN} run -c ${CONFIG_FILE}
Restart=on-failure
RestartSec=5s
[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray-enc >/dev/null 2>&1
    systemctl restart xray-enc
    
    save_info
    
    if systemctl is-active --quiet xray-enc; then
        create_argo_service
        if wait_for_argo_connection; then
            success "安装并启动成功！"
            display_info
        fi
    else
        error "Xray 服务启动失败！"
        exit 1
    fi
}

display_info() {
    if ! load_info; then error "未找到配置信息。"; return; fi
    get_ip
    
    echo -e "${MAGENTA}====================================================${NC}"
    echo -e "${GREEN} 节点 1: Vless-xhttp-reality-enc (直连)${NC}"
    echo -e " 端口: ${PORT} | SNI: ${REALITY_SNI}"
    
    local LINK_BASE="vless://${UUID}@"
    local LINK_PARAMS=":${PORT}?encryption=${ENCRYPTION_KEY}&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=xhttp&path=${UUID}-xh&mode=auto"
    
    if [ -n "$IPV4_ADDR" ] && [ "$IPV4_ADDR" != "127.0.0.1" ]; then
        echo -e "${YELLOW} -> [IPv4]:${NC} ${LINK_BASE}${IPV4_ADDR}${LINK_PARAMS}#Xray-Enc-IPv4"
    fi
    if [ -n "$IPV6_ADDR" ]; then
        echo -e "${YELLOW} -> [IPv6]:${NC} ${LINK_BASE}[${IPV6_ADDR}]${LINK_PARAMS}#Xray-Enc-IPv6"
    fi

    echo -e "${MAGENTA}----------------------------------------------------${NC}"
    
    local ARGO_DOMAIN=""
    if [ -f "$ARGO_LOG_FILE" ]; then
        ARGO_DOMAIN=$(grep -a "trycloudflare.com" "$ARGO_LOG_FILE" | tail -n 10 | grep -o 'https://.*trycloudflare.com' | sed 's/https:\/\///' | head -n 1)
    fi

    if [ -n "$ARGO_DOMAIN" ]; then
        echo -e "${CYAN} 节点 2: Argo 临时隧道 (IPv6/IPv4兼容)${NC}"
        echo -e " 域名: ${ARGO_DOMAIN}"
        
        local base_domain="ygkkk.dpdns.org"
        local current_cf_ip="yg1.${base_domain}"
        local argo_link="vless://${UUID}@${current_cf_ip}:443?encryption=none&security=tls&type=ws&host=${ARGO_DOMAIN}&path=${ARGO_PATH//\//%2F}&sni=${ARGO_DOMAIN}#Xray-Argo-YG"
        
        echo -e "${YELLOW} -> [Argo]:${NC} ${argo_link}"
    else
        warn "Argo 域名抓取失败，请检查日志 (cat $ARGO_LOG_FILE)"
    fi

    echo -e "${MAGENTA}====================================================${NC}"
}

# --- 彻底卸载 ---
uninstall_node() {
    read -p "确定要彻底卸载吗? (y/N): " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        info "正在执行彻底卸载..."
        
        # 1. 强力清理进程和服务文件
        force_cleanup_full
        
        # 2. 清理 Systemd 服务定义
        rm -f "$XRAY_SERVICE_FILE"
        systemctl daemon-reload
        
        # 3. 清理安装目录
        rm -rf "$INSTALL_DIR"
        
        # 4. 移除 Cloudflared 二进制文件
        if [ -f "$CLOUDFLARED_PATH" ]; then
            rm -f "$CLOUDFLARED_PATH"
            info "已删除 Cloudflared 主程序。"
        fi
        
        success "卸载完成。"
    fi
}

# --- 重启服务 ---
restart_services() {
    info "正在重启 Xray 和 Argo..."
    
    # 1. 先执行进程猎杀 (仅清理进程，保留配置文件)
    kill_all_processes
    
    # 2. 清空 Argo 日志
    echo "" > "$ARGO_LOG_FILE"
    
    # 3. 启动服务
    systemctl start xray-enc
    systemctl start argo
    
    sleep 2
    if systemctl is-active --quiet xray-enc; then
        if wait_for_argo_connection; then
            success "服务重启完成"
            display_info
        fi
    else
        error "Xray 重启失败，请检查配置文件！"
    fi
}

show_menu() {
    clear
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "${CYAN}   Xray-Enc + Argo 全能版 (完美修复版)   ${NC}"
    echo -e "${MAGENTA}================================================${NC}"
    echo -e "1. 安装 / 重置 (安装前强制清理残留)"
    echo -e "2. 查看所有节点链接"
    echo -e "3. 重启服务 (先清理进程再启动)"
    echo -e "4. 彻底卸载"
    echo -e "0. 退出"
    echo -e "------------------------------------------------"
    
    read -p "请选择 [0-4]: " choice
    case "$choice" in
        1) install_node ;;
        2) display_info ;;
        3) restart_services ;;
        4) uninstall_node ;;
        0) exit 0 ;;
        *) echo "无效输入" ;;
    esac
    read -p "按回车键继续..."
}

check_root
while true; do show_menu; done
